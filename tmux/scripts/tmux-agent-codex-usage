#!/usr/bin/env python3
"""Codex の今月の使用量（クレジット）を取得して、sidebar の USAGE 欄用のキャッシュへ書く。

取得元: `codex app-server`（stdio）の JSON-RPC `account/rateLimits/read`。
ChatGPT の「使用状況 > 月間上限」（例: 2,542/20,000 クレジット使用済み）と同じ値で、モデルへの問い合わせは発生しない。
Codex 自身のログインを使うので、トークンは扱わない。
⚠️ app-server は experimental。応答の形が変わったら取得失敗として扱い、表示しない。

キャッシュ: {enabled, used, limit, percent, unit, resets_at, fetched_at}
  used / limit は individualLimit（個人の月間上限）の値で、単位は Codex クレジット（1 クレジット ≒ $0.04）。
  individualLimit が無い（上限が設定されていない）アカウントは enabled=false を書く（出さない）。
  balance / primary / secondary は Business では null のため使わない。
  取得に失敗しても前回の値と fetched_at は消さない（0 と取り違えないため）。

使い方:
  tmux-agent-codex-usage          TTL 内なら何もしない。切れていれば取得してキャッシュを更新する（sidebar が裏で呼ぶ）
  tmux-agent-codex-usage --force  TTL を無視して取得する

環境変数（主にテスト用）:
  AGENT_CODEX_USAGE_CACHE  キャッシュのパス（既定 /tmp/codex-usage.json）
  AGENT_CODEX_BIN          codex の実行ファイル（既定 PATH の codex）
  AGENT_CODEX_USAGE_TTL    再取得の間隔の秒数（既定 300）
"""
import json
import os
import shutil
import subprocess
import sys
import threading
import time

CACHE = os.environ.get("AGENT_CODEX_USAGE_CACHE", "/tmp/codex-usage.json")
CODEX_BIN = os.environ.get("AGENT_CODEX_BIN", "codex")
TTL = int(os.environ.get("AGENT_CODEX_USAGE_TTL", "300"))
FETCH_TIMEOUT_SEC = 30
# 取得が異常終了してロックが残ったときに、次の取得を止め続けないための猶予
LOCK_STALE_SEC = 120
LOCK = CACHE + ".lock"
# 失敗したときも TTL の間は再試行しない（壊れた状態で毎回 codex を起動しないため）
ATTEMPT = CACHE + ".attempt"


def mtime(path):
    try:
        return os.stat(path).st_mtime
    except OSError:
        return None


def is_fresh(path, now):
    m = mtime(path)
    return m is not None and now - m < TTL


def acquire_lock(now):
    try:
        os.mkdir(LOCK)
        return True
    except OSError:
        pass
    m = mtime(LOCK)
    if m is not None and now - m >= LOCK_STALE_SEC:
        try:
            os.rmdir(LOCK)
            os.mkdir(LOCK)
            return True
        except OSError:
            pass
    return False


def number(value):
    """文字列でも数値でも float にする。読めなければ None。"""
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def to_cache(response, now):
    """account/rateLimits/read の result をキャッシュ用の dict にする。形が想定外なら None。"""
    limits = (response or {}).get("rateLimits")
    if not isinstance(limits, dict):
        return None
    individual = limits.get("individualLimit")
    if individual is None:
        return {"enabled": False, "fetched_at": now}
    limit = number(individual.get("limit"))
    used = number(individual.get("used"))
    if limit is None or used is None:
        return None
    return {
        "enabled": True,
        "used": used,
        "limit": limit,
        "percent": used / limit * 100 if limit > 0 else None,
        "unit": "credits",
        "resets_at": individual.get("resetsAt"),
        "fetched_at": now,
    }


def fetch_rate_limits():
    """codex app-server に account/rateLimits/read を 1 回だけ問い合わせ、result を返す。失敗は None。"""
    binary = shutil.which(CODEX_BIN)
    if binary is None:
        return None
    proc = subprocess.Popen(
        [binary, "app-server"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    try:
        for message in (
            {"id": 1, "method": "initialize", "params": {"clientInfo": {"name": "tmux-agent-sidebar", "title": "tmux-agent-sidebar", "version": "0"}}},
            {"method": "initialized"},
            {"id": 2, "method": "account/rateLimits/read"},
        ):
            proc.stdin.write(json.dumps(message) + "\n")
        proc.stdin.flush()
        # readline() は応答が来ないと戻らないので、タイマーで app-server を止めて EOF にする
        timer = threading.Timer(FETCH_TIMEOUT_SEC, proc.kill)
        timer.start()
        try:
            for line in proc.stdout:
                try:
                    data = json.loads(line)
                except ValueError:
                    continue
                if data.get("id") == 2:
                    return data.get("result") if "error" not in data else None
        finally:
            timer.cancel()
    except (OSError, ValueError):
        return None
    finally:
        proc.kill()
        proc.wait()
    return None


def main():
    force = "--force" in sys.argv[1:]
    now = int(time.time())
    if not force and (is_fresh(CACHE, now) or is_fresh(ATTEMPT, now)):
        return 0
    if not acquire_lock(now):
        return 0
    try:
        try:
            open(ATTEMPT, "w").close()
        except OSError:
            pass
        cache = to_cache(fetch_rate_limits(), now)
        if cache is None:
            return 0
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cache, f)
        os.replace(tmp, CACHE)
    finally:
        try:
            os.rmdir(LOCK)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
