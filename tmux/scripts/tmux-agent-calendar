#!/usr/bin/env python3
"""Mac のカレンダー(Calendar.app)の予定を取得して、sidebar 用のキャッシュへ書く。右の枠に出す「今日の予定」の画面(--agenda)も持つ。

取得元: icalBuddy（`brew install ical-buddy`。EventKit から読むので、Calendar.app に入っている iCloud / Google / Exchange などの予定が全部取れる。約 0.05 秒）。
初回は、macOS のカレンダーの許可のダイアログが出る（許可はターミナルアプリに付く）。許可が無いと、予定が空として返る（エラーにならない）。
icalBuddy が無い Mac では、何もしないで終わる（sidebar はカードを出さない）。

キャッシュ（sidebar の collect / apply が読む）:
  F|取得した時刻(秒)
  E|開始(秒)|終了(秒)|タイトル|会議の URL(無ければ空)      ← 1 予定 1 行。開始の早い順
今日と明日の予定のうち、終日の予定と、終わった予定を除く。同じ開始・終了・タイトルの重複(複数のカレンダーに同じ予定がある)は 1 つにする。
取得に失敗したとき(icalBuddy が無い・応答しない)は、キャッシュを書き換えない(古くなれば sidebar が使わなくなる)。
会議の URL は、予定の本文・場所・URL から、Zoom / Google Meet / Teams / Webex のものを 1 つ拾う(社内ツールの URL などは拾わない)。

使い方:
  tmux-agent-calendar                  取得して、キャッシュへ書く
  tmux-agent-calendar --stdout         書かずに、標準出力へ出す(確認用)
  tmux-agent-calendar --agenda [--color always|never] [--width N] [--height N]   今日と明日の日表示(縦の時間軸に予定を置く。空いている所が空き)
  tmux-agent-calendar --agenda --list ...   同じ画面を、埋まり具合の横棒と予定の一覧にしたもの
  tmux-agent-calendar --check          icalBuddy と、カレンダーの許可の確認(カレンダーの数を出す)

環境変数（主にテスト用）:
  AGENT_CALENDAR_ICALBUDDY    icalBuddy のコマンド(既定 icalBuddy)
  AGENT_CALENDAR_CACHE        キャッシュのパス(既定 /tmp/tmux-agent-sidebar-calendar.txt)
  AGENT_CALENDAR_EXCLUDE      除くカレンダー名(カンマ区切り。icalBuddy の -ec)
  AGENT_CALENDAR_INCLUDE      対象にするカレンダー名(カンマ区切り。icalBuddy の -ic。既定は全部)
  AGENT_CALENDAR_NOW          「いま」(YYYY-MM-DD HH:MM。--agenda の表示確認用)
  AGENT_CALENDAR_DAY_FROM / _DAY_TO   勤務時間(時。既定 10 と 19。空き時間はこの中だけで数える。予定がはみ出せば表示だけ広がる)
"""
import os
import re
import shutil
import subprocess
import sys
import time
import unicodedata

ICALBUDDY = os.environ.get("AGENT_CALENDAR_ICALBUDDY", "icalBuddy")
CACHE = os.environ.get("AGENT_CALENDAR_CACHE", "/tmp/tmux-agent-sidebar-calendar.txt")
EXCLUDE = os.environ.get("AGENT_CALENDAR_EXCLUDE", "")
INCLUDE = os.environ.get("AGENT_CALENDAR_INCLUDE", "")
TIMEOUT_SEC = 10
# 勤務時間(予定表に出す時間帯の基本。予定がはみ出せば表示だけ広がる)。「空き」はこの時間帯の中だけで数える。空きとして数える最短の長さも
DAY_FROM = int(os.environ.get("AGENT_CALENDAR_DAY_FROM", "10"))
DAY_TO = int(os.environ.get("AGENT_CALENDAR_DAY_TO", "19"))
FREE_MIN_SEC = 1800
# 1 行目は「日付 at 開始 - 終了」。終了が別の日なら、終了にも日付が付く。本文などの続きの行は字下げされるので、行頭の一致だけで予定の始まりが分かる
EVENT_LINE = re.compile(r"^(\d{4})-(\d\d)-(\d\d) at (\d\d):(\d\d)(?: - (?:(\d{4})-(\d\d)-(\d\d) at )?(\d\d):(\d\d))?")
# 終日の予定の最初の行: 日付だけ(複数日は「開始日 - 終了日」。終了日を含む)。時刻つきの EVENT_LINE と区別する
ALLDAY_LINE = re.compile(r"^(\d{4})-(\d\d)-(\d\d)(?: - (\d{4})-(\d\d)-(\d\d))?(?= ¦ |$)")
URL = re.compile(r"https?://[^\s<>\")\]」』]+")
MEETING_HOSTS = ("zoom.us", "zoom.com", "meet.google.com", "teams.microsoft.com", "teams.live.com", "webex.com", "whereby.com")
PROP_SEP = " ¦ "

ESC = "\033"
DIM = f"{ESC}[38;5;245m"
ORANGE = f"{ESC}[38;5;208m"
YELLOW = f"{ESC}[38;5;226m"
GREEN = f"{ESC}[38;5;108m"
RESET = f"{ESC}[0m"


def now_epoch():
    fixed = os.environ.get("AGENT_CALENDAR_NOW")
    if fixed:
        return int(time.mktime(time.strptime(fixed, "%Y-%m-%d %H:%M")))
    return int(time.time())


def run_icalbuddy(*args):
    """icalBuddy の標準出力を返す。無い・失敗・時間切れなら None。"""
    if shutil.which(ICALBUDDY) is None and not os.path.isabs(ICALBUDDY):
        return None
    try:
        proc = subprocess.run([ICALBUDDY, *args], capture_output=True, text=True, timeout=TIMEOUT_SEC)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return proc.stdout if proc.returncode == 0 else None


def meeting_url(text):
    for url in URL.findall(text):
        if any(host in url for host in MEETING_HOSTS):
            return url.rstrip(".,;")
    return ""


def parse(output):
    """icalBuddy の出力を [{start, end, title, url, allday}] にする(開始の早い順。重複は 1 つ)。
    allday は終日の予定(日付だけの行、および 0:00 〜 翌日以降の 0:00 の予定)。start / end は 0 時の epoch(end は最終日の翌日 0 時)。"""
    blocks = []
    for line in output.splitlines():
        if EVENT_LINE.match(line) or ALLDAY_LINE.match(line):
            blocks.append([line])
        elif blocks:
            blocks[-1].append(line)
    events, seen = [], set()
    for lines in blocks:
        m = EVENT_LINE.match(lines[0])
        allday = m is None
        if allday:
            m = ALLDAY_LINE.match(lines[0])
            y, mo, d = (int(m.group(i)) for i in (1, 2, 3))
            ey, emo, ed = (int(m.group(i)) for i in (4, 5, 6)) if m.group(4) else (y, mo, d)
            start = int(time.mktime((y, mo, d, 0, 0, 0, 0, 0, -1)))
            end = int(time.mktime((ey, emo, ed + 1, 0, 0, 0, 0, 0, -1)))
        else:
            y, mo, d, h, mi = (int(m.group(i)) for i in range(1, 6))
            start = int(time.mktime((y, mo, d, h, mi, 0, 0, 0, -1)))
            end = start
            if m.group(9):
                ey, emo, ed = (int(m.group(i)) for i in (6, 7, 8)) if m.group(6) else (y, mo, d)
                end = int(time.mktime((ey, emo, ed, int(m.group(9)), int(m.group(10)), 0, 0, 0, -1)))
                if end < start:
                    end += 86400
            # 0:00 から 0:00(翌日以降)までの予定は、Google カレンダーの「終日」の予定。icalBuddy の -ea が終日と見なさず、
            # 時刻つきの予定として返ってくる(予定表で 00:00-00:00 の 1 日ぶんのブロックになってしまう)ので、終日として扱う
            allday = end - start >= 82800 and (h, mi) == (0, 0) and time.localtime(end)[3:5] == (0, 0)
        # 最初の行の、日時より後ろ: " ¦ " でプロパティが区切られる。最初がタイトル
        head = lines[0][m.end():]
        head = head[len(PROP_SEP):] if head.startswith(PROP_SEP) else head.lstrip()
        title = head.split(PROP_SEP)[0].strip()
        key = (start, end, title, allday)
        if key in seen:
            continue
        seen.add(key)
        events.append({"start": start, "end": end, "title": title, "url": meeting_url("\n".join(lines)), "allday": allday})
    events.sort(key=lambda e: (e["start"], e["end"], e["title"]))
    return drop_allday_twins(events)


TAGS = re.compile(r"^(?:\s*\[[^\]]*\])+\s*")


def bare_title(title):
    """先頭の [公開] / [非公開] などのタグを除いたタイトル(同じ予定が別のカレンダーで違うタグつきで入っていても、同じと見るため)。"""
    return TAGS.sub("", title)


def drop_allday_twins(events):
    """終日の予定と、同じ日に同じタイトル(タグを除く)の時刻つきの予定があれば、終日のほうを除く。
    共有カレンダーの終日の枠と、自分のカレンダーの時刻つきの予定が、同じ予定として 2 つ出るため。時刻つきのほうが、実際の時間が分かる。"""
    timed = [(bare_title(e["title"]), e["start"], e["end"]) for e in events if not e["allday"]]
    return [e for e in events
            if not e["allday"] or not any(t == bare_title(e["title"]) and s < e["end"] and f > e["start"] for t, s, f in timed)]


def fetch():
    """今日と明日の予定(今日の、もう終わった予定も含む。終日の予定は allday つき)。取れなければ None。"""
    # -n(いま以降だけ)は付けない。付けると、終わった予定が予定表から消える
    args = ["-nc", "-nrd", "-b", "", "-df", "%Y-%m-%d", "-tf", "%H:%M",
            "-iep", "datetime,title,location,url,notes", "-po", "datetime,title,location,url,notes", "-ps", f"|{PROP_SEP}|"]
    if EXCLUDE:
        args += ["-ec", EXCLUDE]
    if INCLUDE:
        args += ["-ic", INCLUDE]
    args.append("eventsToday+1")
    out = run_icalbuddy(*args)
    if out is None:
        return None
    return parse(out)


def clean(text):
    return text.replace("|", "｜").replace("\n", " ").replace("\t", " ").strip()


def lines_for_cache(events, now):
    out = [f"F|{now}"]
    for e in events:
        # 終日の予定はカード(次の予定)の対象外。予定表(--agenda)にだけ出す
        if e["end"] > now and not e.get("allday"):
            out.append(f"E|{e['start']}|{e['end']}|{clean(e['title'])}|{e['url']}")
    return out


def write_cache(lines):
    tmp = f"{CACHE}.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, CACHE)


# --- 画面(--agenda) ---

def width_of(text):
    return sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in text)


def clip(text, room):
    """表示幅 room に収める(収まらなければ末尾を … にする)。"""
    if width_of(text) <= room:
        return text
    out, w = "", 0
    for c in text:
        cw = width_of(c)
        if w + cw > max(room - 1, 0):
            break
        out += c
        w += cw
    return out + "…"


def hhmm(epoch):
    return time.strftime("%H:%M", time.localtime(epoch))


def day_of(epoch):
    t = time.localtime(epoch)
    return (t.tm_year, t.tm_mon, t.tm_mday)


def at(day, minutes):
    """day の 0 時から minutes 分後の epoch(24 * 60 なら翌日の 0 時)。"""
    return int(time.mktime((day[0], day[1], day[2], minutes // 60, minutes % 60, 0, 0, 0, -1)))


def busy_spans(events, day):
    """day に埋まっている時間帯を [開始, 終了] のリストにする(日をまたぐ予定は day の中に切る。重なりは 1 つにまとめる)。"""
    lo, hi = at(day, 0), at(day, 24 * 60)
    spans = sorted((max(e["start"], lo), min(e["end"], hi)) for e in events if e["end"] > e["start"])
    merged = []
    for s, e in spans:
        if e <= s:
            continue
        if merged and s <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], e)
        else:
            merged.append([s, e])
    return merged


def day_range(events, days):
    """横棒に出す時間帯(0 時からの分)。勤務時間を基本に、はみ出す予定があれば時間単位で広げる。日が変わっても棒がそろうよう、全日で共通にする。"""
    lo, hi = DAY_FROM * 60, DAY_TO * 60
    for day in days:
        base = at(day, 0)
        for s, e in busy_spans(events, day):
            lo = min(lo, (s - base) // 3600 * 60)
            hi = max(hi, -(-(e - base) // 3600) * 60)
    lo, hi = max(lo, 0), min(hi, 24 * 60)
    return (lo, hi) if hi > lo else (lo, lo + 60)


def timeline(spans, day, lo, hi, now, width, paint):
    """1 日の埋まり具合の横棒(時刻の目盛り・棒・いまの印)。空き = 緑の ░、予定あり = 橙の █、過ぎた時間は薄く。幅に収まる細かさ(15 分・30 分・1 時間)を選ぶ。"""
    hours = (hi - lo) // 60
    per = next((c for c in (4, 2, 1) if hours * c <= width - 2), 0)
    if not per:
        return []
    step = 60 // per
    base = at(day, lo)
    n = hours * per
    labels = [" "] * n
    # 目盛りの数字が隣と くっつかないよう、細かさに応じて間引く
    for h in range(0, hours, {4: 1, 2: 2, 1: 3}[per]):
        for k, ch in enumerate(str(lo // 60 + h)):
            if h * per + k < n:
                labels[h * per + k] = ch
    cells = []
    for i in range(n):
        t0, t1 = at(day, lo + i * step), at(day, lo + (i + 1) * step)
        busy = any(s < t1 and e > t0 for s, e in spans)
        cells.append(paint(DIM if t1 <= now else (ORANGE if busy else GREEN), "█" if busy else "░"))
    rows = ["  " + paint(DIM, "".join(labels)), "  " + "".join(cells)]
    if base <= now < at(day, hi):
        col = (now - base) // (step * 60)
        stamp = hhmm(now)
        if col + 2 + len(stamp) <= n:
            mark = " " * col + f"▲ {stamp}"
        elif col >= len(stamp) + 1:
            mark = " " * (col - len(stamp) - 1) + f"{stamp} ▲"
        else:
            mark = " " * col + "▲"
        rows.append("  " + paint(YELLOW, mark))
    return rows


def free_slots(spans, day, now):
    """勤務時間(DAY_FROM〜DAY_TO)の中の空き(FREE_MIN_SEC 以上の隙間)を [開始, 終了] のリストにする。いまより前は含めない。"""
    end = at(day, DAY_TO * 60)
    cur = max(at(day, DAY_FROM * 60), now)
    slots = []
    for s, e in spans:
        gap_end = min(s, end)
        if gap_end - cur >= FREE_MIN_SEC:
            slots.append((cur, gap_end))
        cur = max(cur, e)
        if cur >= end:
            break
    if end - cur >= FREE_MIN_SEC:
        slots.append((cur, end))
    return slots


def duration(sec):
    """2h30m / 2h / 45m。"""
    m = int(sec) // 60
    return f"{m // 60}h{m % 60:02d}m" if m >= 60 and m % 60 else (f"{m // 60}h" if m >= 60 else f"{m}m")


def free_summary(spans, day, now):
    """日の見出しに添える空きの合計。今日は「残り(いまから) / 全体(勤務時間の全部)」、ほかの日は全体だけ。"""
    total = sum(b - a for a, b in free_slots(spans, day, 0))
    if day != day_of(now):
        return f"空き {duration(total)}"
    left = sum(b - a for a, b in free_slots(spans, day, now))
    return f"空き 残り {duration(left)} / 全体 {duration(total)}"


def free_text(spans, day, now):
    """空き時間の 1 行の文字と色(今日は、いま以降だけ)。勤務時間がもう終わっていれば None。"""
    if now >= at(day, DAY_TO * 60):
        return None
    slots = free_slots(spans, day, now)
    if not slots:
        return "空きなし", DIM
    return "空き " + " ".join(f"{hhmm(a)}-{hhmm(b)}" for a, b in slots), GREEN


def free_line(spans, day, now, width, paint):
    free = free_text(spans, day, now)
    if free is None:
        return []
    text, code = free
    return ["  " + paint(code, clip(text, width - 2))]


def agenda_list(events, now, width, height, color):
    """(--list) 今日と明日を、日ごとに「埋まり具合の横棒 → 空き時間 → 予定の一覧」にする。終わった予定は薄く、いま進行中は黄色、これからは通常の色。"""
    def paint(code, text):
        return f"{code}{text}{RESET}" if color else text

    allday = [e for e in events if e.get("allday")]
    events = [e for e in events if not e.get("allday")]
    today = day_of(now)
    tomorrow = day_of(now + 86400)
    boundary = at(tomorrow, 0)
    lo, hi = day_range(events, (today, tomorrow))
    lines = []
    for day, label, bucket in ((today, "予定", [e for e in events if e["start"] < boundary]),
                               (tomorrow, "明日", [e for e in events if e["start"] >= boundary])):
        if lines:
            lines.append("")
        lines.append(paint(ORANGE, label) + paint(DIM, "  " + time.strftime("%m/%d", time.localtime(at(day, 0)))))
        lines += [f"  {paint(DIM, '終日')} {clip(t, max(width - 8, 4))}" for t in allday_titles(allday, day)]
        spans = busy_spans(events, day)
        lines += timeline(spans, day, lo, hi, now, width, paint)
        lines += free_line(spans, day, now, width, paint)
        lines.append("")
        for e in bucket:
            span = f"{hhmm(e['start'])}-{hhmm(e['end'])}"
            title = clip(e["title"], max(width - len(span) - 3, 4))
            if e["end"] <= now:
                lines.append(paint(DIM, f"  {span} {title}"))
            elif e["start"] <= now:
                lines.append(paint(YELLOW, f"▶ {span} {title}"))
            else:
                lines.append(f"  {paint(GREEN, span)} {title}")
            if e["url"] and e["end"] > now:
                lines.append(paint(DIM, "    " + clip(e["url"], width - 4)))
        if not bucket:
            lines.append(paint(DIM, "  予定はありません"))
    return lines[:height]


# 日表示(Google カレンダーの「日」のように、縦の時間軸に予定のブロックを置く)。予定の無い所が空き
GUTTER = 6  # 左の時刻の欄(「09:00」+ 空白)
GRID = f"{ESC}[38;5;238m"
# 予定のブロックの色(背景, 文字, 左端の縁): これから / 進行中 / 終わった
BLOCK_STYLE = {"next": (94, 255, 208), "now": (136, 16, 226), "past": (236, 245, 240)}


def layout(events, day, start_min, step, n):
    """day の予定を、表示する行の範囲(r0 以上 r1 未満)と、重なったときの横の並び(lane / lanes)にする。"""
    base, size = at(day, start_min), step * 60
    day_lo, day_hi = at(day, 0), at(day, 24 * 60)
    items = []
    for e in events:
        if e["start"] >= day_hi or max(e["end"], e["start"] + 1) <= day_lo:
            continue
        s = max(e["start"], day_lo)
        t = max(min(e["end"], day_hi), s + 1)
        r0 = (s - base) // size
        r1 = max(-(-(t - base) // size), r0 + 1)
        r0, r1 = max(r0, 0), min(r1, n)
        if r1 > r0:
            items.append({"ev": e, "r0": r0, "r1": r1})
    items.sort(key=lambda it: (it["r0"], it["r0"] - it["r1"]))
    # 重なる予定のかたまりごとに、同時に必要な列の数で横に分ける
    cluster, lanes, cluster_end = [], [], 0
    for it in items:
        if cluster and it["r0"] >= cluster_end:
            for c in cluster:
                c["lanes"] = len(lanes)
            cluster, lanes = [], []
        for k, lane_end in enumerate(lanes):
            if lane_end <= it["r0"]:
                it["lane"], lanes[k] = k, it["r1"]
                break
        else:
            it["lane"] = len(lanes)
            lanes.append(it["r1"])
        cluster.append(it)
        cluster_end = max(cluster_end, it["r1"])
    for c in cluster:
        c["lanes"] = len(lanes)
    return items


def block(ev, k, w, now, color, last):
    """予定のブロックの 1 行(幅 w)。k = 予定の何行目か(0 行目がタイトル、1 行目が時間)。last = 最後の行(黒い下線で、続く予定との境目を示す)。"""
    kind = "past" if ev["end"] <= now else ("now" if ev["start"] <= now else "next")
    bg, fg, edge = BLOCK_STYLE[kind]
    text = ev["title"] if k == 0 else (f"{hhmm(ev['start'])}-{hhmm(ev['end'])}" if k == 1 else "")
    body = " " + clip(text, w - 3) if text and w >= 4 else ""
    body += " " * max(w - 1 - width_of(body), 0)
    if not color:
        return ("▌" + body)[:w] if w > 0 else ""
    # 下線の色は黒(58)。文字色のままだと白っぽい線になって目立ちすぎる
    underline = f"{ESC}[4m{ESC}[58;5;16m" if last else ""
    return f"{ESC}[48;5;{bg};38;5;{edge}m{underline}▌{ESC}[38;5;{fg}m{body[:max(w - 1, 0)]}{RESET}"


def day_column(events, day, start_min, step, n, now, cw, paint, color):
    """1 日ぶんの列(n 行、各行は表示幅 cw)。予定の無い所は空白(1 時間ごとに薄い線。いまの行は黄色の線)。"""
    items = layout(events, day, start_min, step, n)
    by_row = [[] for _ in range(n)]
    for it in items:
        for i in range(it["r0"], it["r1"]):
            by_row[i].append((it, i - it["r0"]))
    size = step * 60
    now_row = (now - at(day, start_min)) // size if day == day_of(now) else -1
    rows = []
    for i in range(n):
        if i == now_row:
            fill = lambda k: paint(YELLOW, "─" * k)
        elif (start_min + i * step) % 60 == 0:
            fill = lambda k: paint(GRID, "─" * k)
        else:
            fill = lambda k: " " * k
        pieces, x = [], 0
        for it, k in sorted(by_row[i], key=lambda r: r[0]["lane"]):
            lw = cw // it["lanes"]
            x0 = it["lane"] * lw
            w = cw - x0 if it["lane"] == it["lanes"] - 1 else lw
            if x0 > x:
                pieces.append(fill(x0 - x))
            pieces.append(block(it["ev"], k, w, now, color, i == it["r1"] - 1))
            x = x0 + w
        if x < cw:
            pieces.append(fill(cw - x))
        rows.append("".join(pieces))
    return rows


def gutter(start_min, step, i, now_row, now, paint):
    m = start_min + i * step
    if i == now_row:
        return paint(YELLOW, hhmm(now)) + " "
    return (paint(DIM, f"{m // 60:02d}:00") if m % 60 == 0 else "     ") + " "


ALLDAY_ROWS = 3  # 予定表の上に並べる終日の予定の最大行数(超えた分は「+N」)
ALLDAY_BG = {"fg": 255, "bg": 60, "edge": 103}


def allday_titles(allday, day):
    """day にかかる終日の予定のタイトル(重複は 1 つ。複数のカレンダーに同じ予定があるため)。"""
    lo, hi = at(day, 0), at(day, 24 * 60)
    return list(dict.fromkeys(e["title"] for e in allday if e["start"] < hi and e["end"] > lo))


def allday_rows(titles, cw, color):
    """終日の予定の行(幅 cw)。ALLDAY_ROWS を超えるときは、最後の行を「+N」にする。"""
    shown = titles if len(titles) <= ALLDAY_ROWS else titles[:ALLDAY_ROWS - 1] + [f"+{len(titles) - ALLDAY_ROWS + 1}"]
    rows = []
    for t in shown:
        body = " " + clip(t, cw - 3)
        body += " " * max(cw - 1 - width_of(body), 0)
        rows.append(f"{ESC}[48;5;{ALLDAY_BG['bg']};38;5;{ALLDAY_BG['edge']}m▌{ESC}[38;5;{ALLDAY_BG['fg']}m{body}{RESET}" if color else "▌" + body)
    return rows


def agenda_grid(events, now, width, height, color):
    """今日(幅が 80 以上なら、明日も右に並べる)の日表示。上 2 行は日付と空き時間、残りが縦の時間軸。"""
    def paint(code, text):
        return f"{code}{text}{RESET}" if color else text

    allday = [e for e in events if e.get("allday")]
    events = [e for e in events if not e.get("allday")]
    today, tomorrow = day_of(now), day_of(now + 86400)
    lo, hi = day_range(events, (today, tomorrow))
    two = width >= 2 * GUTTER + 2 * 30 + 2
    shown_days = [today, tomorrow] if two else [today if now < at(today, hi) else tomorrow]
    n_allday = min(max((len(allday_titles(allday, d)) for d in shown_days), default=0), ALLDAY_ROWS)
    hours, avail = (hi - lo) // 60, max(height - 2 - n_allday, 1)
    # 行数に収まる最も細かい刻み。1 時間でも収まらなければ、いまの付近の時間帯だけを出す
    step = next((c for c in (15, 30, 60) if hours * 60 // c <= avail), 60)
    n, start_min = hours * 60 // step, lo
    if n > avail:
        n = avail
        first = min(max(lo // 60, time.localtime(now).tm_hour - 1), hi // 60 - n)
        start_min = max(first, lo // 60) * 60
    if two:
        days, cw = [(today, "予定"), (tomorrow, "明日")], (width - GUTTER - 2) // 2
    else:
        # 1 列のときは、今日の時間帯が終わっていれば明日を出す
        days, cw = [(today, "予定") if now < at(today, hi) else (tomorrow, "明日")], width - GUTTER
    heads, frees, cols, alls = [], [], [], []
    for day, label in days:
        spans = busy_spans(events, day)
        date = f"  {time.strftime('%m/%d', time.localtime(at(day, 0)))}"
        summary = clip("   " + free_summary(spans, day, now), max(cw - width_of(label + date), 0))
        plain = label + date + summary
        heads.append(paint(ORANGE, label) + paint(DIM, date) + paint(GREEN, summary))
        free = free_text(spans, day, now)
        text, code = free if free else ("", DIM)
        text = clip(text, cw)
        frees.append(paint(code, text) + " " * (cw - width_of(text)))
        heads[-1] += " " * (cw - width_of(plain))
        cols.append(day_column(events, day, start_min, step, n, now, cw, paint, color))
        alls.append(allday_rows(allday_titles(allday, day), cw, color))
    gap = "  "
    pad = " " * GUTTER
    lines = [pad + gap.join(heads), pad + gap.join(frees)]
    # 終日の予定は、Google カレンダーのように時間軸の上に置く(行の左に「終日」)
    for i in range(n_allday):
        label = paint(DIM, "終日") + "  " if i == 0 else pad
        lines.append(label + gap.join(a[i] if i < len(a) else " " * cw for a in alls))
    now_row = (now - at(today, start_min)) // (step * 60)
    for i in range(n):
        lines.append(gutter(start_min, step, i, now_row if today == day_of(now) else -1, now, paint) + gap.join(c[i] for c in cols))
    return lines[:height]


def option(args, name, default):
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else default


def main(args):
    if "--check" in args:
        out = run_icalbuddy("calendars")
        if out is None:
            print("icalBuddy を実行できません(brew install ical-buddy)")
            return 1
        names = [l for l in out.splitlines() if l.startswith("•")]
        print(f"カレンダー {len(names)} 件" + ("" if names else "(0 件なら、カレンダーの許可が要ります: システム設定 → プライバシーとセキュリティ → カレンダー)"))
        return 0
    events = fetch()
    now = now_epoch()
    if "--agenda" in args:
        width = int(option(args, "--width", "60"))
        height = int(option(args, "--height", "24"))
        color = option(args, "--color", "always") != "never"
        draw = agenda_list if "--list" in args else agenda_grid
        print("\n".join(draw(events or [], now, width, height, color)))
        return 0
    if events is None:
        return 1
    lines = lines_for_cache(events, now)
    if "--stdout" in args:
        print("\n".join(lines))
        return 0
    write_cache(lines)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
