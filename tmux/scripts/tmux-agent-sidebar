LIM_5H_PCT=""
LIM_5H_RESET=""
LIM_1W_PCT=""
LIM_1W_RESET=""
# usage credits（従量課金・席の枠を超えた分の支出）。CRED_USED が空なら出さない
CRED_USED=""
CRED_LIMIT=""
CRED_PCT=""
CRED_CUR="USD"
CRED_AGE=""
# 使った額(USD)をセントの整数にしたもの。絵文字の行を出すときだけ入る(ドル以外の通貨、1 ドル未満は空)
CRED_CENTS=""
# 今月の着地予想が上限の何 % か（整数）。予想できないとき(上限なし・古い値・月初で営業日の経過が 0)は空で、使用率の色に戻る
CRED_LAND_PCT=""
# Codex の使用量。CX_USED が空なら出さない。単位はクレジット
CX_USED=""
