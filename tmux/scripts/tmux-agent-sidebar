#!/bin/bash

# tmux-agent-sidebar: 各 window の左側に置く「普通の pane」で動かす軽量な Agent 一覧表示。
# tmux session 内で動いている Claude Code / Codex を検出して状態を表示する。
# 起動は tmux-agent-sidebar-open 経由（C-t b / C-t c）。Ctrl-C で終了すると pane ごと閉じる。
#
# 操作（sidebar にフォーカスがあるとき）:
#   j / k / ↓ / ↑ / ホイール : 選択を移動   Enter / l / h : 選択した Agent の window・pane へジャンプ
#   マウスクリック           : クリックした Agent の window・pane へジャンプ   r : 即時更新
#   cockpit window(prefix + B)の sidebar では、j/k で選択した Agent の本物の pane が右の枠に入る(tmux-agent-cockpit)。
#                              Enter = 右の枠へフォーカス、マウスクリック = その Agent を枠に入れる(移動はしない)
#   q                        : cockpit の sidebar だけ。cockpit を閉じる(Ctrl-C と同じ)
#   R                        : 選択中の Claude Code を再起動(--resume で入り直す。tmux-agent-restart)
#   n                        : 選択中のカードのリポジトリで Claude / Codex を新規起動(tmux-agent-new)
#   f                        : 選択中の Claude Code のセッションを複製して新しい pane で開く(止めない。tmux-agent-restart --fork)
#   p / Space                : 選択中の Agent の pane をポップアップでプレビュー
#                              （中で j/k 切り替え・Enter 移動。tmux-agent-sidebar-preview）
#   自動プレビュー(@agent_sidebar_auto_preview): key = j/k を押すとポップアップを開く(既定)、
#                              focus = さらに sidebar がアクティブになったときも開く、off = p のみ
#
# 検出方法:
#   Claude : `claude agents --json`（pid / status / cwd）。pid の祖先をたどって pane に紐付ける。
#            未読の完了(done)は tmux-claude-agents-status が書く状態ファイルを参照する。
#   Codex  : ps の引数（codex 本体、または node 経由の codex スクリプト）で検出し、祖先の pane に紐付ける。
#            状態・名前・モデルは Codex の常駐デーモンのスレッド(tmux-agent-codex-threads)から取り、pane とは cwd で一意に対応するときだけ使う。
#            取れないとき・対応が曖昧なときは status が unknown（推測しない）。
#   Shell  : Agent が 1 つも居ないリポジトリにある、空いているシェル(zsh 等)の pane。「+ New agent」の欄として出し、
#            n で、その pane のシェルへ Claude / Codex を入力して起動する(tmux-agent-new --here)。
#            home のシェル・コマンド実行中の pane は対象外。同じリポジトリには欄を 1 つだけ出す(prune_shells)。
#
# 種別(Claude / Codex)を画像で示す(@agent_sidebar_type_icon image): Kitty graphics protocol の Unicode placeholders を使う。
#   画像データは tmux のパススルー(allow-passthrough on)で端末へ一度送って登録し、カードには「画像の置き場所を示す
#   特殊な文字」を置く。画像が普通の文字として扱われるので、window 切り替えや再描画でも残像が出ない。
#   パススルーが無効・アイコンが無い・設定が text のときは、従来の文字表示のまま。
# 下部に Claude Code の 5h / 1w レートリミット使用率（tmux-rate-limits と同じ /tmp/claude-rate-limits.json）を出す。
# 表示する情報: リポジトリごとの見出し / 各カードに 名前(会話タイトル等。無ければ project)と種別・git ブランチ・状態と継続時間
#   リポジトリ: cwd の git から判定(worktree は本体の .git を指すので同じリポジトリにまとまる)。git 管理外はディレクトリ名
#   並び     : リポジトリ(最も若い window / pane 番号の順) → worktree のパス → window / pane 番号(cockpit での入れ替えでは動かない。
#              window の並び替えや、若い番号の window への Agent 追加ではリポジトリごと動く。詳細は reorder_agents)
#   名前     : 会話タイトル(/tmp/claude-title-<sessionId>.txt。statusline 機構が書き出す。/rename の名前もここに入る)
#              → 無ければトランスクリプトの ai-title(~/.claude/projects/*/<sessionId>.jsonl。Claude Code 自身が書く。
#                statusline が動いていないセッションでも取れる。末尾だけ読み、TITLE_CACHE_TTL 秒キャッシュ)
#              → 無ければセッション名(nameSource が derived 以外。derived は「ディレクトリ名+英数字」で情報が無い)
#              → 無ければ project(cwd 末尾)
#   継続時間 : ~/.claude/sessions/<pid>.json の statusUpdatedAt
#   ブランチ : cwd で git を呼ぶ（GIT_TTL 秒キャッシュ）
#
# 内部モデル（collect が出力する 1 行 1 Agent）:
#   R|session|window_idx|window_name|pane_idx|type|pane_id|active|project|status|detail|elapsed_sec|name|cwd
# 検出(collect)と表示(render)は、この共通レコードだけを介して分離している。
#
# macOS 標準の bash 3.2 で動く書き方にしている（連想配列・${var,,} 等は使わない）。

set -u

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
# 文字数ベースの切り詰め（${s:i:1}）を UTF-8 で正しく動かす。
# LC_COLLATE=C にしないと、case の範囲指定 [ -~] が照合順序で解釈されて ASCII 文字まで範囲外になる
unset LC_ALL
export LC_CTYPE=en_US.UTF-8 LC_COLLATE=C

INTERVAL="${AGENT_SIDEBAR_INTERVAL:-2}"
CLAUDE_BIN="${AGENT_SIDEBAR_CLAUDE_BIN:-claude}"
CLAUDE_CACHE_TTL=3
# 形式を変えたので旧版(-claude.txt)とは別名にしている（旧版の sidebar が書く古い形式と混ざらないように）
CLAUDE_CACHE_FILE="${AGENT_SIDEBAR_CLAUDE_CACHE:-/tmp/tmux-agent-sidebar-claude2.txt}"
SESSIONS_DIR="${AGENT_SIDEBAR_SESSIONS_DIR:-$HOME/.claude/sessions}"
# statusline.sh が書き出す 5h/1w の使用率とリセット時刻（tmux-rate-limits も同じファイルを読む）
RATE_LIMIT_FILE="${AGENT_SIDEBAR_RATE_LIMITS:-/tmp/claude-rate-limits.json}"
# fetch-usage-credits.sh が書く usage credits（今月の支出 / 上限）。取得は statusline.sh が TTL 切れのときに裏で起動する
CREDITS_FILE="${AGENT_SIDEBAR_CREDITS:-/tmp/claude-credits.json}"
# 取得が止まったとき、この秒数を超えた値には経過時間を添える
CREDITS_STALE_SEC=900
# 使った額を「身近なもの」の絵文字に置き換えて並べる、ドル換算のはしご（大きい単位から。"最小単位(セント)|絵文字"）。
# 大きい単位から順に使い、端数(最小単位に満たない分)は捨てる。為替の設定を持たないよう、円ではなくドルで定義している。
# 値段は 1 ドル = 約 150 円で、実在する値段をおおよそ丸めたもの(隣り合う単位の比は 3〜5 倍が目安):
#   📱 iPhone 17 ≒ ¥150,000 / 🎮 Switch 2 ≒ ¥60,000 / 🚄 新幹線 東京〜新大阪 ≒ ¥15,000
#   🍻 飲み会 1 回 ≒ ¥5,000 / 🍜 ラーメン ≒ ¥1,000 / 🧃 ジュース ≒ ¥150
CREDITS_LADDER=("100000|📱" "40000|🎮" "10000|🚄" "3300|🍻" "700|🍜" "100|🧃")
# 絵文字を並べる最大個数(幅に収まる個数とのうち小さい方)。超える分は小さい単位から切り捨てる
CREDITS_ICON_MAX=13
# 今月の着地予想(営業日ベース)が上限の何 % かで 💳 の色を変える境目。上限 = 月の予算として扱う。
#   WARN 以下=緑(余裕) / WARN 超〜ALERT 以下=黄(注意) / ALERT 超=赤(上限を超えそう)
CREDITS_LAND_WARN_PCT=70
CREDITS_LAND_ALERT_PCT=100
# Codex の今月の使用量(クレジット)。tmux-agent-codex-usage が書くファイルを読む。Business の個人の月間上限(individualLimit)
CODEX_FILE="${AGENT_SIDEBAR_CODEX_USAGE:-/tmp/codex-usage.json}"
CODEX_USAGE_BIN="${AGENT_SIDEBAR_CODEX_USAGE_BIN:-$(cd "$(dirname "$0")" && pwd)/tmux-agent-codex-usage}"
# 取得の起動の間隔(秒)。取得スクリプト側にも TTL(既定 300 秒)があるので、ほとんどは起動しただけで終わる
CODEX_REFRESH_SEC=60
CODEX_FETCHED_AT=-999
# Codex のスレッド(状態・名前・モデル)。tmux-agent-codex-threads が Codex の常駐デーモンから集めて書く。
# 取得は sidebar が CODEX_THREADS_TTL 秒ごとに裏で起動する(複数の sidebar で共有)。CODEX_THREADS_MAX_AGE 秒より古い内容は読まない
CODEX_THREADS_CACHE="${AGENT_SIDEBAR_CODEX_THREADS_CACHE:-/tmp/tmux-agent-sidebar-codex.txt}"
CODEX_THREADS_BIN="${AGENT_SIDEBAR_CODEX_THREADS_BIN:-$(cd "$(dirname "$0")" && pwd)/tmux-agent-codex-threads}"
CODEX_THREADS_TTL=3
CODEX_THREADS_MAX_AGE=30
GIT_TTL=10
# トランスクリプトから拾った ai-title のキャッシュ("sessionId|title" の行)。形式は refresh_title_cache を参照
TITLE_CACHE_FILE="${AGENT_SIDEBAR_TITLE_CACHE:-/tmp/tmux-agent-sidebar-titles.txt}"
TITLE_CACHE_TTL=30
PROJECTS_DIR="${AGENT_SIDEBAR_PROJECTS_DIR:-$HOME/.claude/projects}"
# トランスクリプトは大きい(数 MB)ので、末尾のこのバイト数だけ読む。ai-title は何度も書き直されるので末尾に必ずある
TRANSCRIPT_TAIL_BYTES=300000
# tmux-claude-agents-status が書く "ppid:status:alerting" の状態ファイル（未読の完了判定に使う）
ALERT_STATE_FILE="${AGENT_SIDEBAR_ALERT_STATE:-/tmp/tmux-claude-agents-state}"

ESC=$'\033'
C_RESET="${ESC}[0m"
C_BOLD="${ESC}[1m"
C_TITLE="${ESC}[1;38;5;208m"
C_DIM="${ESC}[38;5;245m"
C_WORKING="${ESC}[38;5;226m"
C_WAITING="${ESC}[38;5;196m"
C_DONE="${ESC}[38;5;46m"
# IDLE(入力待ち)は DONE(完了・未読)と同じ緑系だが、くすんだ灰緑にして存在感を抑える。
# DONE だけ鮮やかな緑 + カードの背景の色味にして、「新しい結果がある」を IDLE と区別する
# (IDLE は左端のバーと状態ピルだけが緑。カードの背景には色味を付けない)
C_IDLE="${ESC}[38;5;65m"
C_UNKNOWN="${ESC}[38;5;245m"
C_ACTIVE="${ESC}[38;5;208m"
C_TITLE_ROW="${ESC}[38;5;252m"
# 2 行目に回った project(ディレクトリ名)の色。ブランチ(C_DIM)より少し明るくして、識別名として読めるようにする
C_PROJ="${ESC}[38;5;250m"
C_GROUP="${ESC}[38;5;173m"
FG_DEFAULT="${ESC}[39m"
BOLD_ON="${ESC}[1m"
BOLD_OFF="${ESC}[22m"
# Agent を「カード」に見せるための背景色（通常 / 選択中）。window-style の bg=colour233 より一段明るくする
CARD_BG="${ESC}[48;5;236m"
# 注意が必要な状態(WAITING / DONE)のカードは背景に色味を付けて、一覧の中で目に入るようにする。
# 選択中(角丸の罫線で囲む)はそれぞれ一段明るい色にする
CARD_BG_WAITING="${ESC}[48;5;52m"
# DONE(完了・未読)は強い緑の色味。IDLE(入力待ち)は背景に色味を付けず通常のカードと同じにして、
# 「新しい結果がある」を IDLE と区別する(以前は IDLE も暗い緑で、選択中の IDLE が DONE と同じ色になって紛らわしかった)
CARD_BG_IDLE="${ESC}[48;5;236m"
CARD_BG_DONE="${ESC}[48;5;28m"
CARD_BG_SELECTED="${ESC}[48;5;238m"
CARD_BG_WAITING_SELECTED="${ESC}[48;5;88m"
CARD_BG_IDLE_SELECTED="${ESC}[48;5;238m"
CARD_BG_DONE_SELECTED="${ESC}[48;5;34m"
# 選択中のカードを囲む罫線の色(テーマのオレンジ)
C_SELECT="${ESC}[1;38;5;208m"
# 「いま見ている pane」の Agent は、左端の ▶ と project 名をシアンの太字にする(選択のオレンジとは別の色にして混同を避ける)
C_HERE="${ESC}[1;38;5;51m"
C_RULE="${ESC}[38;5;239m"

# 状態ピルの配色（背景色 / 文字色）。status ごとに case で選ぶ
SPINNER=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)

# アイコン。Nerd Font 前提の既定(nerd)と、フォントを選ばない plain を @agent_sidebar_icons で切り替える。
# ICON_W は「アイコン + 空白」の表示幅
ICON_STYLE=nerd
ICON_BRANCH=""
ICON_DIR=""
ICON_W=0
TAB_ARROW="▶"
apply_icon_style() {
  if [ "$ICON_STYLE" = plain ]; then
    ICON_BRANCH=""
    ICON_DIR=""
    ICON_W=0
    TAB_ARROW="▶"
  else
    TAB_ARROW=$'\xee\x82\xb0'     # U+E0B0 (Powerline の右向き矢印)
    ICON_BRANCH=$'\xee\x82\xa0 '  # U+E0A0 (git branch)
    ICON_DIR=$'\xef\x81\xbb '     # U+F07B (folder)
    ICON_W=2
  fi
}
apply_icon_style

# 種別アイコン(画像)。ファイルは tmux/assets/agent-icons/{claude,codex}.png。symlink 経由で呼ばれても実体側の assets を探す
script_real=$(readlink "$0" 2>/dev/null || echo "$0")
TYPE_ICON_DIR="${AGENT_SIDEBAR_ICON_DIR:-$(cd "$(dirname "$script_real")/../assets/agent-icons" 2>/dev/null && pwd)}"
# 端末側の画像 ID(placeholder の前景色 = 256 色の番号で ID を表すので 1〜255)。他アプリと衝突しにくい大きめの値にする
KITTY_ID_CLAUDE=250
KITTY_ID_CODEX=251
KITTY_B64_CLAUDE=""
KITTY_B64_CODEX=""
TYPE_ICON_MODE=text      # text | image(画像で表示できる条件が揃っているときだけ image)
KITTY_SENT_AT=-999
KITTY_RESEND_SEC=10      # 端末の再接続などで登録が消えても戻るよう、定期的に送り直す
# Unicode placeholder: U+10EEEE + 行の結合文字 + 列の結合文字(U+0305=0, U+030D=1)。2 桁 × 1 行の画像
KITTY_PH=$'\xf4\x8e\xbb\xae'
KITTY_D0=$'\xcc\x85'
KITTY_D1=$'\xcc\x8d'

HEADER_ROWS=3
# 親ディレクトリ表示の最大文字数（これを超えると先頭を "…" で省く）
PARENT_DIR_MAX=14

if [ -z "${TMUX_PANE:-}" ]; then
  echo "tmux-agent-sidebar: tmux の pane 内で実行してください" >&2
  exit 1
fi

TIMEOUT_CMD=""
command -v gtimeout >/dev/null 2>&1 && TIMEOUT_CMD="gtimeout 5"

# 生死の記録。stderr を捨てているので、sidebar が放置中に消えても理由が残らなかった。
# 起動時に START、終了時に EXIT(どの経路か + 終了ステータス)を 1 行ずつ追記する。
# EXIT の行が無いまま止まっていたら、SIGKILL など trap できない終了(外から強制終了された)ということ
LIFE_LOG="${AGENT_SIDEBAR_LIFE_LOG:-/tmp/tmux-agent-sidebar-life.log}"
EXIT_REASON=""
life_log() {
  local size
  size=$(wc -c < "$LIFE_LOG" 2>/dev/null) || size=0
  # 大きくなりすぎないよう、200KB を超えたら末尾だけ残す
  if [ "${size:-0}" -gt 200000 ]; then
    tail -n 300 "$LIFE_LOG" > "$LIFE_LOG.tmp" 2>/dev/null && mv "$LIFE_LOG.tmp" "$LIFE_LOG" 2>/dev/null
  fi
  printf '%s pid=%s pane=%s cockpit=%s %s\n' "$(date '+%F %T')" "$$" "${TMUX_PANE:-}" "${COCKPIT:-0}" "$*" >> "$LIFE_LOG" 2>/dev/null
  return 0
}

cleanup() {
  local status=$?
  life_log "EXIT reason=${EXIT_REASON:-unknown} status=$status"
  # cockpit の sidebar が終了するとき、枠に入っている Agent を元の位置へ戻し(戻さないと、cockpit を閉じたときに
  # Agent も終了する)、不要になった交換用の枠も消す(cockpit window ごと閉じる)
  [ "${COCKPIT:-0}" = 1 ] && "$COCKPIT_BIN" teardown >/dev/null 2>&1
  # ポップアップ中に終了した場合に備えて、プレビュー用の一時ファイルを消す
  rm -f "/tmp/tmux-agent-sidebar-preview-$$".*
  printf '%s' "${ESC}[?1004l${ESC}[?1006l${ESC}[?1000l${ESC}[?25h${ESC}[?1049l"
  stty echo 2>/dev/null
}

# --- 検出 ---------------------------------------------------------------

# `claude agents --json` は約 0.2 秒かかるため、複数 window の sidebar で共有するキャッシュを使う。
# 失敗（空応答）時は直前のキャッシュを残す。
refresh_claude_cache() {
  local now mtime json lines updates tmp
  now=$(date +%s)
  mtime=$(stat -f %m "$CLAUDE_CACHE_FILE" 2>/dev/null || echo 0)
  [ $((now - mtime)) -lt "$CLAUDE_CACHE_TTL" ] && return 0

  json=$($TIMEOUT_CMD "$CLAUDE_BIN" agents --json 2>/dev/null) || json=""
  if [ -z "$json" ]; then
    touch "$CLAUDE_CACHE_FILE" 2>/dev/null
    return 0
  fi
  # C|pid|status|waitingFor|cwd|name|sessionId
  lines=$(printf '%s' "$json" | jq -r '
    .[] | ["C", .pid, .status, (.waitingFor // ""), (.cwd // ""), (.name // ""), (.sessionId // "")]
        | map(tostring | gsub("[|\\n\\t]"; " ")) | join("|")' 2>/dev/null) || return 0
  # U|pid|statusUpdatedAt(ms)|nameSource : 全セッションぶんを jq 1 回で読む
  updates=$(jq -r 'select(.statusUpdatedAt != null) | "U|\(.pid)|\(.statusUpdatedAt)|\(.nameSource // "")"' "$SESSIONS_DIR"/*.json 2>/dev/null)
  tmp="${CLAUDE_CACHE_FILE}.$$"
  printf '%s\n%s\n' "$lines" "$updates" > "$tmp" && mv "$tmp" "$CLAUDE_CACHE_FILE"
}

# Codex のスレッドのキャッシュを、CODEX_THREADS_TTL 秒ごとに裏で更新する(待たない)。
# 起動の記録(.attempt)は、キャッシュ本体の更新時刻とは別に持つ(取得が失敗し続けても、古い内容を新しく見せないため)
refresh_codex_threads() {
  local now mtime
  now=$(date +%s)
  mtime=$(stat -f %m "$CODEX_THREADS_CACHE.attempt" 2>/dev/null || echo 0)
  [ $((now - mtime)) -lt "$CODEX_THREADS_TTL" ] && return 0
  touch "$CODEX_THREADS_CACHE.attempt" 2>/dev/null
  "$CODEX_THREADS_BIN" >/dev/null 2>&1 &
  disown 2>/dev/null
}

# Codex のスレッドのキャッシュを、awk の入力(X| の行)として出す。古い(取得が止まった)内容は出さない
codex_threads_lines() {
  local now mtime
  now=$(date +%s)
  mtime=$(stat -f %m "$CODEX_THREADS_CACHE" 2>/dev/null) || return 0
  [ $((now - mtime)) -lt "$CODEX_THREADS_MAX_AGE" ] && cat "$CODEX_THREADS_CACHE" 2>/dev/null
}

# 稼働中の各セッションのトランスクリプトから最新の ai-title を拾い、TITLE_CACHE_FILE に "sessionId|title" で書く。
# TITLE_CACHE_TTL 秒に一度だけ実行する(複数の sidebar が同時に走らないよう、先に更新時刻を進める)
refresh_title_cache() {
  local now mtime tag pid st wf cwd name sid f f_ line title out="" tmp
  now=$(date +%s)
  mtime=$(stat -f %m "$TITLE_CACHE_FILE" 2>/dev/null || echo 0)
  [ $((now - mtime)) -lt "$TITLE_CACHE_TTL" ] && return 0
  touch "$TITLE_CACHE_FILE" 2>/dev/null

  while IFS='|' read -r tag pid st wf cwd name sid; do
    [ "$tag" = C ] && [ -n "$sid" ] || continue
    f=""
    # プロジェクトディレクトリ名は cwd の符号化なので、規則に頼らず sessionId で探す
    for f_ in "$PROJECTS_DIR"/*/"$sid".jsonl; do
      [ -r "$f_" ] && { f=$f_; break; }
    done
    [ -z "$f" ] && continue
    line=$(tail -c "$TRANSCRIPT_TAIL_BYTES" "$f" 2>/dev/null | grep -a '"type":"ai-title"' | tail -n 1)
    [ -z "$line" ] && continue
    title=$(printf '%s' "$line" | jq -r '(.aiTitle // "") | gsub("[|\\n\\t]"; " ")' 2>/dev/null)
    [ -n "$title" ] && out+="${sid}|${title}"$'\n'
  done < "$CLAUDE_CACHE_FILE"

  tmp="${TITLE_CACHE_FILE}.$$"
  printf '%s' "$out" > "$tmp" && mv "$tmp" "$TITLE_CACHE_FILE"
}

read -r -d '' AWK_COLLECT <<'EOF' || true
function base(p,   n, a) { n = split(p, a, "/"); return a[n] }

# 末尾の / を除く(cwd の突き合わせ用。ルートは / のまま)
function trim_slash(p) { if (length(p) > 1) sub(/\/+$/, "", p); return p }

# 会話タイトル。statusline 機構が書くキャッシュを優先し(/rename の名前も入る)、無ければトランスクリプトの ai-title。
# 未設定の既定タイトルは出さない
function title_of(sid,   f, t) {
  if (sid == "") return ""
  f = "/tmp/claude-title-" sid ".txt"
  t = ""
  if ((getline t < f) <= 0) t = ""
  close(f)
  gsub(/[|	]/, " ", t)
  if (t == "" || t == "新しい会話") t = (sid in ai_title) ? ai_title[sid] : ""
  return (t == "新しい会話") ? "" : t
}

# pid から祖先をたどり、最初に見つかった pane_pid の pane 番号を返す
function pane_of(pid,   i) {
  for (i = 0; i < 64 && pid != "" && pid != 0 && pid != 1; i++) {
    if (pid in pane_by_pid) return pane_by_pid[pid]
    pid = ppid[pid]
  }
  return ""
}

function add(pi, type, project, status, detail, elapsed, title, cwd,   active) {
  if (type != "Shell") has_agent[pi] = 1
  active = (p_win_active[pi] == 1 && p_active[pi] == 1 && p_sess[pi] == cur_sess) ? 1 : 0
  n++
  rec[n] = "R|" p_sess[pi] "|" p_win[pi] "|" p_wname[pi] "|" p_pane[pi] "|" type "|" p_id[pi] "|" active "|" project "|" status "|" detail "|" elapsed "|" title "|" cwd
  skey[n] = p_sess[pi]
  nkey[n] = p_win[pi] * 100000 + p_pane[pi]
}

{
  tag = substr($0, 1, 1)
  rest = substr($0, 3)
}

# P|session|window_id|window_idx|pane_idx|pane_id|pane_pid|sidebar|win_active|pane_active|window_name|origin_widx|origin_wname|origin_pidx|slot|command|path
# origin_* は、cockpit に入れられている Agent の「元の window 番号・名前・pane 番号」。あれば見出しの window と並び順をそちらにする
tag == "P" {
  split(rest, f, "|")
  np++
  p_sess[np] = f[1]; p_wid[np] = f[2]; p_win[np] = f[3]; p_pane[np] = f[4]
  p_id[np] = f[5]; p_sidebar[np] = f[7]; p_win_active[np] = f[8]; p_active[np] = f[9]; p_wname[np] = f[10]
  if (f[11] != "") { p_win[np] = f[11]; p_wname[np] = f[12]; p_pane[np] = f[13] }
  p_slot[np] = f[14]; p_cmd[np] = f[15]
  p_path[np] = rest
  sub(/^([^|]*\|){15}/, "", p_path[np])
  if (f[5] == self) { cur_sess = f[1]; self_wid = f[2]; self_focus = (f[8] == 1 && f[9] == 1) ? 1 : 0 }
  # sidebar pane 自身（と他の sidebar）は Agent 検出の対象から外す
  if (f[7] != 1) pane_by_pid[f[6]] = np
}

# S|pid ppid args...
tag == "S" {
  split(rest, g, " ")
  ppid[g[1]] = g[2]
  arg1[g[1]] = g[3]
  arg2[g[1]] = g[4]
}

# C|pid|status|waitingFor|cwd|name|sessionId  （claude agents --json のキャッシュ）
tag == "C" {
  nc++
  split(rest, f, "|")
  c_pid[nc] = f[1]; c_status[nc] = f[2]; c_wait[nc] = f[3]; c_cwd[nc] = f[4]; c_name[nc] = f[5]; c_sid[nc] = f[6]
}

# X|threadId|cwd|status|flags|name|model|effort|since|updatedAt  （Codex のロード中のスレッド。tmux-agent-codex-threads が作る）
tag == "X" {
  nx++
  split(rest, f, "|")
  x_cwd[nx] = trim_slash(f[2]); x_status[nx] = f[3]; x_flags[nx] = f[4]; x_name[nx] = f[5]
  x_model[nx] = f[6]; x_effort[nx] = f[7]; x_since[nx] = f[8]
}

# T|sessionId|title  （トランスクリプトの ai-title。refresh_title_cache が作る）
tag == "T" {
  k = index(rest, "|")
  if (k > 1) ai_title[substr(rest, 1, k - 1)] = substr(rest, k + 1)
}

# U|pid|statusUpdatedAt(ms)|nameSource
tag == "U" {
  split(rest, f, "|")
  updated_ms[f[1]] = f[2]
  name_src[f[1]] = f[3]
}

# A|ppid:status:alerting
tag == "A" {
  split(rest, f, ":")
  alerting[f[1]] = f[3]
}

END {
  split("zsh bash sh dash ksh fish", sh_list, " ")
  for (i in sh_list) shells[sh_list[i]] = 1

  # sidebar と同じ window に、sidebar 以外の pane が残っているか（0 なら呼び出し側が終了する）
  main_panes = -1
  if (self_wid != "") {
    main_panes = 0
    for (i = 1; i <= np; i++) if (p_wid[i] == self_wid && p_sidebar[i] != 1) main_panes++
  }
  # sidebar 自身が操作対象（active な window の active な pane）かどうかも渡す
  print "M|" main_panes "|" self_focus

  # --- Claude ---
  for (i = 1; i <= nc; i++) {
    pi = pane_of(c_pid[i])
    if (pi == "") continue
    st = c_status[i]
    if (st == "busy") status = "working"
    else if (st == "waiting") status = "waiting"
    else if (st == "idle") status = (alerting[ppid[c_pid[i]]] == 1) ? "done" : "idle"
    else status = "unknown"
    cwd = c_cwd[i]; if (cwd == "") cwd = p_path[pi]
    project = base(cwd)
    # 経過秒だけ渡し、表示用の整形は bash 側で行う
    elapsed = (c_pid[i] in updated_ms) ? now - int(updated_ms[c_pid[i]] / 1000) : ""
    if (elapsed != "" && elapsed < 0) elapsed = 0
    # 表示名: 会話タイトル → セッション名(derived 以外。nameSource が不明なら使わない) → 空(= project を使う)
    display = title_of(c_sid[i])
    if (display == "" && name_src[c_pid[i]] != "" && name_src[c_pid[i]] != "derived") display = c_name[i]
    add(pi, "Claude", project, status, c_wait[i], elapsed, display, cwd)
  }

  # --- Codex ---
  # 状態・名前・モデルは、Codex の常駐デーモンのスレッド(X)から取る。スレッドと pane は cwd で対応付ける。
  # 対応が一意なとき(その cwd の Codex の pane もスレッドも 1 つだけ)に限る。同じ cwd に複数あると、どのスレッドか確かめる手段が無いので
  # 推測せず、従来どおり unknown にする。デーモンに届かないとき(スレッドが無い)も unknown
  nk = 0
  for (pid in ppid) {
    a1 = base(arg1[pid]); a2 = base(arg2[pid])
    if (!(a1 == "codex" || (a1 ~ /^node/ && a2 == "codex"))) continue
    pi = pane_of(pid)
    if (pi == "" || codex_seen[pi]) continue
    codex_seen[pi] = 1
    codex_pane[++nk] = pi
    codex_panes_in[trim_slash(p_path[pi])]++
  }
  for (j = 1; j <= nx; j++) threads_in[x_cwd[j]]++
  for (k = 1; k <= nk; k++) {
    pi = codex_pane[k]
    cwd = p_path[pi]
    project = base(cwd)
    xj = 0
    key = trim_slash(cwd)
    if (codex_panes_in[key] == 1 && threads_in[key] == 1) {
      for (j = 1; j <= nx; j++) if (x_cwd[j] == key) xj = j
    }
    status = "unknown"; detail = ""; elapsed = ""; display = ""
    if (xj > 0) {
      display = x_name[xj]
      model = x_model[xj]; if (x_effort[xj] != "") model = model " " x_effort[xj]
      if (x_status[xj] == "idle") { status = "idle"; detail = model }
      else if (x_status[xj] == "active") {
        if (x_flags[xj] ~ /waitingOnApproval/) { status = "waiting"; detail = "approval" }
        else if (x_flags[xj] ~ /waitingOnUserInput/) { status = "waiting"; detail = "input" }
        else { status = "working"; detail = model }
      }
      if (status != "unknown" && x_since[xj] != "") { elapsed = now - x_since[xj]; if (elapsed < 0) elapsed = 0 }
    }
    add(pi, "Codex", project, status, detail, elapsed, display, cwd)
  }

  # --- Shell（Agent の居ない、空いているシェルの pane） ---
  # 「このディレクトリで Agent を新規起動できる」候補。Agent が居るリポジトリとの重複は bash 側(prune_shells)で落とす。
  # home のシェルは対象外(C-t c が新しい window を home で開くため、候補だらけになる)
  for (pi = 1; pi <= np; pi++) {
    if (has_agent[pi] || p_sidebar[pi] == 1 || p_slot[pi] != "") continue
    if (!(p_cmd[pi] in shells)) continue
    if (p_path[pi] == "" || p_path[pi] == home) continue
    add(pi, "Shell", base(p_path[pi]), "shell", "", "", "", p_path[pi])
  }

  # session → window → pane の順に並べる（件数が少ないので単純な挿入ソート）
  for (i = 2; i <= n; i++) {
    r = rec[i]; s = skey[i]; k = nkey[i]
    for (j = i - 1; j >= 1 && (skey[j] > s || (skey[j] == s && nkey[j] > k)); j--) {
      rec[j + 1] = rec[j]; skey[j + 1] = skey[j]; nkey[j + 1] = nkey[j]
    }
    rec[j + 1] = r; skey[j + 1] = s; nkey[j + 1] = k
  }
  for (i = 1; i <= n; i++) print rec[i]
}
EOF

# 現在の session（または全 session）の Agent 一覧を共通レコードで標準出力へ出す
collect() {
  local list_args
  if [ "$SCOPE_ALL" = 1 ]; then
    list_args=(-a)
  else
    list_args=(-s -t "$SESSION_ID")
  fi

  refresh_claude_cache
  refresh_title_cache
  refresh_codex_threads
  {
    tmux list-panes "${list_args[@]}" -F \
      '#{session_name}|#{window_id}|#{window_index}|#{pane_index}|#{pane_id}|#{pane_pid}|#{@agent_sidebar}|#{window_active}|#{pane_active}|#{window_name}|#{@agent_origin_widx}|#{@agent_origin_wname}|#{@agent_origin_pidx}|#{@agent_cockpit_slot_pane}|#{pane_current_command}|#{pane_current_path}' 2>/dev/null |
      awk '{ print "P|" $0 }'
    ps -axo pid=,ppid=,args= | awk '{ print "S|" $0 }'
    cat "$CLAUDE_CACHE_FILE" 2>/dev/null
    codex_threads_lines
    awk '{ print "T|" $0 }' "$TITLE_CACHE_FILE" 2>/dev/null
    awk '{ print "A|" $0 }' "$ALERT_STATE_FILE" 2>/dev/null
  } | awk -v self="$TMUX_PANE" -v now="$(date +%s)" -v home="$HOME" "$AWK_COLLECT"
}

# --- 表示 ---------------------------------------------------------------

# PNG を base64 にして KITTY_B64_* に読み込む(起動時に 1 回)。無ければ空のまま
load_type_icons() {
  KITTY_B64_CLAUDE=""
  KITTY_B64_CODEX=""
  [ -r "$TYPE_ICON_DIR/claude.png" ] && KITTY_B64_CLAUDE=$(base64 < "$TYPE_ICON_DIR/claude.png" | tr -d '\n')
  [ -r "$TYPE_ICON_DIR/codex.png" ] && KITTY_B64_CODEX=$(base64 < "$TYPE_ICON_DIR/codex.png" | tr -d '\n')
}

# 画像を端末へ登録する。$1=画像 ID $2=base64。4096 バイトずつのチャンクに分け、tmux のパススルー
# (ESC P tmux ; … ESC \ で包み、中の ESC は二重にする)で送る。a=T,U=1 は「送信 + 仮想配置(placeholder 用)」、
# q=2 は端末からの応答を抑える(応答が pane の入力に混ざらないように)
kitty_send_image() {
  local id=$1 data=$2 pos=0 len=${#2} chunk more ctl out=""
  while ((pos < len)); do
    chunk=${data:pos:4096}
    pos=$((pos + 4096))
    ((pos < len)) && more=1 || more=0
    if ((pos <= 4096)); then
      ctl="a=T,f=100,i=${id},U=1,c=2,r=1,q=2,m=${more}"
    else
      ctl="m=${more}"
    fi
    out+="${ESC}Ptmux;${ESC}${ESC}_G${ctl};${chunk}${ESC}${ESC}\\${ESC}\\"
  done
  printf '%s' "$out"
}

# 種別 $1 の placeholder 文字列(2 桁)を REPLY に入れる。画像で示せない種別なら空
type_icon_cells() {
  local id
  REPLY=""
  [ "$TYPE_ICON_MODE" = image ] || return 0
  case $1 in
    Claude) [ -n "$KITTY_B64_CLAUDE" ] && id=$KITTY_ID_CLAUDE ;;
    Codex) [ -n "$KITTY_B64_CODEX" ] && id=$KITTY_ID_CODEX ;;
  esac
  [ -z "${id:-}" ] && return 0
  # 前景色(256 色の番号)が画像 ID。背景のカード色はそのまま残る
  REPLY="${ESC}[38;5;${id}m${KITTY_PH}${KITTY_D0}${KITTY_D0}${KITTY_PH}${KITTY_D0}${KITTY_D1}${FG_DEFAULT}"
}

# USAGE 欄の行頭のラベル(2 桁)を REPLY に入れる。種別 $1(Claude / Codex)を画像で示せるときはその画像、
# 示せないとき(text モード・画像が読めない)は絵文字 $2。Agent 一覧のカードと同じアイコンにそろえる
usage_label() {
  type_icon_cells "$1"
  [ -n "$REPLY" ] || REPLY=$2
}

# 1 文字の端末上の表示幅(0 / 1 / 2)を REPLY に入れる。ASCII 以外は UTF-8 のバイトからコードポイントを
# 復元して判定する。East Asian Ambiguous(’ “ — → ▶ 罫線 など)は tmux / Ghostty の既定どおり 1 桁。
# (以前は ASCII 以外を一律 2 桁と数えていたため、’ や — を含む行で右端の罫線が左へずれていた)
char_width() {
  local c=$1
  local LC_ALL=C
  local n=${#c} b1 b2 b3 b4 cp
  REPLY=1
  ((n == 1)) && return 0
  printf -v b1 '%d' "'${c:0:1}"; ((b1 < 0)) && b1=$((b1 + 256))
  printf -v b2 '%d' "'${c:1:1}"; ((b2 < 0)) && b2=$((b2 + 256))
  if ((n == 2)); then
    cp=$(((b1 & 31) << 6 | (b2 & 63)))
    ((cp >= 0x300 && cp <= 0x36F)) && REPLY=0  # 結合文字
    return 0
  elif ((n == 3)); then
    printf -v b3 '%d' "'${c:2:1}"; ((b3 < 0)) && b3=$((b3 + 256))
    cp=$(((b1 & 15) << 12 | (b2 & 63) << 6 | (b3 & 63)))
  elif ((n == 4)); then
    printf -v b3 '%d' "'${c:2:1}"; ((b3 < 0)) && b3=$((b3 + 256))
    printf -v b4 '%d' "'${c:3:1}"; ((b4 < 0)) && b4=$((b4 + 256))
    cp=$(((b1 & 7) << 18 | (b2 & 63) << 12 | (b3 & 63) << 6 | (b4 & 63)))
  else
    return 0
  fi

  if ((cp == 0x200D || (cp >= 0xFE00 && cp <= 0xFE0F))); then
    REPLY=0  # ZWJ・異体字セレクタ
  elif ((cp >= 0x1100 && cp <= 0x115F)) \
    || ((cp >= 0x2E80 && cp <= 0x303E)) \
    || ((cp >= 0x3041 && cp <= 0x33FF)) \
    || ((cp >= 0x3400 && cp <= 0x4DBF)) \
    || ((cp >= 0x4E00 && cp <= 0x9FFF)) \
    || ((cp >= 0xA000 && cp <= 0xA4CF)) \
    || ((cp >= 0xAC00 && cp <= 0xD7A3)) \
    || ((cp >= 0xF900 && cp <= 0xFAFF)) \
    || ((cp >= 0xFE30 && cp <= 0xFE6F)) \
    || ((cp >= 0xFF00 && cp <= 0xFF60)) \
    || ((cp >= 0xFFE0 && cp <= 0xFFE6)) \
    || ((cp >= 0x1F300 && cp <= 0x1F64F)) \
    || ((cp >= 0x1F680 && cp <= 0x1F6FF)) \
    || ((cp >= 0x1F900 && cp <= 0x1F9FF)) \
    || ((cp >= 0x20000 && cp <= 0x3FFFD)) \
    || ((cp == 0x2705 || cp == 0x274C || cp == 0x2728 || cp == 0x26A1 || cp == 0x2B50 || cp == 0x2B1B || cp == 0x2B1C)); then
    REPLY=2
  fi
}

# REPLY に、表示幅 $2 以内へ切り詰めた $1 を入れる。実際に使った表示幅は TRUNC_W に入る
trunc() {
  local s=$1 max=$2 out="" w=0 i c cw
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [\ -~]) cw=1 ;;
      *) char_width "$c"; cw=$REPLY ;;
    esac
    ((w + cw > max)) && break
    out+=$c
    w=$((w + cw))
  done
  REPLY=$out
  TRUNC_W=$w
}

frame=""
row=0
# いま描画中の Agent の添字（Agent 以外の行は空）と、画面の行 → Agent 添字の対応（クリック判定用）
CUR_IDX=""
ROW_AGENT=()
# 現在描画中のカードの背景色
CARD_BG_NOW=""

# put <色> <テキスト> : 1 行ぶんを画面バッファに積む（幅超過は切り詰め、画面高さ超過は捨てる）
put() {
  ((row >= height)) && return 0
  row=$((row + 1))
  ROW_AGENT[row]=$CUR_IDX
  trunc "$2" $((width - 1))
  frame+="${ESC}[${row};1H${1}${REPLY}${ESC}[K${C_RESET}"
}

# 経過秒 → "45s" / "3m" / "2h5m" / "1d3h"。REPLY に入れる（空なら空）
fmt_elapsed() {
  local sec=$1
  REPLY=""
  [ -z "$sec" ] && return 0
  if ((sec < 60)); then
    REPLY="${sec}s"
  elif ((sec < 3600)); then
    REPLY="$((sec / 60))m"
  elif ((sec < 86400)); then
    REPLY="$((sec / 3600))h$((sec % 3600 / 60))m"
  else
    REPLY="$((sec / 86400))d$((sec % 86400 / 3600))h"
  fi
}

# 親ディレクトリを ~ 短縮し、長ければ末尾側を残して "…" で省く。REPLY に入れる
fmt_parent_dir() {
  local dir=${1%/*}
  [ -z "$dir" ] && dir=/
  case $dir in
    "$HOME") dir="~" ;;
    "$HOME"/*) dir="~${dir#"$HOME"}" ;;
  esac
  ((${#dir} > PARENT_DIR_MAX)) && dir="…${dir: -$((PARENT_DIR_MAX - 1))}"
  REPLY=$dir
}

# cwd の git ブランチ（detached HEAD なら短縮 SHA）。GIT_TTL 秒キャッシュして REPLY に入れる
GIC_DIR=()
GIC_AT=()
GIC_REPO=()
GIC_RKEY=()
GIC_WT=()
GIC_BR=()
GI_REPO=""
GI_RKEY=""
GI_WT=""
GI_BRANCH=""
git_info_of() {
  local dir=$1 i n=${#GIC_DIR[@]} out top common repokey br
  GI_REPO=""; GI_RKEY=""; GI_WT=""; GI_BRANCH=""
  [ -z "$dir" ] && return 0
  for ((i = 0; i < n; i++)); do
    if [ "${GIC_DIR[i]}" = "$dir" ]; then
      if ((SECONDS - GIC_AT[i] < GIT_TTL)); then
        GI_REPO=${GIC_REPO[i]}; GI_RKEY=${GIC_RKEY[i]}; GI_WT=${GIC_WT[i]}; GI_BRANCH=${GIC_BR[i]}
        return 0
      fi
      break
    fi
  done

  # --git-common-dir は worktree でも本体の .git を指す(= 同じリポジトリにまとまる)。
  # 存在しない dir(削除済みリポジトリなど)や git 管理外では何も返らない
  out=$(git -C "$dir" rev-parse --path-format=absolute --show-toplevel --git-common-dir 2>/dev/null)
  if [ -n "$out" ]; then
    top=${out%%$'\n'*}
    common=${out#*$'\n'}
    case ${common##*/} in
      .git) repokey=${common%/.git} ;;
      *) repokey=$common ;;
    esac
    GI_REPO=${repokey##*/}
    GI_RKEY=$repokey
    GI_WT=$top
    br=$(git -C "$dir" branch --show-current 2>/dev/null)
    [ -z "$br" ] && br=$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)
    GI_BRANCH=$br
  else
    # git 管理外: ディレクトリ単位で 1 グループ
    GI_RKEY=$dir
    GI_WT=$dir
    GI_REPO=${dir##*/}
    [ "$dir" = "$HOME" ] && GI_REPO="~"
    [ -z "$GI_REPO" ] && GI_REPO="/"
  fi
  GIC_DIR[i]=$dir; GIC_AT[i]=$SECONDS
  GIC_REPO[i]=$GI_REPO; GIC_RKEY[i]=$GI_RKEY; GIC_WT[i]=$GI_WT; GIC_BR[i]=$GI_BRANCH
}

# window の見出し行（"── 6 dotfiles ────"）。scope=all のときは session 名も添える
put_group_header() {
  local i=$1 count right right_w room fill_n fill
  count=${AG_RCOUNT[i]}
  right=" ${count} "
  # 空きシェルだけのリポジトリ(Agent が 0)は件数を出さない
  ((count == 0)) && right=" "
  right_w=${#right}
  ((row >= height)) && return 0
  row=$((row + 1))
  ROW_AGENT[row]=""
  # 「── リポジトリ名 ──────── 件数」。ブランチは各カードに出す(同じリポジトリでも worktree ごとにブランチが違うため)
  room=$((width - 1 - 3 - right_w - 1))
  trunc "${AG_REPO[i]}" "$room"
  fill_n=$((width - 1 - 3 - TRUNC_W - 1 - right_w))
  # printf の幅が負だと絶対値ぶんの空白を出してしまうので、0 未満は 0 にする
  ((fill_n < 0)) && fill_n=0
  printf -v fill '%*s' "$fill_n" ''
  frame+="${ESC}[${row};1H${C_RULE}── ${C_GROUP}${BOLD_ON}${REPLY}${BOLD_OFF} ${C_RULE}${fill// /─}${FG_DEFAULT}${C_DIM}${right}${ESC}[K${C_RESET}"
}


# カードの 1 行を積む。$1=中身(ANSI 付き)。中身の右側の余りは背景で埋める。
# 左端は状態色のバー(選択中は罫線 │)、右端は選択中だけ罫線 │
card_row() {
  ((row >= height)) && return 0
  row=$((row + 1))
  ROW_AGENT[row]=$CUR_IDX
  # 右の縁は桁を指定して描く。中身の表示幅($2)の見積もりが実際とずれても、縁の位置は動かない。
  # 先に ESC[K で行末まで背景を敷き、そのあとで縁を置く(縁の右 1 桁は既定の背景に戻す)
  # ROW_TAIL があれば、最後の桁(縁の右隣)にそれを置く(cockpit のタブの矢印)。無ければその桁を既定の背景に戻す
  frame+="${ESC}[${row};1H${CARD_BG_NOW}${EDGE_L} $1${ESC}[K${ESC}[${row};$((width - 1))H${EDGE_R}${C_RESET}${ROW_TAIL:-${ESC}[K}"
}
# card_row が行末に置く文字列(通常は空)
ROW_TAIL=""

# 右の枠の中身が、選択中の Agent と合っていないか。cockpit で、作ったばかりの Agent を検出待ちの間と、Daily ダッシュボードを出している間。
# このあいだは選択の表示(タブ・罫線)を出さない
selection_detached() {
  [ -n "$PENDING_ID" ] || [ "$DAILY_VIEW" = 1 ]
}

# 選択中のカードを橙の角丸罫線で囲むか。
# 通常の sidebar: sidebar にフォーカスがあるとき(カーソル)。
# cockpit: 右の枠にフォーカスがあるとき(sidebar にフォーカスがある間は、罫線ではなく橙の塗りつぶしのタブにする)
box_cursor() {
  selection_detached && return 1
  if [ "$COCKPIT" = 1 ]; then
    [ "$FOCUSED" != 1 ]
  else
    [ "$FOCUSED" = 1 ]
  fi
}

# Agent 間・window 区切りの 1 行。直下のカードが選択中ならその上辺 ╭──╮、直上のカードが選択中なら下辺 ╰──╯、
# どちらでもなければ空行。空行を罫線に兼用するので、選択しても行数は増えない
put_sep() {
  local above=$1 below=$2
  ((row >= height)) && return 0
  row=$((row + 1))
  ROW_AGENT[row]=""
  local boxed=0
  box_cursor && boxed=1
  if ((boxed)) && [ -n "$below" ] && [ "$below" = "$SEL_IDX" ]; then
    frame+="${ESC}[${row};1H${C_SELECT}╭${BORDER_FILL}╮${C_RESET}${ESC}[K"
  elif ((boxed)) && [ -n "$above" ] && [ "$above" = "$SEL_IDX" ]; then
    frame+="${ESC}[${row};1H${C_SELECT}╰${BORDER_FILL}╯${C_RESET}${ESC}[K"
  else
    frame+="${ESC}[${row};1H${ESC}[K"
  fi
}

# Agent の居ない空きシェルの欄(1 行)。そのリポジトリでまだ Agent が起動していないことを、背景なしの点線の縁で示す。
# 選択して n を押すと、その pane のシェルへ Claude / Codex を入力して起動する(tmux-agent-new --here)。
# 選択・現在地・cockpit のタブの見せ方は、通常のカード(put_agent)と同じ
put_idle() {
  local i=$1 inner=$CARD_INNER selected=0 tabbed=0 arrow_n="" name_on=$C_DIM hint_c=$C_ACTIVE pad
  if [ "$i" = "$SEL_IDX" ]; then
    if box_cursor; then
      selected=1
    elif [ "$COCKPIT" = 1 ] && ! selection_detached; then
      tabbed=1
    fi
    [ "$COCKPIT" = 1 ] && arrow_n=208
  fi
  CUR_IDX=$i
  if ((tabbed)); then
    arrow_n=130
    CARD_BG_NOW="${ESC}[48;5;130m"
    EDGE_L="${ESC}[38;5;208m█${C_RESET}${CARD_BG_NOW}"
    EDGE_R=" "
    name_on="${BOLD_ON}${ESC}[38;5;255m"
    hint_c=$name_on
  elif ((selected)); then
    CARD_BG_NOW=$CARD_BG_SELECTED
    EDGE_L="${C_SELECT}│${C_RESET}${CARD_BG_NOW}"
    EDGE_R="${C_SELECT}│${C_RESET}"
  else
    CARD_BG_NOW=""
    EDGE_L="${C_RULE}┆${FG_DEFAULT}"
    EDGE_R=" "
    # いま見ている pane(= このシェル)なら、通常のカードと同じ ▶ とシアンで示す
    if [ "${AG_ACT[i]}" = 1 ] && [ "$COCKPIT" != 1 ]; then
      name_on=$C_HERE
      EDGE_L="${C_HERE}▶${C_RESET}"
    fi
  fi
  # 「+ New agent ……… n」。幅が足りなければ n のヒントを落とす
  local label="+ New agent"
  if ((inner >= ${#label} + 3)); then
    printf -v pad '%*s' $((inner - ${#label} - 1)) ''
    label="${name_on}${label}${BOLD_OFF}${FG_DEFAULT}${pad}${hint_c}n${FG_DEFAULT}"
  else
    trunc "$label" "$inner"
    label="${name_on}${REPLY}${BOLD_OFF}${FG_DEFAULT}"
  fi
  [ -n "$arrow_n" ] && ROW_TAIL="${ESC}[38;5;${arrow_n}m${TAB_ARROW}${C_RESET}"
  card_row "$label"
  ROW_TAIL=""
  CUR_IDX=""
}

put_agent() {
  local i=$1
  [ "${AG_TYPE[i]}" = Shell ] && { put_idle "$i"; return 0; }
  local status=${AG_STATUS[i]} type=${AG_TYPE[i]} detail=${AG_DETAIL[i]} elapsed=${AG_ELAPSED[i]}
  local inner=$CARD_INNER color pill_bg pill_fg label name_on="" selected=0 bg_normal bg_sel
  local right right_w lw rest tw dw avail pad detail_part=""
  # cockpit の sidebar では、選択中のカードを右の枠と結ぶ。選択 = 右の枠に出ている Agent なので、
  # 罫線のカーソルと現在地の ▶ を一つにまとめ、右向きの矢印で右の枠を指す。
  # 形でフォーカス位置を示し、橙で「ここに注目」を示す:
  #   sidebar にフォーカス(選んでいる最中)  = 橙の塗りつぶしのタブ(状態色は隠れる)
  #   右の枠にフォーカス(操作している最中) = 状態色のカードを橙の角丸罫線で囲む
  local tabbed=0 tab_bg_n tab_acc_n arrow_n="" c_dim=$C_DIM c_proj=$C_PROJ c_rule=$C_RULE

  case $status in
    # 状態は左端のバーの色と状態ピルで示す。スピナーだけは working のピルの中で回す
    working) color=$C_WORKING; pill_bg=220; pill_fg=232; label="${SPINNER[SECONDS % ${#SPINNER[@]}]} WORKING"; bg_normal=$CARD_BG; bg_sel=$CARD_BG_SELECTED ;;
    waiting) color=$C_WAITING; pill_bg=196; pill_fg=255; label="WAITING"; bg_normal=$CARD_BG_WAITING; bg_sel=$CARD_BG_WAITING_SELECTED ;;
    done) color=$C_DONE; pill_bg=41; pill_fg=232; label="DONE"; bg_normal=$CARD_BG_DONE; bg_sel=$CARD_BG_DONE_SELECTED ;;
    idle) color=$C_IDLE; pill_bg=65; pill_fg=232; label="IDLE"; bg_normal=$CARD_BG_IDLE; bg_sel=$CARD_BG_IDLE_SELECTED ;;
    *) color=$C_UNKNOWN; pill_bg=240; pill_fg=252; label="UNKNOWN"; bg_normal=$CARD_BG; bg_sel=$CARD_BG_SELECTED ;;
  esac

  if [ "$i" = "$SEL_IDX" ]; then
    if box_cursor; then
      selected=1
    elif [ "$COCKPIT" = 1 ] && ! selection_detached; then
      tabbed=1
    fi
    [ "$COCKPIT" = 1 ] && arrow_n=208
  fi
  CUR_IDX=$i
  if ((tabbed)); then
    tab_bg_n=130; tab_acc_n=208; arrow_n=$tab_bg_n
    CARD_BG_NOW="${ESC}[48;5;${tab_bg_n}m"
    EDGE_L="${ESC}[38;5;${tab_acc_n}m█${C_RESET}${CARD_BG_NOW}"
    EDGE_R=" "
    # 塗りつぶしの上で読めるよう、補助の文字色を明るくする
    c_dim="${ESC}[38;5;254m"
    c_proj=$c_dim
    c_rule=$c_dim
    name_on="${BOLD_ON}${ESC}[38;5;255m"
  elif ((selected)); then
    CARD_BG_NOW=$bg_sel
    EDGE_L="${C_SELECT}│${C_RESET}${CARD_BG_NOW}"
    EDGE_R="${C_SELECT}│${C_RESET}"
  else
    CARD_BG_NOW=$bg_normal
    EDGE_L="${color}▎${FG_DEFAULT}"
    EDGE_R=" "
  fi
  # 1 行目: project ……… 種別。いま見ている pane の Agent は、左端を ▶ にして project 名をシアンの太字にする
  # (選択中は左端が罫線 │ なので ▶ にはしない)
  right="${c_dim}${type}${FG_DEFAULT}"
  right_w=${#type}
  # 種別を画像で示せるときは、左端に 2 桁の画像 + 空白を置き、右寄せの文字は出さない(project 名の幅が増える)
  local lead="" lead_w=0 gap=1
  type_icon_cells "$type"
  if [ -n "$REPLY" ]; then
    lead="$REPLY "
    lead_w=3
    right=""
    right_w=0
    gap=0
  fi
  local edge_l_saved=$EDGE_L
  # (cockpit ではタブで示すので、▶ とシアンの名前は使わない)
  if [ "${AG_ACT[i]}" = 1 ] && [ "$COCKPIT" != 1 ]; then
    name_on=$C_HERE
    ((selected)) || EDGE_L="${C_HERE}▶${C_RESET}${CARD_BG_NOW}"
  fi
  # 1 行目は名前(会話タイトル等)。無ければ project。リポジトリは見出しに出すのでカードには出さない
  trunc "${AG_TITLE[i]:-${AG_PROJ[i]}}" $((inner - lead_w - right_w - gap))
  printf -v pad '%*s' $((inner - lead_w - TRUNC_W - right_w)) ''
  card_row "${lead}${name_on}${REPLY}${BOLD_OFF}${FG_DEFAULT}${pad}${right}"
  EDGE_L=$edge_l_saved

  # 2 行目はブランチ(同じリポジトリでも worktree ごとに違う)。git 管理外は親ディレクトリ。
  # cockpit の選択中のカードは、この行(3 行の中段)の行末に、右の枠を指す矢印を置く(矢印の色 = タブの色。罫線のときは橙)
  local line=""
  if [ -n "${AG_BRANCH[i]}" ]; then
    trunc "${AG_BRANCH[i]}" $((inner - ICON_W))
    line="${c_dim}${ICON_BRANCH}${REPLY}${FG_DEFAULT}"
  else
    trunc "${AG_DIR[i]}" $((inner - ICON_W))
    line="${c_rule}${ICON_DIR}${REPLY}${FG_DEFAULT}"
  fi
  [ -n "$arrow_n" ] && ROW_TAIL="${ESC}[38;5;${arrow_n}m${TAB_ARROW}${C_RESET}"
  card_row "$line"
  ROW_TAIL=""

  # 状態ピル + 待機理由 ……… 継続時間(右寄せ)
  local pillw=$((${#label} + 2)) elw=${#elapsed}
  avail=$((inner - pillw - 1))
  ((elw > 0)) && avail=$((avail - elw - 1))
  dw=0
  if [ -n "$detail" ] && ((avail >= 4)); then
    trunc "$detail" "$avail"
    dw=$((TRUNC_W + 1))
    detail_part=" ${c_dim}${REPLY}${FG_DEFAULT}"
  fi
  printf -v pad '%*s' $((inner - pillw - dw - elw)) ''
  card_row "${ESC}[48;5;${pill_bg};38;5;${pill_fg};1m ${label} ${BOLD_OFF}${FG_DEFAULT}${CARD_BG_NOW}${detail_part}${pad}${c_dim}${elapsed}${FG_DEFAULT}"

  CUR_IDX=""
}

