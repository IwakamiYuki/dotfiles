WEB_RO=""

# json_field <json> <key> : 単純な "key": value を REPLY に入れる(null は空)。fork せず正規表現で読む
json_field() {
  local re="\"$2\"[[:space:]]*:[[:space:]]*\"?([^\",}[:space:]]+)"
  REPLY=""
  [[ $1 =~ $re ]] && REPLY=${BASH_REMATCH[1]}
  [ "$REPLY" = null ] && REPLY=""
  return 0
}

# リセット時刻(epoch 秒 または ISO 8601 UTC)を "2h30m" / "5d12h" / "now" 形式の残り時間にして REPLY に入れる
fmt_reset_in() {
  local at=$1 epoch="" clean diff
  REPLY=""
  [ -z "$at" ] && return 0
  if [[ $at =~ ^[0-9]+$ ]]; then
    epoch=$at
  else
    clean="${at%%.*}"
    clean="${clean%Z}"
    epoch=$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "$clean" "+%s" 2>/dev/null)
  fi
  [ -z "$epoch" ] && return 0
  diff=$((epoch - $(date +%s)))
  if ((diff <= 0)); then
    REPLY="now"
  elif ((diff >= 86400)); then
    REPLY="$((diff / 86400))d$((diff % 86400 / 3600))h"
  elif ((diff >= 3600)); then
    REPLY="$((diff / 3600))h$((diff % 3600 / 60))m"
  else
    REPLY="$((diff / 60))m"
  fi
}

# 1 つの窓（5h / 1w）の使用率とリセットまでの残りを LIM_WIN_PCT / LIM_WIN_RESET に入れる: read_limit_window <json> <使用率のキー> <リセットのキー>
# リセット時刻を過ぎた窓は、その後の使用率が分からない古い値なので空にする。
# 契約を替えるなどで statusline.sh が書かなくなったファイルの値が、出続けないようにするため
read_limit_window() {
  local pct
  LIM_WIN_PCT=""; LIM_WIN_RESET=""
  json_field "$1" "$2"
  [ -z "$REPLY" ] && return 0
  pct=$REPLY
  json_field "$1" "$3"
  fmt_reset_in "$REPLY"
  [ "$REPLY" = now ] && return 0
  printf -v LIM_WIN_PCT '%.0f' "$pct" 2>/dev/null || LIM_WIN_PCT=0
  LIM_WIN_RESET=$REPLY
}

read_limits() {
  local json
  LIM_5H_PCT=""; LIM_5H_RESET=""; LIM_1W_PCT=""; LIM_1W_RESET=""
  [ -r "$RATE_LIMIT_FILE" ] || return 0
  json=$(<"$RATE_LIMIT_FILE") || return 0

  read_limit_window "$json" five_hour_pct five_hour_resets
  LIM_5H_PCT=$LIM_WIN_PCT
  LIM_5H_RESET=$LIM_WIN_RESET
  read_limit_window "$json" seven_day_pct seven_day_resets
  LIM_1W_PCT=$LIM_WIN_PCT
  LIM_1W_RESET=$LIM_WIN_RESET
}

# fmt_money <数値> <通貨> <whole>: 通貨記号つき・桁区切りの金額を REPLY に入れる（fork しない）。
# whole=1 なら端数が 00 のとき小数を省く（上限の $1,300 用）。USD 以外は記号の代わりに通貨コードを付ける
fmt_money() {
  local n=$1 cur=$2 whole=$3 s int frac out="" sym
  printf -v s '%.2f' "$n" 2>/dev/null || s=0.00
  int=${s%.*}
  frac=${s#*.}
  while ((${#int} > 3)); do
    out=",${int: -3}$out"
    int=${int%???}
  done
  out=$int$out
  if [ "$whole" != 1 ] || [ "$frac" != 00 ]; then
    out+=".$frac"
  fi
  if [ "$cur" = USD ]; then sym='$'; else sym="$cur "; fi
  REPLY="$sym$out"
}

# fmt_int <数値>: 四捨五入した整数を桁区切りにして REPLY に入れる（fork しない）。Codex のクレジット用
fmt_int() {
  local s out=""
  printf -v s '%.0f' "$1" 2>/dev/null || s=0
  while ((${#s} > 3)); do
    out=",${s: -3}$out"
    s=${s%???}
  done
  REPLY=$s$out
}

# 経過秒を "12m" / "3h" / "2d" にして REPLY に入れる
fmt_age() {
  local sec=$1
  if ((sec >= 86400)); then REPLY="$((sec / 86400))d"
  elif ((sec >= 3600)); then REPLY="$((sec / 3600))h"
  else REPLY="$((sec / 60))m"; fi
}

# 今月の着地予想(営業日ベース)が上限の何 % かを CRED_LAND_PCT に入れる。予想できないときは空。
#   着地予想 = 使用額 × 今月の営業日数 ÷ 今日までに経過した営業日数（営業日 = 平日。祝日は考慮しない）
# 営業日で数えるのは、業務での利用が土日にほとんど無いため。金額はセントの整数にして、割り算は最後に 1 回だけ行う（fork しない）。
# 今日の日付は date で取る(テストでは AGENT_SIDEBAR_TODAY=YYYY-MM-DD で固定する)
calc_credits_landing() {
  CRED_LAND_PCT=""
  [ -n "$CRED_LIMIT" ] || return 0
  [ -z "$CRED_AGE" ] || return 0   # 取得が止まった古い値からは予想しない
  landing_pct "$CRED_USED" "$CRED_LIMIT" && CRED_LAND_PCT=$REPLY
}

# landing_pct <使用額> <上限>: 今月の着地予想が上限の何 % かを REPLY に入れる(整数)。予想できないときは 1 を返す。
# 金額の単位は問わない(ドルでも Codex のクレジットでも、比だけを見る)。💳 と Codex の行が共有する
landing_pct() {
  REPLY=""
  local used_c limit_c y m d wd days wd1 i wi total=0 elapsed=0
  printf -v used_c '%.2f' "$1" 2>/dev/null || return 1
  printf -v limit_c '%.2f' "$2" 2>/dev/null || return 1
  used_c=$((10#${used_c/./}))
  limit_c=$((10#${limit_c/./}))
  ((limit_c > 0)) || return 1

  if [ -n "${AGENT_SIDEBAR_TODAY:-}" ]; then
    set -- $(date -j -f %Y-%m-%d "$AGENT_SIDEBAR_TODAY" '+%Y %m %d %u' 2>/dev/null)
  else
    set -- $(date '+%Y %m %d %u' 2>/dev/null)
  fi
  [ $# -eq 4 ] || return 1
  y=$1; m=$((10#$2)); d=$((10#$3)); wd=$4   # wd: 1=月 … 7=日

  case $m in
    1|3|5|7|8|10|12) days=31 ;;
    4|6|9|11) days=30 ;;
    *) if ((y % 4 == 0 && (y % 100 != 0 || y % 400 == 0))); then days=29; else days=28; fi ;;
  esac
  wd1=$(((wd - 1 - (d - 1) % 7 + 7) % 7 + 1))   # 今月 1 日の曜日

  for ((i = 1; i <= days; i++)); do
    wi=$(((wd1 - 1 + i - 1) % 7))               # 0=月 … 6=日
    if ((wi < 5)); then
      total=$((total + 1))
      ((i <= d)) && elapsed=$((elapsed + 1))
    fi
  done
  ((elapsed > 0)) || return 1                    # 月初で営業日がまだ 1 日も経っていない(1 日が土日など)
  REPLY=$((used_c * total * 100 / (limit_c * elapsed)))
}

# usage credits を読む。無効（is_enabled が false）・読めないときは CRED_USED を空にして出さない。
# 値は fetch-usage-credits.sh が通貨単位に直して書く（最小単位の変換は取得側）
read_credits() {
  local json age cents
  CRED_USED=""; CRED_LIMIT=""; CRED_PCT=""; CRED_CUR="USD"; CRED_AGE=""; CRED_CENTS=""; CRED_LAND_PCT=""
  [ -r "$CREDITS_FILE" ] || return 0
  json=$(<"$CREDITS_FILE") || return 0

  json_field "$json" enabled
  [ "$REPLY" = true ] || return 0
  json_field "$json" used
  [ -z "$REPLY" ] && return 0
  CRED_USED=$REPLY
  json_field "$json" limit
  CRED_LIMIT=$REPLY
  json_field "$json" percent
  [ -n "$REPLY" ] && { printf -v CRED_PCT '%.0f' "$REPLY" 2>/dev/null || CRED_PCT=""; }
  json_field "$json" currency
  [ -n "$REPLY" ] && CRED_CUR=$REPLY
  # はしごはドル建てなので、ドルのときだけ。小数点を除くとセントの整数になる("0.50" の先頭の 0 は 10# で 10 進扱い)
  if [ "$CRED_CUR" = USD ] && printf -v cents '%.2f' "$CRED_USED" 2>/dev/null; then
    cents=$((10#${cents/./}))
    ((cents >= 100)) && CRED_CENTS=$cents
  fi
  json_field "$json" fetched_at
  if [ -n "$REPLY" ]; then
    age=$(($(date +%s) - ${REPLY%.*}))
    if ((age >= CREDITS_STALE_SEC)); then
      fmt_age "$age"
      CRED_AGE=$REPLY
    fi
  fi
  calc_credits_landing
}

# Codex の今月の使用量(クレジット)を読む。無効・読めないときは CX_USED を空にして出さない。
# ファイルは tmux-agent-codex-usage が書く。取得は sidebar が CODEX_REFRESH_SEC ごとに裏で起動する(TTL 内なら何もせず終わる)
read_codex_usage() {
  local json age
  if ((SECONDS - CODEX_FETCHED_AT >= CODEX_REFRESH_SEC)); then
    CODEX_FETCHED_AT=$SECONDS
    "$CODEX_USAGE_BIN" >/dev/null 2>&1 &
    disown 2>/dev/null
  fi
  CX_USED=""; CX_LIMIT=""; CX_PCT=""; CX_AGE=""; CX_LAND_PCT=""
  [ -r "$CODEX_FILE" ] || return 0
  json=$(<"$CODEX_FILE") || return 0

  json_field "$json" enabled
  [ "$REPLY" = true ] || return 0
  json_field "$json" used
  [ -z "$REPLY" ] && return 0
  CX_USED=$REPLY
  json_field "$json" limit
  CX_LIMIT=$REPLY
  [ -n "$CX_LIMIT" ] || { CX_USED=""; return 0; }
  json_field "$json" percent
  [ -n "$REPLY" ] && { printf -v CX_PCT '%.0f' "$REPLY" 2>/dev/null || CX_PCT=""; }
  json_field "$json" fetched_at
  if [ -n "$REPLY" ]; then
    age=$(($(date +%s) - ${REPLY%.*}))
    if ((age >= CREDITS_STALE_SEC)); then
      fmt_age "$age"
      CX_AGE=$REPLY
    fi
  fi
  if [ -z "$CX_AGE" ] && landing_pct "$CX_USED" "$CX_LIMIT"; then
    CX_LAND_PCT=$REPLY
  fi
}

# 使用率に応じた色(tmux-rate-limits と同じ段階: 低=橙系 → 80% 以上は赤)を REPLY に入れる
limit_color() {
  local pct=$1
  if ((pct < 30)); then REPLY="${ESC}[38;5;214m"
  elif ((pct < 60)); then REPLY="${ESC}[38;5;220m"
  elif ((pct < 80)); then REPLY="${ESC}[38;5;226m"
  else REPLY="${ESC}[38;5;196m"; fi
}

# limit_row <行番号> <ラベル> <使用率> <リセットまで>: "5h ████░░░░  23%  2h30m" を FOOTER_FRAME に積む
limit_row() {
  local at=$1 label=$2 pct=$3 reset=$4 bw filled filled_str empty_str rs="" color pct_str
  [ -n "$reset" ] && rs="  $reset"
  # 行の構成: 空白1 + ラベル2 + 空白1 + バー + 空白1 + 使用率4桁 + リセット + 右余白1。
  # バー幅は 5h / 1w で揃えるため、長い方のリセット表記(FOOTER_RLEN)に合わせる
  bw=$((width - 10 - FOOTER_RLEN))
  if ((bw < 4)); then
    rs=""
    bw=$((width - 10))
  fi
  ((bw > 14)) && bw=14
  ((bw < 3)) && bw=3
  ((pct > 100)) && pct=100
  filled=$((pct * bw / 100))
  ((pct > 0 && filled == 0)) && filled=1
  printf -v filled_str '%*s' "$filled" ''
  printf -v empty_str '%*s' $((bw - filled)) ''
  limit_color "$pct"
  color=$REPLY
  printf -v pct_str '%3d%%' "$pct"
  FOOTER_FRAME+="${ESC}[${at};1H ${C_DIM}${label}${FG_DEFAULT} ${color}${filled_str// /█}${C_RULE}${empty_str// /░}${FG_DEFAULT} ${color}${pct_str}${C_DIM}${rs}${FG_DEFAULT}${ESC}[K${C_RESET}"
}

# landing_color <着地予想の %> <使用率>: 金額の色を REPLY に入れる。
# 色は、今月の着地予想が上限(月の予算)を超えそうか。予想できない(空)ときは、今の使用率の段階にする
landing_color() {
  local land=$1 pct=$2
  if [ -z "$land" ]; then
    limit_color "$pct"
  elif ((land > CREDITS_LAND_ALERT_PCT)); then
    REPLY="${ESC}[38;5;196m"
  elif ((land > CREDITS_LAND_WARN_PCT)); then
    REPLY="${ESC}[38;5;220m"
  else
    REPLY="${ESC}[38;5;108m"
  fi
}

# credits_row <行番号>: "💳 $29.84 / $1,300  2%  3h" を FOOTER_FRAME に積む。行頭は Claude の画像アイコン(出せなければ 💳)。
# 幅に収まる範囲で、金額 → 上限 → 使用率 → 古さ(取得が止まっているとき)の順に足す。
# 色は使用率で limit_color と同じ段階に変える（上限なしは使用率が無いので低い段階の色）
credits_row() {
  local at=$1 used limit color body plain_len piece
  fmt_money "$CRED_USED" "$CRED_CUR" 0
  used=$REPLY
  landing_color "$CRED_LAND_PCT" "${CRED_PCT:-0}"
  color=$REPLY
  body="${color}${used}"
  plain_len=$((4 + ${#used}))   # 空白1 + ラベル(💳=2桁) + 空白1 + 金額

  if [ -n "$CRED_LIMIT" ]; then
    fmt_money "$CRED_LIMIT" "$CRED_CUR" 1
    limit=$REPLY
    piece=" / $limit"
    if ((plain_len + ${#piece} <= width - 1)); then
      body+="${C_DIM}${piece}"
      plain_len=$((plain_len + ${#piece}))
    fi
  fi
  if [ -n "$CRED_PCT" ]; then
    printf -v piece '%4s%%' "$CRED_PCT"
    if ((plain_len + ${#piece} <= width - 1)); then
      body+="${color}${piece}"
      plain_len=$((plain_len + ${#piece}))
    fi
  fi
  if [ -n "$CRED_AGE" ]; then
    piece="  $CRED_AGE"
    ((plain_len + ${#piece} <= width - 1)) && body+="${C_DIM}${piece}"
  fi
  usage_label Claude 💳
  FOOTER_FRAME+="${ESC}[${at};1H ${FG_DEFAULT}${REPLY} ${body}${FG_DEFAULT}${ESC}[K${C_RESET}"
}

# codex_row <行番号>: "🤖 2,533 / 20,000   13%  3h" を FOOTER_FRAME に積む。Codex の今月の使用量(クレジット)。行頭は Codex の画像アイコン(出せなければ 🤖)。
# 幅に収まる範囲で、使用量 → 上限 → 使用率 → 古さ(取得が止まっているとき)の順に足す。色は 💳 と同じ(着地予想)
codex_row() {
  local at=$1 used limit color body plain_len piece
  fmt_int "$CX_USED"
  used=$REPLY
  landing_color "$CX_LAND_PCT" "${CX_PCT:-0}"
  color=$REPLY
  body="${color}${used}"
  plain_len=$((4 + ${#used}))   # 空白1 + ラベル(🤖=2桁) + 空白1 + 使用量

  fmt_int "$CX_LIMIT"
  limit=$REPLY
  piece=" / $limit"
  if ((plain_len + ${#piece} <= width - 1)); then
    body+="${C_DIM}${piece}"
    plain_len=$((plain_len + ${#piece}))
  fi
  if [ -n "$CX_PCT" ]; then
    printf -v piece '%4s%%' "$CX_PCT"
    if ((plain_len + ${#piece} <= width - 1)); then
      body+="${color}${piece}"
      plain_len=$((plain_len + ${#piece}))
    fi
  fi
  if [ -n "$CX_AGE" ]; then
    piece="  $CX_AGE"
    ((plain_len + ${#piece} <= width - 1)) && body+="${C_DIM}${piece}"
  fi
  usage_label Codex 🤖
  FOOTER_FRAME+="${ESC}[${at};1H ${FG_DEFAULT}${REPLY} ${body}${FG_DEFAULT}${ESC}[K${C_RESET}"
}

# credits_icons_row <行番号>: 使った額を、はしごの絵文字に分解して 1 行に並べる("🍜🧃🧃" など)。
# 大きい単位から順に、1 つ上の単位に満たない数だけ並べる。幅に収まらない分は小さい単位から切り捨てる
credits_icons_row() {
  local at=$1 cents=$CRED_CENTS rung step icon n total=0 max out=""
  max=$(((width - 1 - 4) / 2))   # 左の余白(4桁) を除いた幅を、絵文字(2桁)で割る
  ((max > CREDITS_ICON_MAX)) && max=$CREDITS_ICON_MAX
  for rung in "${CREDITS_LADDER[@]}"; do
    step=${rung%%|*}
    icon=${rung#*|}
    n=$((cents / step))
    cents=$((cents % step))
    while ((n > 0 && total < max)); do
      out+=$icon
      total=$((total + 1))
      n=$((n - 1))
    done
  done
  FOOTER_FRAME+="${ESC}[${at};1H    ${out}${ESC}[K${C_RESET}"
}

# daily_row <行番号>: "📝 Daily 4h00m  o open" を FOOTER_FRAME に積む。経過時間の色は DAILY_WARN_SEC / DAILY_ALERT_SEC で変わる。
# cockpit では "d view"(右の枠にダッシュボードを出す)も足す。ダッシュボードを出している間は、橙の塗りつぶしのタブにして "d back" にする
# (Agent の選択タブと同じ見せ方。選択の表示を出していない間、いま右の枠に何が出ているかをここで示す)。
# 幅に収まらないヒントは省く(行の折り返しで下部欄が崩れないようにする)
daily_row() {
  local at=$1 color body body_w bg="" fg="$C_DIM" key=$C_ACTIVE hint="" hint_w=0
  case $DAILY_STATE in
    ok)
      if ((DAILY_AGE >= 3600)); then
        printf -v body '%dh%02dm' $((DAILY_AGE / 3600)) $((DAILY_AGE % 3600 / 60))
      else
        body="$((DAILY_AGE / 60))m"
      fi
      body_w=$((${#body} + 1))
      if ((DAILY_AGE > DAILY_ALERT_SEC)); then color="${ESC}[38;5;196m"
      elif ((DAILY_AGE > DAILY_WARN_SEC)); then color="${ESC}[38;5;220m"
      else color="${ESC}[38;5;108m"
      fi
      body=" ${color}${body}"
      ;;
    missing)
      body=" ${ESC}[38;5;196m未作成"
      body_w=7   # 空白 + 日本語 3 文字(6 桁)
      ;;
    *)
      body=""
      body_w=0
      ;;
  esac
  local icon="📝"
  daily_blinking && ((SECONDS % 2)) && icon=$DAILY_BLINK_ICON
  if [ "$DAILY_VIEW" = 1 ]; then
    bg="${ESC}[48;5;130m"
    fg="${ESC}[38;5;252m"
    key="${ESC}[38;5;231m"
  fi
  # 先頭の空白 1 + 📝(2) + 空白 + Daily(5) = 9 桁。ヒントは、空白 2 + "o open"(6) = 8 桁、"d view" / "d back" も空白 2 + 6 桁 = 8 桁
  if ((9 + body_w + 8 <= width - 1)); then
    hint="  ${key}o${fg} open"
    hint_w=8
  fi
  if [ "$COCKPIT" = 1 ] && ((9 + body_w + hint_w + 8 <= width - 1)); then
    if [ "$DAILY_VIEW" = 1 ]; then hint+="  ${key}d${fg} back"; else hint+="  ${key}d${fg} view"; fi
  fi
  FOOTER_FRAME+="${ESC}[${at};1H${bg} ${FG_DEFAULT}${icon} ${fg}Daily${body}${fg}${hint}${ESC}[K${C_RESET}"
}

# 下部欄の区画の見出し: "── USAGE ───────"。title は両側の空白を含める
footer_heading() {
  local at=$1 title=$2 fill
  printf -v fill '%*s' $((width - 1 - 2 - ${#title})) ''
  FOOTER_FRAME+="${ESC}[${at};1H${C_RULE}──${C_GROUP}${BOLD_ON}${title}${BOLD_OFF}${C_RULE}${fill// /─}${ESC}[K${C_RESET}"
}

# 下部欄を組み立てる。FOOTER_FRAME に描画文字列、footer_rows に使う行数を入れる

# 今日の Daily Note の最終更新を読み、DAILY_STATE / DAILY_AGE に入れる。opt_daily_dir は収集の周期で tmux の option から読んだもの
read_daily() {
  local dir=${AGENT_SIDEBAR_DAILY_DIR:-$opt_daily_dir} today now mtime wd hour
  ((SECONDS - DAILY_CHECKED_AT < DAILY_REFRESH_SEC)) && return 0
  DAILY_CHECKED_AT=$SECONDS
  DAILY_STALE=0
  # 指定が無ければ、Obsidian の設定(Daily Notes の folder)から求める。パスの解決は tmux-agent-daily に 1 か所だけ持つ
  [ -n "$dir" ] || dir=$(AGENT_DAILY_NO_TMUX=1 "$DAILY_BIN" --print-dir 2>/dev/null)
  DAILY_DIR_RESOLVED=$dir
  if [ -z "$dir" ]; then
    DAILY_STATE=off
    return 0
  fi
  read -r today now wd hour < <(date '+%Y-%m-%d %s %u %H')
  hour=$((10#$hour))
  if ((hour < DAILY_WORK_TO - 24)); then
    # 24 時を過ぎた深夜(DAILY_WORK_TO が 25 なら 0 時台)は、前日の続き。前日の日付・曜日で、時刻は 24 を足した値として扱う
    read -r today wd < <(date -v-1d '+%Y-%m-%d %u')
    hour=$((hour + 24))
  fi
  today=${AGENT_SIDEBAR_TODAY:-$today}
  mtime=$(stat -f %m "${dir/#\~/$HOME}/$today.md" 2>/dev/null)
  if [ -z "$mtime" ]; then
    DAILY_STATE=missing
    # 今日のノートがまだ無いのも「更新されていない」。勤務日で、猶予(DAILY_MISSING_FROM)後〜勤務時間の終わりまで点滅する
    if [[ $DAILY_WORK_DAYS == *$wd* ]] && ((hour >= DAILY_MISSING_FROM && hour < DAILY_WORK_TO)); then
      DAILY_STALE=1
    fi
    return 0
  fi
  DAILY_STATE=ok
  DAILY_AGE=$((now - mtime))
  ((DAILY_AGE < 0)) && DAILY_AGE=0
  # 点滅の対象: 長く更新されていない × 勤務日 × 勤務時間帯
  if ((DAILY_AGE > DAILY_ALERT_SEC)) && [[ $DAILY_WORK_DAYS == *$wd* ]] \
    && ((hour >= DAILY_WORK_FROM && hour < DAILY_WORK_TO)); then
    DAILY_STALE=1
  fi
  return 0
}

# いま Daily 欄のアイコンを点滅させるか(描画と、1 秒ごとの再描画の要否で使う)。ダッシュボードを見ている間は、すでに注目しているので点滅させない
daily_blinking() {
  [ "$DAILY_STALE" = 1 ] && [ "$DAILY_VIEW" != 1 ] && [ "${AGENT_SIDEBAR_DAILY_BLINK:-${opt_daily_blink:-on}}" != off ]
}

# WEB サーバーの状態ファイルを読み、状態(ON/OFF・ポート・閲覧のみか)が変わったら 0、変わらなければ 1 を返す。
# fork しない(JSON は json_field の正規表現で読み、pid の生存は kill -0)ので毎 tick 呼んでよい
read_web_state() {
  local on=0 port="" ro="" json pid
  if [ -r "$WEB_STATE_FILE" ]; then
    json=$(<"$WEB_STATE_FILE")
    json_field "$json" pid
    pid=$REPLY
    json_field "$json" port
    port=$REPLY
    json_field "$json" readOnly
    ro=$REPLY
    [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && on=1
  fi
  ((on)) || { port=""; ro=""; }
  [ "$on|$port|$ro" = "$WEB_ON|$WEB_PORT|$WEB_RO" ] && return 1
  WEB_ON=$on
  WEB_PORT=$port
  WEB_RO=$ro
  return 0
}

# 下部欄: レートリミット(USAGE。データがあるときだけ)と、最下行の WEB 欄(スマホ用サーバーの ON/OFF)
build_footer() {
  local top usage_rows=0 web plain
  FOOTER_FRAME=""
  footer_rows=0
  ((term_h < FOOTER_MIN_TERM_H)) && return 0

  # 行は、データがあるものだけ並べる（5h / 1w は rate_limits が届くサブスク、💳 は usage credits がある従量課金）。
  # 先頭の見出し(USAGE)は、行が 1 つでもあれば 1 行足す
  [ -n "$LIM_5H_PCT" ] && usage_rows=$((usage_rows + 1))
  [ -n "$LIM_1W_PCT" ] && usage_rows=$((usage_rows + 1))
  [ -n "$CRED_USED" ] && usage_rows=$((usage_rows + 1))
  [ -n "$CRED_CENTS" ] && usage_rows=$((usage_rows + 1))
  [ -n "$CX_USED" ] && usage_rows=$((usage_rows + 1))
  ((usage_rows > 0)) && usage_rows=$((usage_rows + 1))
  # 下部欄は 2 つの区画: USAGE(データがあるとき。見出し + 行)と、TOOLS(常に。見出し + Daily 欄 + WEB 欄で 3 行。WEB が最下行)
  footer_rows=$((usage_rows + 3))
  top=$((term_h - footer_rows + 1))

  if ((usage_rows > 0)); then
    local row=$((top + 1))
    FOOTER_RLEN=0
    [ -n "$LIM_5H_PCT" ] && [ -n "$LIM_5H_RESET" ] && FOOTER_RLEN=$((2 + ${#LIM_5H_RESET}))
    [ -n "$LIM_1W_PCT" ] && [ -n "$LIM_1W_RESET" ] && ((2 + ${#LIM_1W_RESET} > FOOTER_RLEN)) && FOOTER_RLEN=$((2 + ${#LIM_1W_RESET}))
    footer_heading "$top" " USAGE "
    if [ -n "$LIM_5H_PCT" ]; then
      limit_row "$row" 5h "$LIM_5H_PCT" "$LIM_5H_RESET"
      row=$((row + 1))
    fi
    if [ -n "$LIM_1W_PCT" ]; then
      limit_row "$row" 1w "$LIM_1W_PCT" "$LIM_1W_RESET"
      row=$((row + 1))
    fi
    if [ -n "$CRED_USED" ]; then
      credits_row "$row"
      row=$((row + 1))
    fi
    if [ -n "$CRED_CENTS" ]; then
      credits_icons_row "$row"
      row=$((row + 1))
    fi
    [ -n "$CX_USED" ] && codex_row "$row"
  fi

  if ((WEB_ON)); then
    # 幅に収まる範囲で、操作ヒント(w stop = 8 桁、W copy = 7 桁)を足す。行の折り返しで下部欄が崩れないようにする
    web="${C_DONE}●${C_TITLE_ROW} WEB ${C_DONE}ON${C_DIM} :${WEB_PORT}"
    plain=" ● WEB ON :${WEB_PORT}"
    if [ "$WEB_RO" = true ]; then
      web+=" ro"
      plain+=" ro"
    fi
    if ((${#plain} + 8 <= width - 1)); then
      web+="  ${C_ACTIVE}w${C_DIM} stop"
      plain+="  w stop"
    fi
    ((${#plain} + 7 <= width - 1)) && web+=" ${C_ACTIVE}W${C_DIM} copy"
  else
    web="${C_DIM}○ WEB off  ${C_ACTIVE}w${C_DIM} start"
  fi
  footer_heading $((term_h - 2)) " $FOOTER_TOOLS_TITLE "
  daily_row $((term_h - 1))
  FOOTER_FRAME+="${ESC}[${term_h};1H ${web}${ESC}[K${C_RESET}"
}

# FIT に「top 番目から表示できる Agent 数」を入れる。
# 並び: 見出し → [区切り → カード]… → 閉じの区切り（リポジトリごと）。区切りは選択時に罫線になる。
#   各カード     : 区切り 1 + カードの行数
#   最初の Agent  : さらにリポジトリの見出し 1
#   別のリポジトリ: さらに「前のリポジトリの閉じの区切り 1 + 見出し 1」
#   最後に閉じの区切り 1 を必ず見込む
# 全件が収まらない（または先頭を省いている）ときは「+N more」の 1 行ぶんを空けて数え直す
compute_fit() {
  local top=$1 avail pass i used n need
  for pass in 1 2; do
    avail=$((height - HEADER_ROWS))
    ((pass == 2)) && avail=$((avail - 1))
    used=0
    n=0
    for ((i = top; i < AG_N; i++)); do
      need=$((${AG_ROWS[i]} + 1))
      if ((n == 0)); then
        # 先頭の Agent: リポジトリの見出し
        need=$((need + 1))
      elif [ "${AG_RKEY[i]}" != "${AG_RKEY[i - 1]}" ]; then
        # 別のリポジトリ: 前のリポジトリの閉じの区切り + 見出し
        need=$((need + 2))
      fi
      ((used + need + 1 > avail)) && break
      used=$((used + need))
      n=$((n + 1))
    done
    ((pass == 1 && top == 0 && n == AG_N)) && break
  done
  ((n < 1)) && n=1
  FIT=$n
}

# 先頭行: 「▎AGENTS ……… 状態別の件数」
put_title_row() {
  local summary="" sumw=0 pad
  ((N_WORK > 0)) && { summary+="${C_WORKING}▎${FG_DEFAULT}${N_WORK} "; sumw=$((sumw + 2 + ${#N_WORK})); }
  ((N_WAIT > 0)) && { summary+="${C_WAITING}▎${FG_DEFAULT}${N_WAIT} "; sumw=$((sumw + 2 + ${#N_WAIT})); }
  ((N_DONE > 0)) && { summary+="${C_DONE}▎${FG_DEFAULT}${N_DONE} "; sumw=$((sumw + 2 + ${#N_DONE})); }
  ((row >= height)) && return 0
  row=$((row + 1))
  ROW_AGENT[row]=""
  # 左側は「▎AGENTS 」の 8 桁 + 件数の桁数
  printf -v pad '%*s' $((width - 1 - 8 - ${#N_AGENTS} - sumw)) ''
  frame+="${ESC}[${row};1H${C_ACTIVE}▎${C_TITLE}AGENTS ${C_DIM}${N_AGENTS}${FG_DEFAULT}${pad}${summary}${ESC}[K${C_RESET}"
}

render() {
  local shown=0 i rule

  # term_h = 端末の全高。height = Agent 一覧に使える高さ(下部の USAGE 欄を除く)
  if ((size_dirty)); then
    read -r term_h width < <(stty size 2>/dev/null)
    term_h=${term_h:-24}
    width=${width:-32}
    size_dirty=0
  fi
  build_footer
  height=$((term_h - footer_rows))

  frame=""
  row=0
  ROW_AGENT=()
  # カード中身の桁数(左の縁 1 + 空白 1 + 中身 + 右の縁 1 + 右端の余白 1)と、選択罫線の横線の長さ
  CARD_INNER=$((width - 4))
  printf -v BORDER_FILL '%*s' $((width - 3)) ''
  BORDER_FILL=${BORDER_FILL// /─}

  put_title_row
  # 2 行目は罫線。sidebar にフォーカスがあるときは操作ヒントに切り替える(フォーカス状態の目印にもなる)
  if [ "$FOCUSED" = 1 ] && ((width >= 28)); then
    # 色指定を含むため、表示幅で切り詰める put は通さず直接積む(ヒントの文字数 + 1 以上の幅があるときだけ出す。最長は通常の 27 桁)
    if ((row < height)); then
      row=$((row + 1))
      ROW_AGENT[row]=""
      # キーが増えたので、ヒントは主なものだけにして、全部は ? のヘルプ(show_help)に出す
      if [ "$COCKPIT" = 1 ]; then
        frame+="${ESC}[${row};1H${C_DIM} ${C_ACTIVE}j/k${C_DIM} move  ${C_ACTIVE}⏎${C_DIM} focus  ${C_ACTIVE}?${C_DIM} help${ESC}[K${C_RESET}"
      else
        frame+="${ESC}[${row};1H${C_DIM} ${C_ACTIVE}j/k${C_DIM} select  ${C_ACTIVE}⏎${C_DIM} jump  ${C_ACTIVE}?${C_DIM} help${ESC}[K${C_RESET}"
      fi
    fi
  else
    # BSD tr はマルチバイトを扱えないため、罫線は bash の置換で作る
    printf -v rule '%*s' $((width - 2)) ''
    put "$C_RULE" " ${rule// /─}"
  fi
  put "" ""

  if ((AG_N == 0)); then
    put "$C_DIM" "  No agents running"
  else
    # 選択中の Agent が必ず見えるように、表示開始位置をずらす
    ((SEL_IDX < TOP_IDX)) && TOP_IDX=$SEL_IDX
    ((TOP_IDX >= AG_N)) && TOP_IDX=$((AG_N - 1))
    # 画面が広がって余裕ができたら、末尾まで見える範囲で表示開始位置を先頭側へ戻す
    while ((TOP_IDX > 0)); do
      compute_fit $((TOP_IDX - 1))
      ((TOP_IDX - 1 + FIT >= AG_N)) || break
      TOP_IDX=$((TOP_IDX - 1))
    done
    compute_fit "$TOP_IDX"
    while ((SEL_IDX >= TOP_IDX + FIT)); do
      TOP_IDX=$((TOP_IDX + 1))
      compute_fit "$TOP_IDX"
    done

    for ((i = TOP_IDX; i < AG_N && shown < FIT; i++)); do
      if ((shown == 0)); then
        put_group_header "$i"
        put_sep "" "$i"
      elif [ "${AG_RKEY[i]}" != "${AG_RKEY[i - 1]}" ]; then
        # 別のリポジトリ: 前のリポジトリの閉じの区切り → 見出し → 区切り
        put_sep "$((i - 1))" ""
        put_group_header "$i"
        put_sep "" "$i"
      else
        put_sep "$((i - 1))" "$i"
      fi
      put_agent "$i"
      shown=$((shown + 1))
    done
    # 最後の window の閉じの区切り(最後のカードが選択中なら下辺の罫線になる)
    put_sep "$((i - 1))" ""

    ((AG_N > shown)) && put "$C_DIM" " +$((AG_N - shown)) more"
  fi

  # 描画済み範囲より下を消してから 1 回の write で出す（ちらつき防止）
  # （最終行まで使い切った場合に打つと、カーソルが最終行に丸められてその行を消してしまう）
  ((row < height)) && frame+="${ESC}[$((row + 1));1H${ESC}[J"
  # 下部欄は消去の後に描く(消去が下部欄にかからないように)
  frame+=$FOOTER_FRAME
  printf '%s' "$frame"
}

# --- 入力・操作 ---------------------------------------------------------------

AG_N=0
MAIN_PANES=-1
FOCUSED=0
SEL_IDX=0
SEL_KEY=""
TOP_IDX=0
FIT=1
N_WORK=0
N_WAIT=0
N_DONE=0
N_AGENTS=0
size_dirty=1
term_h=24
footer_rows=0
FOOTER_FRAME=""

# collect の出力を AG_* 配列へ展開し、選択位置を（pane_id|type をキーに）引き継ぐ
# AG_* 配列の名前(並べ替えで一括して入れ替えるため、一覧にしておく)
AG_ARRAYS="AG_SESS AG_WIN AG_WNAME AG_PANE AG_TYPE AG_ID AG_ACT AG_PROJ AG_STATUS AG_DETAIL AG_ELAPSED AG_TITLE AG_DIR AG_BRANCH AG_ROWS AG_REPO AG_RKEY AG_WT"

# 並べ替え: リポジトリ(そのリポジトリの Agent が居る最も若い window 番号・pane 番号の順。同じなら
# リポジトリのパス) → worktree のパス → window 番号 → pane 番号 → session。
# window・pane 番号は元の位置(cockpit に入っている Agent は元の番号)を使うので、j/k で入れ替えても並びは動かない。
# (window を並び替えたり、若い番号の window に Agent が増えたりすれば、リポジトリのまとまりごと動く)
reorder_agents() {
  local i j v kv n=$AG_N sep=$'\001' w p name k
  local idx=() keys=() old=() pos=() first=()
  ((n < 2)) && return 0
  for ((i = 0; i < n; i++)); do
    printf -v w '%05d' "${AG_WIN[i]:-0}" 2>/dev/null || w=00000
    printf -v p '%05d' "${AG_PANE[i]:-0}" 2>/dev/null || p=00000
    pos[i]="${w}${sep}${p}"
    idx[i]=$i
  done
  # 各リポジトリの先頭位置(window → pane の最小)。LC_COLLATE=C の文字列比較で、ゼロ埋めした番号の順になる
  for ((i = 0; i < n; i++)); do
    first[i]=${pos[i]}
    for ((j = 0; j < n; j++)); do
      [ "${AG_RKEY[j]}" = "${AG_RKEY[i]}" ] && [[ ${pos[j]} < ${first[i]} ]] && first[i]=${pos[j]}
    done
    keys[i]="${first[i]}${sep}${AG_RKEY[i]}${sep}${AG_WT[i]}${sep}${pos[i]}${sep}${AG_SESS[i]}"
  done
  # 件数が少ないので、安定な挿入ソートで十分
  for ((i = 1; i < n; i++)); do
    v=${idx[i]}
    kv=${keys[v]}
    j=$((i - 1))
    while ((j >= 0)) && [[ ${keys[idx[j]]} > $kv ]]; do
      idx[j + 1]=${idx[j]}
      j=$((j - 1))
    done
    idx[j + 1]=$v
  done
  for name in $AG_ARRAYS; do
    eval "old=(\"\${$name[@]}\")"
    for ((k = 0; k < n; k++)); do
      eval "$name[k]=\"\${old[idx[k]]}\""
    done
  done
}

# Agent の居ない空きシェル(type=Shell)の候補を絞る。残すのは「Agent が 1 つも居ないリポジトリ」の、先頭の 1 つだけ。
# (Agent が居るリポジトリには、普通のカードの n で新規起動できる。同じリポジトリに空きシェルが複数あっても欄は 1 つ)
# 呼び出し時点では collect の並び(session → window → pane)なので、「先頭」は若い window・pane の空きシェルになる
prune_shells() {
  local i j n=$AG_N name k=0 keep=() old=() has_real
  for ((i = 0; i < n; i++)); do
    if [ "${AG_TYPE[i]}" = Shell ]; then
      has_real=0
      for ((j = 0; j < n; j++)); do
        if [ "${AG_TYPE[j]}" != Shell ] && [ "${AG_RKEY[j]}" = "${AG_RKEY[i]}" ]; then has_real=1; break; fi
      done
      ((has_real)) && continue
      for ((j = 0; j < k; j++)); do
        [ "${AG_TYPE[keep[j]]}" = Shell ] && [ "${AG_RKEY[keep[j]]}" = "${AG_RKEY[i]}" ] && continue 2
      done
    fi
    keep[k]=$i
    k=$((k + 1))
  done
  ((k == n)) && return 0
  for name in $AG_ARRAYS; do
    eval "old=(\"\${$name[@]}\")"
    eval "$name=()"
    for ((j = 0; j < k; j++)); do
      eval "$name[j]=\"\${old[keep[j]]}\""
    done
  done
  AG_N=$k
}

parse_records() {
  local tag sess win wname pane type id act proj st det elapsed title cwd i j s e cnt
  AG_N=0
  AG_SESS=(); AG_WIN=(); AG_WNAME=(); AG_PANE=(); AG_TYPE=(); AG_ID=(); AG_ACT=(); AG_PROJ=(); AG_STATUS=(); AG_DETAIL=()
  AG_ELAPSED=(); AG_TITLE=(); AG_DIR=(); AG_BRANCH=(); AG_ROWS=(); AG_REPO=(); AG_RKEY=(); AG_WT=()
  AG_RCOUNT=()
  while IFS='|' read -r tag sess win wname pane type id act proj st det elapsed title cwd; do
    case $tag in
      M) MAIN_PANES=$sess; FOCUSED=${win:-0} ;;
      R)
        AG_SESS[AG_N]=$sess; AG_WIN[AG_N]=$win; AG_WNAME[AG_N]=$wname; AG_PANE[AG_N]=$pane; AG_TYPE[AG_N]=$type
        AG_ID[AG_N]=$id; AG_ACT[AG_N]=$act; AG_PROJ[AG_N]=$proj; AG_STATUS[AG_N]=$st; AG_DETAIL[AG_N]=$det
        AG_TITLE[AG_N]=$title
        fmt_elapsed "$elapsed"; AG_ELAPSED[AG_N]=$REPLY
        fmt_parent_dir "$cwd"; AG_DIR[AG_N]=$REPLY
        git_info_of "$cwd"
        AG_REPO[AG_N]=$GI_REPO; AG_RKEY[AG_N]=$GI_RKEY; AG_WT[AG_N]=$GI_WT; AG_BRANCH[AG_N]=$GI_BRANCH
        # 名前 / ブランチ / 状態 の 3 行。Shell(Agent の居ない空きシェル)は「新規起動」欄の 1 行
        if [ "$type" = Shell ]; then AG_ROWS[AG_N]=1; else AG_ROWS[AG_N]=3; fi
        AG_N=$((AG_N + 1))
        ;;
    esac
  done <<< "$1"

  prune_shells
  reorder_agents

  # リポジトリごとのまとまり(連続した範囲)の Agent の数を求める(見出しの右端に出す)
  i=0
  while ((i < AG_N)); do
    s=$i
    e=$i
    while ((e + 1 < AG_N)) && [ "${AG_RKEY[e + 1]}" = "${AG_RKEY[s]}" ]; do e=$((e + 1)); done
    # 見出しの件数は Agent だけ数える(空きシェルの欄は数えない。空きシェルだけのリポジトリは 0)
    cnt=0
    for ((j = s; j <= e; j++)); do
      [ "${AG_TYPE[j]}" = Shell ] || cnt=$((cnt + 1))
    done
    for ((j = s; j <= e; j++)); do
      AG_RCOUNT[j]=$cnt
    done
    i=$((e + 1))
  done

  N_WORK=0; N_WAIT=0; N_DONE=0; N_AGENTS=0
  for ((i = 0; i < AG_N; i++)); do
    [ "${AG_TYPE[i]}" = Shell ] || N_AGENTS=$((N_AGENTS + 1))
    case ${AG_STATUS[i]} in
      working) N_WORK=$((N_WORK + 1)) ;;
      waiting) N_WAIT=$((N_WAIT + 1)) ;;
      done) N_DONE=$((N_DONE + 1)) ;;
    esac
  done

  # 前回選んでいた Agent を探す。無ければ（初回など）いま見ている Agent、それも無ければ先頭
  local found=""
  for ((i = 0; i < AG_N; i++)); do
    [ "${AG_ID[i]}|${AG_TYPE[i]}" = "$SEL_KEY" ] && { found=$i; break; }
  done
  # 空きシェルで Agent を起動すると type が Shell → Claude に変わるので、見つからなければ pane_id だけで探す
  if [ -z "$found" ] && [ -n "$SEL_KEY" ]; then
    for ((i = 0; i < AG_N; i++)); do
      [ "${AG_ID[i]}" = "${SEL_KEY%%|*}" ] && { found=$i; break; }
    done
  fi
  if [ -z "$found" ]; then
    found=0
    for ((i = 0; i < AG_N; i++)); do
      [ "${AG_ACT[i]}" = 1 ] && { found=$i; break; }
    done
  fi
  SEL_IDX=$found
  ((AG_N > 0)) && SEL_KEY="${AG_ID[SEL_IDX]}|${AG_TYPE[SEL_IDX]}"
}

# 選択を $1（+1 / -1）だけ動かす
move_selection() {
  ((AG_N == 0)) && return 0
  local n=$((SEL_IDX + $1))
  ((n < 0)) && n=0
  ((n >= AG_N)) && n=$((AG_N - 1))
  SEL_IDX=$n
  SEL_KEY="${AG_ID[SEL_IDX]}|${AG_TYPE[SEL_IDX]}"
}

# 指定した Agent の window・pane へ移動する（別 session の Agent なら session も切り替える）
jump_to() {
  local i=$1 id
  id=${AG_ID[i]:-}
  [ -z "$id" ] && return 0
  [ "${AG_SESS[i]}" != "$CUR_SESS" ] && tmux switch-client -t "${AG_SESS[i]}" 2>/dev/null
  tmux select-window -t "$id" \; select-pane -t "$id" 2>/dev/null
}

# 選択中の Agent の pane をポップアップでプレビューする。
# ポップアップの中で j/k により別の Agent へ切り替えられ、Enter で移動、q で閉じる。
# 終了時にポップアップ側が書く結果ファイルから、最後に見ていた Agent を選択位置として引き継ぐ
PREVIEW_BIN="$(cd "$(dirname "$0")" && pwd)/tmux-agent-sidebar-preview"
# cockpit window(prefix + B)の sidebar のとき 1。選択した Agent の pane を右の枠へ入れる
COCKPIT=0
COCKPIT_BIN="$(cd "$(dirname "$0")" && pwd)/tmux-agent-cockpit"
RESTART_BIN="$(cd "$(dirname "$0")" && pwd)/tmux-agent-restart"
NEW_BIN="$(cd "$(dirname "$0")" && pwd)/tmux-agent-new"
WEB_BIN="$(cd "$(dirname "$0")" && pwd)/tmux-agent-web-toggle"
# tmux-agent-new が通知してきた「作ったばかりの pane」。Agent として検出されるまで探す秒数と合わせて持つ
PENDING_ID=""
PENDING_UNTIL=0
PENDING_NEW_SEC=40
cockpit_shown=""

# 「いまアクティブな pane」の Agent(▶ とシアンの名前)は、通常 2 秒ごとの収集でしか更新されない。
# フォーカスが動いた直後は、動き先が分かっているので手元で先に反映し、そのあと収集をやり直して実データで確かめる
mark_active_agent() {  # $1 = アクティブになった Agent の pane_id(空なら、どの Agent もアクティブでない)
  local i
  for ((i = 0; i < AG_N; i++)); do
    if [ -n "$1" ] && [ "${AG_ID[i]}" = "$1" ]; then AG_ACT[i]=1; else AG_ACT[i]=0; fi
  done
}

# 選択中の Agent の pane を cockpit の右の枠へ入れる(今表示中のものは先に元へ戻る)
# cockpit で、sidebar から外れた先(右の枠)の Agent を「いまアクティブ」にする。ダッシュボード中は Agent が居ないので、誰もアクティブにしない
mark_active_cockpit_pane() {
  if [ "$DAILY_VIEW" = 1 ]; then
    mark_active_agent ""
  else
    mark_active_agent "${cockpit_shown:-${AG_ID[SEL_IDX]:-}}"
  fi
}

# cockpit の sidebar が起動した最初の 1 回だけ、直前の選択に戻す。優先順位:
#   すでに枠に入っている Agent(sidebar だけを付け直したとき。枠の中身に選択を合わせる)→ 保存した選択 → 既定(いま見ている Agent、無ければ先頭)
# 保存した Agent が無くなっていれば、parse_records の既定の探し方に任せる。ダッシュボードを出していたなら、ダッシュボードに戻す
restore_cockpit_selection() {
  [ "$COCKPIT" = 1 ] || return 0
  [ "$RESTORE_DONE" = 1 ] && return 0
  RESTORE_DONE=1
  if [ -n "$cockpit_shown" ]; then
    SEL_KEY="$cockpit_shown|"   # 種別は不明。pane_id だけで探される
  elif [ -n "$opt_last_sel" ]; then
    SEL_KEY=$opt_last_sel
  fi
  if [ -z "$cockpit_shown" ] && [ "$opt_last_view" = daily ] && [ "$DAILY_VIEW" != 1 ]; then
    DAILY_VIEW=1
    "$COCKPIT_BIN" view daily >/dev/null 2>&1
  fi
}

# cockpit で、選択(とダッシュボードの表示)が変わったときだけ、tmux の option に書く。変化のないときは tmux を呼ばない
save_cockpit_selection() {
  [ "$COCKPIT" = 1 ] || return 0
  [ -n "$SEL_KEY" ] || return 0
  local view=""
  [ "$DAILY_VIEW" = 1 ] && view=daily
  [ "$SEL_KEY|$view" = "$LAST_SAVED" ] && return 0
  LAST_SAVED="$SEL_KEY|$view"
  tmux set-option -g @agent_sidebar_last_sel "$SEL_KEY" ';' set-option -g @agent_sidebar_last_view "$view" 2>/dev/null
}

# Daily ダッシュボードの表示を解除する(Agent は出さない。Agent を出すときは、続けて show が呼ばれる)
leave_daily_view() {
  [ "$DAILY_VIEW" = 1 ] || return 0
  DAILY_VIEW=0
  "$COCKPIT_BIN" view none >/dev/null 2>&1
}

cockpit_show_selected() {
  leave_daily_view
  ((AG_N > 0)) || return 0
  "$COCKPIT_BIN" show "${AG_ID[SEL_IDX]}" >/dev/null 2>&1
  cockpit_shown=${AG_ID[SEL_IDX]}
}

# ? のヘルプ(キー一覧)。ポップアップに静的に表示する(何かキーを押すと閉じる)。
# キーと説明の対応を行で追えるように、項目を 1 つおきに薄い背景で縞にして、グループの間に区切り線を入れる。
# 一覧は help_lines に 1 か所だけ持つ。キーを足したら、ここだけ直す(2 行目のヒントは主なキーだけ)。
HELP_WIDTH=58
HELP_KEY_COL=13
HELP_STRIPE_BG="${ESC}[48;5;236m"

# 1 行 = "キー|説明|補足(省略可)"。"-" は区切り線。通常の sidebar と cockpit で、効き方が違うキーは出し分ける。
# 説明は、ポップアップの幅から、キーの列を引いた表示幅に収める(日本語は 1 文字 2 桁)
help_lines() {
  if [ "$COCKPIT" = 1 ]; then
    printf '%s\n' \
      "j k ↓ ↑|選択を移動して、右の枠に表示する" \
      "⏎ l h|右の枠へフォーカス(戻るのは C-t h)" \
      "click|その Agent を右の枠に表示する" \
      "d|Daily を右の枠に出す / 戻す" \
      "q|cockpit を閉じる(Agent は元へ戻す)"
  else
    printf '%s\n' \
      "j k ↓ ↑|選択を移動して、peek も開く" \
      "wheel|選択を移動(peek は開かない)" \
      "⏎ l h|その Agent の pane へジャンプ" \
      "click|その Agent の pane へジャンプ" \
      "p Space|pane をポップアップで peek" \
      "d|Daily をポップアップで出す"
  fi
  printf '%s\n' \
    "-" \
    "n|リポジトリで Claude / Codex を新規起動|(Agent の居ない所は、空きシェルで起動)" \
    "f|Claude のセッションを複製(止めない)" \
    "R|Claude を再起動(--resume で入り直す)" \
    "r|即時更新" \
    "o|Daily Note を Obsidian で開く" \
    "c|作業の一覧を Markdown でコピー" \
    "-" \
    "C-c|sidebar を閉じる" \
    "?|このヘルプ"
}

# help_lines を整形して標準出力へ出す。
# 各行は、ポップアップの内側の幅(HELP_WIDTH - 2)より 1 桁短くする(右端の桁まで書くと、端末によっては折り返して表示が崩れるため)。
# 縞は項目ごと(補足の行も同じ項目として同じ背景)。キーと説明の列は表示幅でそろえる
# (printf の %-*s はバイト数で数えるため、↓ ↑ や日本語で合わない)
help_text() {
  local line key rest desc note i=0 inner=$((HELP_WIDTH - 3)) rest_w bg fk rule kpad dpad
  rest_w=$((inner - 2 - HELP_KEY_COL))
  printf '\n'
  while IFS= read -r line; do
    if [ "$line" = "-" ]; then
      printf -v rule '%*s' $((inner - 1)) ''
      printf ' %s%s%s\n' "$C_RULE" "${rule// /─}" "$C_RESET"
      continue
    fi
    key=${line%%|*}
    rest=${line#*|}
    desc=${rest%%|*}
    note=""
    [[ $rest == *"|"* ]] && note=${rest#*|}
    bg=""
    ((i % 2 == 1)) && bg=$HELP_STRIPE_BG
    i=$((i + 1))
    trunc "$key" "$HELP_KEY_COL"
    printf -v kpad '%*s' $((HELP_KEY_COL - TRUNC_W)) ''
    fk="${bg} ${C_ACTIVE}${REPLY}${C_RESET}${bg}${kpad} "
    trunc "$desc" "$rest_w"
    printf -v dpad '%*s' $((rest_w - TRUNC_W)) ''
    printf '%s\n' "${fk}${REPLY}${dpad}${C_RESET}"
    if [ -n "$note" ]; then
      trunc "$note" "$rest_w"
      printf -v kpad '%*s' $((HELP_KEY_COL + 2)) ''
      printf -v dpad '%*s' $((rest_w - TRUNC_W)) ''
      printf '%s\n' "${bg}${kpad}${C_DIM}${REPLY}${dpad}${C_RESET}"
    fi
  done < <(help_lines)
  printf '\n %s何かキーを押すと閉じます%s\n' "$C_DIM" "$C_RESET"
}

# ? : キー一覧をポップアップで出す。何かキーを押すと閉じる。ポップアップが閉じるまで戻らない(その間は sidebar の再描画も止まる)。
# 表示は一時ファイルを cat するだけにする(ポップアップの中で sidebar 自身を動かすと、TMUX_PANE が無い等の前提が崩れるため)
# 前回の Daily Note 更新以降の作業(Markdown の箇条書き)をクリップボードへコピーする。裏で実行する(Python の起動で sidebar を止めない)。
# 作業が無いときは、クリップボードを書き換えない。結果は display-message に出す
copy_daily_work() {
  local dir=$DAILY_DIR_RESOLVED
  (
    out=$(if [ -n "$dir" ]; then "$DAILY_BIN" --dir "$dir" --markdown; else AGENT_DAILY_NO_TMUX=1 "$DAILY_BIN" --markdown; fi 2>/dev/null)
    if [ -z "$out" ]; then
      tmux display-message "Daily: 前回の更新以降の作業はありません" 2>/dev/null
    else
      printf '%s\n' "$out" | $DAILY_CLIP_CMD
      tmux display-message "Daily: 作業 $(printf '%s\n' "$out" | grep -c $'^\t') 件をコピーしました(ノートに貼れます)" 2>/dev/null
    fi
  ) >/dev/null 2>&1 &
}

# 通常の sidebar の d: Daily ダッシュボードをポップアップで出す(何かキーを押すと閉じる)。cockpit では右の枠に出すので使わない
show_daily_popup() {
  local dir=$DAILY_DIR_RESOLVED
  tmux display-popup -E -w 72 -h 26 -b rounded -S 'fg=colour208' -T " Daily " -t "$TMUX_PANE" \
    "bash -c '\"\$0\" \${1:+--dir \"\$1\"} --color always --width 68 --height 22; printf \"\\n  any key: close\"; IFS= read -rsn1 _' '$DAILY_BIN' '$dir'" 2>/dev/null
  last_collect=-999
  size_dirty=1
  need_render=1
}

show_help() {
  local file="/tmp/tmux-agent-sidebar-help-$$.txt" lines title
  help_text > "$file"
  lines=$(wc -l < "$file")
  title=" keys "
  [ "$COCKPIT" = 1 ] && title=" keys (cockpit) "
  tmux display-popup -E -w "$HELP_WIDTH" -h $((lines + 2)) -b rounded -S 'fg=colour208' -T "$title" -t "$TMUX_PANE" \
    "bash -c 'cat $file; IFS= read -rsn1 _'" 2>/dev/null
  rm -f "$file"
  last_collect=-999
  size_dirty=1
  need_render=1
}

# ポップアップを sidebar の右隣に出すのに必要な最小幅(これ未満なら中央に大きく出す)
PREVIEW_MIN_WIDTH=40

# ポップアップが開いている間だけ有効。ポップアップが SIGUSR1 を送ってきたら、公開された添字へ選択を追従させる
PREVIEW_ACTIVE=0
PREVIEW_CUR_FILE=""
PREVIEW_LAST_CUR=-1

# SIGUSR1 のハンドラ。シグナルは取りこぼされず(ハンドラが走るまで保留される)、`wait` も即座に中断される
on_preview_poke() {
  local cur=""
  ((PREVIEW_ACTIVE)) || return 0
  [ -r "$PREVIEW_CUR_FILE" ] && read -r cur < "$PREVIEW_CUR_FILE"
  if [[ $cur =~ ^[0-9]+$ ]] && ((cur != PREVIEW_LAST_CUR && cur < AG_N)); then
    PREVIEW_LAST_CUR=$cur
    SEL_IDX=$cur
    SEL_KEY="${AG_ID[SEL_IDX]}|${AG_TYPE[SEL_IDX]}"
    render
  fi
}

open_preview() {
  local list_file="/tmp/tmux-agent-sidebar-preview-$$.tsv" result_file="/tmp/tmux-agent-sidebar-preview-$$.result"
  local cur_file="$result_file.cur"
  local i idx jumped popup_pid geo pane_right win_w pop_x pop_w
  local popup_geometry=(-w 90% -h 85%)

  ((AG_N == 0)) && return 0
  [ -x "$PREVIEW_BIN" ] || return 0

  : > "$list_file"
  for ((i = 0; i < AG_N; i++)); do
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${AG_ID[i]}" "${AG_TITLE[i]:-${AG_PROJ[i]}}" "${AG_TYPE[i]}" "${AG_STATUS[i]}" "" "${AG_REPO[i]}${AG_BRANCH[i]:+ · ${AG_BRANCH[i]}}" >> "$list_file"
  done
  rm -f "$result_file" "$cur_file"

  # sidebar の右隣に開いて、裏の sidebar の選択表示が見えるようにする(幅が足りなければ中央に大きく出す)
  geo=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_right}|#{window_width}' 2>/dev/null)
  pane_right=${geo%%|*}
  win_w=${geo#*|}
  if [[ $pane_right =~ ^[0-9]+$ && $win_w =~ ^[0-9]+$ ]]; then
    pop_x=$((pane_right + 1))
    pop_w=$((win_w - pop_x))
    ((pop_w >= PREVIEW_MIN_WIDTH)) && popup_geometry=(-x "$pop_x" -w "$pop_w" -h 95%)
  fi

  PREVIEW_CUR_FILE=$cur_file
  PREVIEW_LAST_CUR=$SEL_IDX
  PREVIEW_ACTIVE=1

  # display-popup はポップアップが閉じるまで戻ってこないので、バックグラウンドで起動する。
  # 生きている間、ポップアップ側が j/k のたびに送る SIGUSR1 で on_preview_poke が走り、裏の選択表示が追従する
  tmux display-popup -E "${popup_geometry[@]}" -b rounded -S 'fg=colour208' -t "$TMUX_PANE" \
    "'$PREVIEW_BIN' '$list_file' '$SEL_IDX' '$result_file' '$$'" &
  popup_pid=$!
  render
  # シグナルで `wait` が中断されても、ポップアップが生きている限り待ち直す
  while kill -0 "$popup_pid" 2>/dev/null; do
    wait "$popup_pid" 2>/dev/null
  done
  PREVIEW_ACTIVE=0

  if [ -r "$result_file" ]; then
    { read -r idx; read -r jumped; } < "$result_file"
    if [ -n "$idx" ] && ((idx >= 0 && idx < AG_N)); then
      SEL_IDX=$idx
      SEL_KEY="${AG_ID[SEL_IDX]}|${AG_TYPE[SEL_IDX]}"
    fi
    [ "$jumped" = jumped ] && FOCUSED=0
  fi
  rm -f "$list_file" "$result_file" "$cur_file"
  PREVIEW_END=$SECONDS
  last_collect=-999
  size_dirty=1
}

# 選択中の Claude Code を再起動する(tmux-agent-restart に任せる)。
# 作業中・許可待ちのときは中断されるので、tmux の確認プロンプト(y/n)を挟む。結果は display-message に出る
restart_selected() {
  local i=$SEL_IDX id name
  ((AG_N > 0)) || return 0
  id=${AG_ID[i]}
  if [ "${AG_TYPE[i]}" = Shell ]; then
    tmux display-message "restart: Agent が起動していません(n で新規起動)" 2>/dev/null
    return 0
  fi
  if [ "${AG_TYPE[i]}" != Claude ]; then
    tmux display-message "restart: ${AG_TYPE[i]} の再起動は未対応です" 2>/dev/null
    return 0
  fi
  case ${AG_STATUS[i]} in
    working | waiting)
      name=${AG_TITLE[i]:-${AG_PROJ[i]}}
      # プロンプトの文字列は書式として展開されるので、# は二重にする
      tmux confirm-before -p "${name//\#/##} は ${AG_STATUS[i]} です。中断して再起動しますか? (y/n)" \
        "run-shell -b \"'$RESTART_BIN' '$id'\"" 2>/dev/null
      ;;
    *)
      "$RESTART_BIN" "$id" >/dev/null 2>&1 &
      ;;
  esac
}

# 選択中の Claude Code のセッションを複製して、新しい pane で開く(tmux-agent-restart --fork に任せる)。
# 「別のセッションで質問・調査したい。元の Agent は作業を続けたまま」という用途なので、止めない・確認も挟まない。
# 複製は元の会話を引き継ぐ新しいセッションで、元のセッションには影響しない。移動 / cockpit の枠への入れ方は n と同じ
fork_selected() {
  local i=$SEL_IDX mode
  ((AG_N > 0)) || return 0
  case ${AG_TYPE[i]} in
    Claude) ;;
    Shell) tmux display-message "fork: Agent が起動していません(n で新規起動)" 2>/dev/null; return 0 ;;
    *) tmux display-message "fork: ${AG_TYPE[i]} の複製は未対応です" 2>/dev/null; return 0 ;;
  esac
  if [ "$COCKPIT" = 1 ]; then mode="--notify '$TMUX_PANE'"; else mode="--focus"; fi
  tmux run-shell -b "'$RESTART_BIN' '${AG_ID[i]}' --fork $mode" 2>/dev/null
}

# 選択中のカードのリポジトリで、新しい pane を作って Claude Code / Codex を新規セッションで起動する(メニューで種別を選ぶ)。
# 置き場所は、そのリポジトリの先頭に表示されている Agent の window(cockpit の枠に入っていれば元の window)。
# ディレクトリはリポジトリの本体(worktree でも大本のディレクトリ)。実際の処理は tmux-agent-new
new_agent_menu() {
  ((AG_N > 0)) || return 0
  local s=$SEL_IDX dir anchor repo mode here=""
  while ((s > 0)) && [ "${AG_RKEY[s - 1]}" = "${AG_RKEY[SEL_IDX]}" ]; do s=$((s - 1)); done
  anchor=${AG_ID[s]}
  dir=${AG_RKEY[SEL_IDX]}
  repo=${AG_REPO[SEL_IDX]}
  # 空きシェルの欄: その pane のシェルへそのまま入力して起動する(pane を分割しない。cwd はシェルの今の場所)
  if [ "${AG_TYPE[SEL_IDX]}" = Shell ]; then
    anchor=${AG_ID[SEL_IDX]}
    dir=${AG_WT[SEL_IDX]}
    here=" --here"
  fi
  if [ ! -d "$dir" ]; then
    tmux display-message "new: ディレクトリがありません ($dir)" 2>/dev/null
    return 0
  fi
  # パスは tmux のコマンド文字列に埋め込むので、引用符・展開に使う文字を含むものは扱わない
  case $dir in
    *[\'\"\\\$\`\#]* | *$'\n'*)
      tmux display-message "new: このパスは扱えません ($dir)" 2>/dev/null
      return 0
      ;;
  esac
  if [ "$COCKPIT" = 1 ]; then mode="--notify '$TMUX_PANE'"; else mode="--focus"; fi
  tmux display-menu -T "New agent: ${repo//\#/##}" -x C -y C \
    "Claude" c "run-shell -b \"'$NEW_BIN' claude '$anchor' '$dir' $mode$here\"" \
    "Codex" x "run-shell -b \"'$NEW_BIN' codex '$anchor' '$dir' $mode$here\"" 2>/dev/null
}

# cockpit で、新規に作った Agent が検出されたら選択して枠へ入れる。検出まで数秒かかるので、一定時間は探し続ける
select_pending_agent() {
  local i
  for ((i = 0; i < AG_N; i++)); do
    if [ "${AG_ID[i]}" = "$PENDING_ID" ]; then
      SEL_IDX=$i
      SEL_KEY="${AG_ID[i]}|${AG_TYPE[i]}"
      PENDING_ID=""
      [ "$COCKPIT" = 1 ] && cockpit_show_selected
      return 0
    fi
  done
  ((SECONDS >= PENDING_UNTIL)) && PENDING_ID=""
  return 0
}

# 端末が消えると read が待たずに即失敗し、ループが CPU を使い切る(pane が閉じたのに残った sidebar が 99% で居座った)。
# bash 3.2 は、タイムアウトも EOF も終了ステータスが 1 で区別できない。通常のタイムアウトは 1 秒に高々 2 回なので、
# 同じ秒のうちに READ_FAIL_MAX 回を超えて失敗したら、端末が無いとみなして終了する
READ_FAIL_MAX=20
READ_FAIL_SEC=-1
READ_FAIL_N=0
note_read_failure() {
  if [ "$SECONDS" = "$READ_FAIL_SEC" ]; then
    ((++READ_FAIL_N > READ_FAIL_MAX)) && { EXIT_REASON=read_failures; exit 0; }
  else
    READ_FAIL_SEC=$SECONDS
    READ_FAIL_N=1
  fi
  return 0
}

# 入力を 1 件読み、KEY に up / down / enter / refresh / click / other を、
# クリックなら CLICK_ROW に行番号を入れる。タイムアウト時は KEY が空になる
read_key() {
  local c seq="" params b y final
  KEY=""
  IFS= read -rsn1 -t "$TICK" c || { note_read_failure; return 0; }

  case $c in
    j) KEY=down ;;
    k) KEY=up ;;
    r) KEY=refresh ;;
    R) KEY=restart ;;
    f) KEY=fork ;;
    n) KEY=new ;;
    o) KEY=daily_open ;;
    d) KEY=daily_view ;;
    c) KEY=daily_copy ;;
    w) KEY=web_toggle ;;
    W) KEY=web_copy ;;
    q) KEY=quit ;;
    p | " ") KEY=preview ;;
    "?") KEY=help ;;
    # l / h も Enter と同じ(cockpit では右の枠へフォーカス、通常は Agent へ移動)
    "" | l | h) KEY=enter ;;
    $'\033')
      # ESC 単体は other。CSI / SS3（矢印キー・マウス報告）は終端バイト（@-~）まで読む
      IFS= read -rsn1 -t 1 c || { KEY=other; return 0; }
      [ "$c" = "[" ] || [ "$c" = "O" ] || { KEY=other; return 0; }
      while IFS= read -rsn1 -t 1 c; do
        seq+=$c
        case $c in [@-~]) break ;; esac
      done
      final=${seq: -1}
      case $seq in
        A) KEY=up ;;
        B) KEY=down ;;
        I) KEY=focus_in ;;
        O) KEY=focus_out ;;
        "<"*[Mm])
          # SGR マウス報告: <ボタン;列;行 + M(押下) / m(解放)
          params=${seq#<}
          params=${params%[Mm]}
          b=${params%%;*}
          y=${params##*;}
          if [ "$final" = "M" ]; then
            case $b in
              0) KEY=click; CLICK_ROW=$y ;;
              64) KEY=wheel_up ;;
              65) KEY=wheel_down ;;
            esac
          fi
          ;;
        *) KEY=other ;;
      esac
      ;;
    *) KEY=other ;;
  esac
}

# --- メイン ---------------------------------------------------------------

# 本体は関数に包む。bash はスクリプトを読み進めながら実行するので、起動中にファイルを書き換えると、
# 壊れた位置から読み続けて暴走する(SIGTERM でも止まらないまま CPU を使い切った実例がある)。
# 関数は定義全体を先に読み込むため、起動後に書き換えられても、動いているプロセスは影響を受けない
# (インデントは差分を小さくするため、あえて付けていない)
main() {

SESSION_ID=$(tmux display-message -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null) || exit 1
CUR_SESS=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null)

# 自分自身を sidebar として識別させる（起動経路に依らず Agent 検出対象から外れる）
tmux set-option -p -t "$TMUX_PANE" @agent_sidebar 1
# 下端のボーダーには git 情報等の pane 用表示が出るため、sidebar では固定文字にする
tmux set-option -p -t "$TMUX_PANE" pane-border-format ' agent sidebar ' 2>/dev/null

# TUI では stderr が画面を壊すだけなので捨てる（調査時は環境変数で戻せる）
[ -z "${AGENT_SIDEBAR_DEBUG:-}" ] && exec 2>/dev/null

trap 'EXIT_REASON=SIGINT; exit 0' INT
trap 'EXIT_REASON=SIGTERM; exit 0' TERM
trap 'EXIT_REASON=SIGHUP; exit 0' HUP
trap cleanup EXIT
life_log "START"
resized=0
trap 'resized=1' WINCH
trap on_preview_poke USR1

stty -echo 2>/dev/null
# 代替画面 + カーソル非表示 + マウス報告（押下/ホイールを SGR 形式で受け取る）
# + フォーカスイベント(この pane がアクティブになった/外れたときに ESC[I / ESC[O が届く)
printf '%s' "${ESC}[?1049h${ESC}[?25l${ESC}[?1000h${ESC}[?1006h${ESC}[?1004h"

# 入力待ちの 1 回あたりの最大待ち時間。データ更新は INTERVAL 秒ごと、キー入力・リサイズはこの間隔内に反応する
TICK=1
load_type_icons
# cockpit の sidebar なら、前回の戻し忘れ(Agent が枠に入ったまま、等)を直してから始める
[ "$(tmux display-message -p -t "$TMUX_PANE" '#{@agent_cockpit}' 2>/dev/null)" = 1 ] && "$COCKPIT_BIN" heal >/dev/null 2>&1
SCOPE_ALL=0
opts=""
opt_scope=""
opt_type_icon=""
opt_passthrough=""
opt_cockpit=""
new_pane=""
AUTO_PREVIEW=key
# ポップアップを閉じた時刻(SECONDS)。閉じた直後に届きうるフォーカスイベントで再び開かないための目安
PREVIEW_END=-999
last_collect=-999
need_render=1
KEY=""
CLICK_ROW=0

while :; do
  if ((SECONDS - last_collect >= INTERVAL)); then
    # option は 1 回の tmux 呼び出しでまとめて読む（scope | icons | auto_preview）
    opts=$(tmux display-message -p -t "$TMUX_PANE" '#{@agent_sidebar_scope}|#{@agent_sidebar_icons}|#{@agent_sidebar_auto_preview}|#{@agent_sidebar_type_icon}|#{allow-passthrough}|#{@agent_cockpit}|#{@agent_cockpit_shown}|#{@agent_new_pane}|#{@agent_cockpit_view}|#{@agent_sidebar_daily_blink}|#{@agent_sidebar_last_sel}|#{@agent_sidebar_last_view}|#{@agent_sidebar_daily_dir}' 2>/dev/null)
    IFS='|' read -r opt_scope ICON_STYLE AUTO_PREVIEW opt_type_icon opt_passthrough opt_cockpit cockpit_shown new_pane opt_view opt_daily_blink opt_last_sel opt_last_view opt_daily_dir <<< "$opts"
    [ "$opt_cockpit" = 1 ] && COCKPIT=1 || COCKPIT=0
    [ "$COCKPIT" = 1 ] && [ "$opt_view" = daily ] && DAILY_VIEW=1 || DAILY_VIEW=0
    [ "$opt_scope" = "all" ] && SCOPE_ALL=1 || SCOPE_ALL=0
    [ -z "$AUTO_PREVIEW" ] && AUTO_PREVIEW=key
    apply_icon_style
    # 画像表示は、設定が image で、パススルーが有効で、アイコンが読めたときだけ
    if [ "$opt_type_icon" = image ] && [ -n "$opt_passthrough" ] && [ "$opt_passthrough" != off ] \
      && { [ -n "$KITTY_B64_CLAUDE" ] || [ -n "$KITTY_B64_CODEX" ]; }; then
      TYPE_ICON_MODE=image
    else
      TYPE_ICON_MODE=text
    fi

    records=$(collect)
    # tmux が応答しない（server 終了）場合は終了する
    [ -z "$records" ] && { EXIT_REASON=collect_empty; exit 0; }
    restore_cockpit_selection
    parse_records "$records"
    if [ -n "$new_pane" ]; then
      tmux set-option -pu -t "$TMUX_PANE" @agent_new_pane 2>/dev/null
      PENDING_ID=$new_pane
      PENDING_UNTIL=$((SECONDS + PENDING_NEW_SEC))
    fi
    [ -n "$PENDING_ID" ] && select_pending_agent
    read_limits
    read_credits
    read_codex_usage
    read_daily
    # main pane が全て閉じて sidebar だけが残った window は、window ごと閉じる。
    # cockpit では、枠に入っていた Agent が終了しただけのことがあるので、交換用の枠を戻してから判断する
    if [ "$MAIN_PANES" = "0" ]; then
      if [ "$COCKPIT" = 1 ]; then
        "$COCKPIT_BIN" heal >/dev/null 2>&1
        [ "$(tmux list-panes -t "$TMUX_PANE" -F '#{@agent_sidebar}' 2>/dev/null | grep -vc 1)" -gt 0 ] || { EXIT_REASON=cockpit_no_main_panes; exit 0; }
        last_collect=-999
      else
        EXIT_REASON=no_main_panes
        exit 0
      fi
    fi

    # cockpit で、まだ何も枠に入っていなければ、選択中の Agent を入れる(開いた直後)
    if [ "$COCKPIT" = 1 ] && [ -z "$cockpit_shown" ] && [ "$DAILY_VIEW" != 1 ]; then
      cockpit_show_selected
    fi

    last_collect=$SECONDS
    need_render=1

    # 画像モードなら、アイコンを端末へ登録する(初回と、KITTY_RESEND_SEC 秒ごと)
    if [ "$TYPE_ICON_MODE" = image ] && ((SECONDS - KITTY_SENT_AT >= KITTY_RESEND_SEC)); then
      [ -n "$KITTY_B64_CLAUDE" ] && kitty_send_image "$KITTY_ID_CLAUDE" "$KITTY_B64_CLAUDE"
      [ -n "$KITTY_B64_CODEX" ] && kitty_send_image "$KITTY_ID_CODEX" "$KITTY_B64_CODEX"
      KITTY_SENT_AT=$SECONDS
    fi
  fi

  if ((resized)); then
    resized=0
    size_dirty=1
    need_render=1
  fi

  # WEB 欄の ON/OFF が変わったときだけ再描画する(w で入り切りした直後も、収集(2 秒ごと)を待たずに反映される)
  read_web_state && need_render=1
  save_cockpit_selection

  if ((need_render)); then
    render
    need_render=0
  fi

  read_key
  # 入力が無かった tick でも、working の Agent がいればスピナーを進めるために再描画する
  [ -z "$KEY" ] && { ((N_WORK > 0)) || daily_blinking; } && need_render=1
  case $KEY in
    down | up | wheel_down | wheel_up)
      # 入力が届いた時点でこの pane にフォーカスがあるので、選択のハイライトを出す
      FOCUSED=1
      case $KEY in
        down | wheel_down) move_selection 1 ;;
        *) move_selection -1 ;;
      esac
      need_render=1
      if [ "$COCKPIT" = 1 ]; then
        # cockpit では、選択した Agent の本物の pane を右の枠へ入れる(ポップアップは使わない)。
        # 入れ替え(tmux の呼び出し)を待たず、先に選択の罫線を動かしてから入れ替える
        render
        need_render=0
        cockpit_show_selected
      # j/k(矢印)ではそのままプレビューを開く。ホイールは誤操作しやすいので選択を動かすだけ
      elif [ "$AUTO_PREVIEW" != off ] && [[ $KEY == down || $KEY == up ]]; then
        render
        open_preview
        need_render=1
      fi
      ;;
    focus_in)
      # sidebar がアクティブになったら(focus モードなら)プレビューを開く。
      # 閉じた直後に届くイベントで開き直さないよう、直後は無視する
      FOCUSED=1
      need_render=1
      # cockpit では、sidebar がアクティブ = どの Agent もアクティブではない
      [ "$COCKPIT" = 1 ] && mark_active_agent ""
      last_collect=-999
      if [ "$AUTO_PREVIEW" = focus ] && [ "$COCKPIT" != 1 ] && ((SECONDS - PREVIEW_END >= 2)); then
        render
        open_preview
      fi
      ;;
    focus_out)
      FOCUSED=0
      need_render=1
      # cockpit では、sidebar から外れた先は右の枠(表示中の Agent)
      [ "$COCKPIT" = 1 ] && mark_active_cockpit_pane
      last_collect=-999
      ;;
    enter)
      if [ "$COCKPIT" = 1 ] && [ "$DAILY_VIEW" = 1 ]; then
        # ダッシュボード(Daily)を出している間の Enter は、Daily Note を開く(右の枠は操作する pane ではないため)
        "$DAILY_OPEN_CMD" "$DAILY_URL" >/dev/null 2>&1 &
      elif [ "$COCKPIT" = 1 ]; then
        # cockpit: 右の枠(Agent の pane)へフォーカスを移す。戻るのは prefix + h
        tmux select-pane -R -t "$TMUX_PANE" 2>/dev/null
        FOCUSED=0
        # 右の枠(表示中の Agent)がアクティブになった。収集を待たずにすぐ反映する
        mark_active_cockpit_pane
        render
        need_render=0
        last_collect=-999
      else
        jump_to "$SEL_IDX"
        FOCUSED=0
        last_collect=-999
      fi
      ;;
    click)
      idx=${ROW_AGENT[CLICK_ROW]:-}
      if [ -n "$idx" ]; then
        SEL_IDX=$idx
        SEL_KEY="${AG_ID[idx]}|${AG_TYPE[idx]}"
        if [ "$COCKPIT" = 1 ]; then
          # 先に罫線を動かしてから入れ替える
          render
          need_render=0
          cockpit_show_selected
        else
          jump_to "$idx"
          FOCUSED=0
          last_collect=-999
        fi
      fi
      ;;
    refresh)
      last_collect=-999
      ;;
    restart)
      restart_selected
      ;;
    new)
      new_agent_menu
      ;;
    fork)
      fork_selected
      ;;
    # スマホ用 Web サーバーの入り切り / URL のコピー。起動の待ち(最大 5 秒)で sidebar を止めないよう、裏で実行する。
    # 状態は毎 tick の read_web_state が拾うので、ON/OFF の表示は 1 秒ほどで変わる
    web_toggle)
      "$WEB_BIN" toggle --notify >/dev/null 2>&1 &
      ;;
    web_copy)
      "$WEB_BIN" copy --notify >/dev/null 2>&1 &
      ;;
    # Obsidian の Daily Note を開く(cron の通知の -open と同じ URL)。open の起動で sidebar を止めないよう、裏で実行する
    daily_open)
      "$DAILY_OPEN_CMD" "$DAILY_URL" >/dev/null 2>&1 &
      ;;
    # Daily ダッシュボード。cockpit では右の枠に出す / 戻す(Agent は元へ戻る。戻すときは選択中の Agent を出す)。通常の sidebar ではポップアップ
    daily_view)
      FOCUSED=1
      if [ "$COCKPIT" != 1 ]; then
        show_daily_popup
      elif [ "$DAILY_VIEW" = 1 ]; then
        render
        need_render=0
        cockpit_show_selected
      else
        DAILY_VIEW=1
        cockpit_shown=""
        mark_active_agent ""
        render
        need_render=0
        "$COCKPIT_BIN" view daily >/dev/null 2>&1
      fi
      need_render=1
      ;;
    daily_copy)
      copy_daily_work
      ;;
    quit)
      # cockpit の sidebar では、q で cockpit を閉じる(Ctrl-C と同じ終了処理: Agent を元へ戻し、交換用の枠も消して window ごと閉じる)。
      # 通常の sidebar では何もしない(閉じるのは Ctrl-C)
      [ "$COCKPIT" = 1 ] && { EXIT_REASON=quit_key; exit 0; }
      ;;
    help)
      show_help
      ;;
    preview)
      # cockpit では右の枠で本物の pane が見えるので、ポップアップは使わない
      if [ "$COCKPIT" != 1 ]; then
        FOCUSED=1
        open_preview
        need_render=1
      fi
      ;;
  esac
done

}

# main と exit は必ず 1 行にする。別の行にすると、main から戻ったあとに「書き換え後のファイルの途中」を読んで暴走する
main "$@"; exit $?
