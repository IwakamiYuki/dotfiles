DAILY_CHECKED_AT=-999

# 入り切りは w(tmux-agent-web-toggle)。USAGE 欄の下の 1 行(WEB 欄)に出す
WEB_STATE_FILE="${TMUX_AGENT_WEB_STATE:-${XDG_CACHE_HOME:-$HOME/.cache}/tmux-agent-web/state.json}"
WEB_ON=0
