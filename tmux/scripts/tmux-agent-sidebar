#!/bin/bash

# tmux-agent-sidebar: 各 window の左側に置く「普通の pane」で動かす軽量な Agent 一覧表示。
# tmux session 内で動いている Claude Code / Codex を検出して状態を表示する。
# 起動は tmux-agent-sidebar-open 経由（C-t b / C-t c）。Ctrl-C で終了すると pane ごと閉じる。
#
# 操作（sidebar にフォーカスがあるとき）:
#   j / k / ↓ / ↑ / ホイール : 選択を移動   Enter / l / h : 選択した Agent の window・pane へジャンプ
#   マウスクリック           : クリックした Agent の window・pane へジャンプ   r : 即時更新
#   cockpit window(prefix + B)の sidebar では、j/k で選択した Agent の本物の pane が右の枠に入る(tmux-agent-cockpit)。
#                              Enter = 右の枠へフォーカス、マウスクリック = その Agent を枠に入れる(移動はしない)
#   q                        : cockpit の sidebar だけ。cockpit を閉じる(Ctrl-C と同じ)
#   p / Space                : 選択中の Agent の pane をポップアップでプレビュー
#                              （中で j/k 切り替え・Enter 移動。tmux-agent-sidebar-preview）
#   自動プレビュー(@agent_sidebar_auto_preview): key = j/k を押すとポップアップを開く(既定)、
#                              focus = さらに sidebar がアクティブになったときも開く、off = p のみ
#
# 検出方法:
#   Claude : `claude agents --json`（pid / status / cwd）。pid の祖先をたどって pane に紐付ける。
#            未読の完了(done)は tmux-claude-agents-status が書く状態ファイルを参照する。
#   Codex  : ps の引数（codex 本体、または node 経由の codex スクリプト）で検出し、祖先の pane に紐付ける。
#            状態を確実に判定する手段が無いため status は常に unknown（推測しない）。
#
# 種別(Claude / Codex)を画像で示す(@agent_sidebar_type_icon image): Kitty graphics protocol の Unicode placeholders を使う。
#   画像データは tmux のパススルー(allow-passthrough on)で端末へ一度送って登録し、カードには「画像の置き場所を示す
#   特殊な文字」を置く。画像が普通の文字として扱われるので、window 切り替えや再描画でも残像が出ない。
#   パススルーが無効・アイコンが無い・設定が text のときは、従来の文字表示のまま。
# 下部に Claude Code の 5h / 1w レートリミット使用率（tmux-rate-limits と同じ /tmp/claude-rate-limits.json）を出す。
# 表示する情報: リポジトリごとの見出し / 各カードに 名前(会話タイトル等。無ければ project)と種別・git ブランチ・状態と継続時間
#   リポジトリ: cwd の git から判定(worktree は本体の .git を指すので同じリポジトリにまとまる)。git 管理外はディレクトリ名
#   並び     : リポジトリ名 → worktree のパス → tmux の window / pane 番号(Agent の増減や cockpit での入れ替えで動かない)
#   名前     : 会話タイトル(/tmp/claude-title-<sessionId>.txt。statusline 機構が書き出す。/rename の名前もここに入る)
#              → 無ければトランスクリプトの ai-title(~/.claude/projects/*/<sessionId>.jsonl。Claude Code 自身が書く。
#                statusline が動いていないセッションでも取れる。末尾だけ読み、TITLE_CACHE_TTL 秒キャッシュ)
#              → 無ければセッション名(nameSource が derived 以外。derived は「ディレクトリ名+英数字」で情報が無い)
#              → 無ければ project(cwd 末尾)
#   継続時間 : ~/.claude/sessions/<pid>.json の statusUpdatedAt
#   ブランチ : cwd で git を呼ぶ（GIT_TTL 秒キャッシュ）
#
# 内部モデル（collect が出力する 1 行 1 Agent）:
#   R|session|window_idx|window_name|pane_idx|type|pane_id|active|project|status|detail|elapsed_sec|name|cwd
# 検出(collect)と表示(render)は、この共通レコードだけを介して分離している。
#
# macOS 標準の bash 3.2 で動く書き方にしている（連想配列・${var,,} 等は使わない）。

set -u

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
# 文字数ベースの切り詰め（${s:i:1}）を UTF-8 で正しく動かす。
# LC_COLLATE=C にしないと、case の範囲指定 [ -~] が照合順序で解釈されて ASCII 文字まで範囲外になる
unset LC_ALL
export LC_CTYPE=en_US.UTF-8 LC_COLLATE=C

INTERVAL="${AGENT_SIDEBAR_INTERVAL:-2}"
CLAUDE_BIN="${AGENT_SIDEBAR_CLAUDE_BIN:-claude}"
CLAUDE_CACHE_TTL=3
# 形式を変えたので旧版(-claude.txt)とは別名にしている（旧版の sidebar が書く古い形式と混ざらないように）
CLAUDE_CACHE_FILE="${AGENT_SIDEBAR_CLAUDE_CACHE:-/tmp/tmux-agent-sidebar-claude2.txt}"
SESSIONS_DIR="${AGENT_SIDEBAR_SESSIONS_DIR:-$HOME/.claude/sessions}"
# statusline.sh が書き出す 5h/1w の使用率とリセット時刻（tmux-rate-limits も同じファイルを読む）
RATE_LIMIT_FILE="${AGENT_SIDEBAR_RATE_LIMITS:-/tmp/claude-rate-limits.json}"
GIT_TTL=10
# トランスクリプトから拾った ai-title のキャッシュ("sessionId|title" の行)。形式は refresh_title_cache を参照
TITLE_CACHE_FILE="${AGENT_SIDEBAR_TITLE_CACHE:-/tmp/tmux-agent-sidebar-titles.txt}"
TITLE_CACHE_TTL=30
PROJECTS_DIR="${AGENT_SIDEBAR_PROJECTS_DIR:-$HOME/.claude/projects}"
# トランスクリプトは大きい(数 MB)ので、末尾のこのバイト数だけ読む。ai-title は何度も書き直されるので末尾に必ずある
TRANSCRIPT_TAIL_BYTES=300000
# tmux-claude-agents-status が書く "ppid:status:alerting" の状態ファイル（未読の完了判定に使う）
ALERT_STATE_FILE="${AGENT_SIDEBAR_ALERT_STATE:-/tmp/tmux-claude-agents-state}"

ESC=$'\033'
C_RESET="${ESC}[0m"
C_BOLD="${ESC}[1m"
C_TITLE="${ESC}[1;38;5;208m"
C_DIM="${ESC}[38;5;245m"
C_WORKING="${ESC}[38;5;226m"
C_WAITING="${ESC}[38;5;196m"
C_DONE="${ESC}[38;5;46m"
# IDLE(入力待ち)は DONE(完了・未読)と同じ緑系だが、落ち着いた緑にする。
# DONE だけ鮮やかな緑 + カードの背景の色味にして、「新しい結果がある」を IDLE と区別する
C_IDLE="${ESC}[38;5;108m"
C_UNKNOWN="${ESC}[38;5;245m"
C_ACTIVE="${ESC}[38;5;208m"
C_TITLE_ROW="${ESC}[38;5;252m"
# 2 行目に回った project(ディレクトリ名)の色。ブランチ(C_DIM)より少し明るくして、識別名として読めるようにする
C_PROJ="${ESC}[38;5;250m"
C_GROUP="${ESC}[38;5;173m"
FG_DEFAULT="${ESC}[39m"
BOLD_ON="${ESC}[1m"
BOLD_OFF="${ESC}[22m"
# Agent を「カード」に見せるための背景色（通常 / 選択中）。window-style の bg=colour233 より一段明るくする
CARD_BG="${ESC}[48;5;236m"
# 注意が必要な状態(WAITING / DONE)のカードは背景に色味を付けて、一覧の中で目に入るようにする。
# 選択中(角丸の罫線で囲む)はそれぞれ一段明るい色にする
CARD_BG_WAITING="${ESC}[48;5;52m"
# IDLE(入力待ち)と DONE(完了・未読)は、どちらも緑の色味。DONE のほうを強い緑にして、
# 「新しい結果がある」を IDLE と区別する
CARD_BG_IDLE="${ESC}[48;5;22m"
CARD_BG_DONE="${ESC}[48;5;28m"
CARD_BG_SELECTED="${ESC}[48;5;238m"
CARD_BG_WAITING_SELECTED="${ESC}[48;5;88m"
CARD_BG_IDLE_SELECTED="${ESC}[48;5;28m"
CARD_BG_DONE_SELECTED="${ESC}[48;5;34m"
# 選択中のカードを囲む罫線の色(テーマのオレンジ)
C_SELECT="${ESC}[1;38;5;208m"
# 「いま見ている pane」の Agent は、左端の ▶ と project 名をシアンの太字にする(選択のオレンジとは別の色にして混同を避ける)
C_HERE="${ESC}[1;38;5;51m"
C_RULE="${ESC}[38;5;239m"

# 状態ピルの配色（背景色 / 文字色）。status ごとに case で選ぶ
SPINNER=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)

# アイコン。Nerd Font 前提の既定(nerd)と、フォントを選ばない plain を @agent_sidebar_icons で切り替える。
# ICON_W は「アイコン + 空白」の表示幅
ICON_STYLE=nerd
ICON_BRANCH=""
ICON_DIR=""
ICON_W=0
TAB_ARROW="▶"
apply_icon_style() {
  if [ "$ICON_STYLE" = plain ]; then
    ICON_BRANCH=""
    ICON_DIR=""
    ICON_W=0
    TAB_ARROW="▶"
  else
    TAB_ARROW=$'\xee\x82\xb0'     # U+E0B0 (Powerline の右向き矢印)
    ICON_BRANCH=$'\xee\x82\xa0 '  # U+E0A0 (git branch)
    ICON_DIR=$'\xef\x81\xbb '     # U+F07B (folder)
    ICON_W=2
  fi
}
apply_icon_style

# 種別アイコン(画像)。ファイルは tmux/assets/agent-icons/{claude,codex}.png。symlink 経由で呼ばれても実体側の assets を探す
script_real=$(readlink "$0" 2>/dev/null || echo "$0")
TYPE_ICON_DIR="${AGENT_SIDEBAR_ICON_DIR:-$(cd "$(dirname "$script_real")/../assets/agent-icons" 2>/dev/null && pwd)}"
# 端末側の画像 ID(placeholder の前景色 = 256 色の番号で ID を表すので 1〜255)。他アプリと衝突しにくい大きめの値にする
KITTY_ID_CLAUDE=250
KITTY_ID_CODEX=251
KITTY_B64_CLAUDE=""
KITTY_B64_CODEX=""
TYPE_ICON_MODE=text      # text | image(画像で表示できる条件が揃っているときだけ image)
KITTY_SENT_AT=-999
KITTY_RESEND_SEC=10      # 端末の再接続などで登録が消えても戻るよう、定期的に送り直す
# Unicode placeholder: U+10EEEE + 行の結合文字 + 列の結合文字(U+0305=0, U+030D=1)。2 桁 × 1 行の画像
KITTY_PH=$'\xf4\x8e\xbb\xae'
KITTY_D0=$'\xcc\x85'
KITTY_D1=$'\xcc\x8d'

HEADER_ROWS=3
# 親ディレクトリ表示の最大文字数（これを超えると先頭を "…" で省く）
PARENT_DIR_MAX=14

if [ -z "${TMUX_PANE:-}" ]; then
  echo "tmux-agent-sidebar: tmux の pane 内で実行してください" >&2
  exit 1
fi

TIMEOUT_CMD=""
command -v gtimeout >/dev/null 2>&1 && TIMEOUT_CMD="gtimeout 5"

cleanup() {
  # cockpit の sidebar が終了するとき、枠に入っている Agent を元の位置へ戻し(戻さないと、cockpit を閉じたときに
  # Agent も終了する)、不要になった交換用の枠も消す(cockpit window ごと閉じる)
  [ "${COCKPIT:-0}" = 1 ] && "$COCKPIT_BIN" teardown >/dev/null 2>&1
  # ポップアップ中に終了した場合に備えて、プレビュー用の一時ファイルを消す
  rm -f "/tmp/tmux-agent-sidebar-preview-$$".*
  printf '%s' "${ESC}[?1004l${ESC}[?1006l${ESC}[?1000l${ESC}[?25h${ESC}[?1049l"
  stty echo 2>/dev/null
}

# --- 検出 ---------------------------------------------------------------

# `claude agents --json` は約 0.2 秒かかるため、複数 window の sidebar で共有するキャッシュを使う。
# 失敗（空応答）時は直前のキャッシュを残す。
refresh_claude_cache() {
  local now mtime json lines updates tmp
  now=$(date +%s)
  mtime=$(stat -f %m "$CLAUDE_CACHE_FILE" 2>/dev/null || echo 0)
  [ $((now - mtime)) -lt "$CLAUDE_CACHE_TTL" ] && return 0

  json=$($TIMEOUT_CMD "$CLAUDE_BIN" agents --json 2>/dev/null) || json=""
  if [ -z "$json" ]; then
    touch "$CLAUDE_CACHE_FILE" 2>/dev/null
    return 0
  fi
  # C|pid|status|waitingFor|cwd|name|sessionId
  lines=$(printf '%s' "$json" | jq -r '
    .[] | ["C", .pid, .status, (.waitingFor // ""), (.cwd // ""), (.name // ""), (.sessionId // "")]
        | map(tostring | gsub("[|\\n\\t]"; " ")) | join("|")' 2>/dev/null) || return 0
  # U|pid|statusUpdatedAt(ms)|nameSource : 全セッションぶんを jq 1 回で読む
  updates=$(jq -r 'select(.statusUpdatedAt != null) | "U|\(.pid)|\(.statusUpdatedAt)|\(.nameSource // "")"' "$SESSIONS_DIR"/*.json 2>/dev/null)
  tmp="${CLAUDE_CACHE_FILE}.$$"
  printf '%s\n%s\n' "$lines" "$updates" > "$tmp" && mv "$tmp" "$CLAUDE_CACHE_FILE"
}

# 稼働中の各セッションのトランスクリプトから最新の ai-title を拾い、TITLE_CACHE_FILE に "sessionId|title" で書く。
# TITLE_CACHE_TTL 秒に一度だけ実行する(複数の sidebar が同時に走らないよう、先に更新時刻を進める)
refresh_title_cache() {
  local now mtime tag pid st wf cwd name sid f f_ line title out="" tmp
  now=$(date +%s)
  mtime=$(stat -f %m "$TITLE_CACHE_FILE" 2>/dev/null || echo 0)
  [ $((now - mtime)) -lt "$TITLE_CACHE_TTL" ] && return 0
  touch "$TITLE_CACHE_FILE" 2>/dev/null

  while IFS='|' read -r tag pid st wf cwd name sid; do
    [ "$tag" = C ] && [ -n "$sid" ] || continue
    f=""
    # プロジェクトディレクトリ名は cwd の符号化なので、規則に頼らず sessionId で探す
    for f_ in "$PROJECTS_DIR"/*/"$sid".jsonl; do
      [ -r "$f_" ] && { f=$f_; break; }
    done
    [ -z "$f" ] && continue
    line=$(tail -c "$TRANSCRIPT_TAIL_BYTES" "$f" 2>/dev/null | grep -a '"type":"ai-title"' | tail -n 1)
    [ -z "$line" ] && continue
    title=$(printf '%s' "$line" | jq -r '(.aiTitle // "") | gsub("[|\\n\\t]"; " ")' 2>/dev/null)
    [ -n "$title" ] && out+="${sid}|${title}"$'\n'
  done < "$CLAUDE_CACHE_FILE"

  tmp="${TITLE_CACHE_FILE}.$$"
  printf '%s' "$out" > "$tmp" && mv "$tmp" "$TITLE_CACHE_FILE"
}

read -r -d '' AWK_COLLECT <<'EOF' || true
function base(p,   n, a) { n = split(p, a, "/"); return a[n] }

# 会話タイトル。statusline 機構が書くキャッシュを優先し(/rename の名前も入る)、無ければトランスクリプトの ai-title。
# 未設定の既定タイトルは出さない
function title_of(sid,   f, t) {
  if (sid == "") return ""
  f = "/tmp/claude-title-" sid ".txt"
  t = ""
  if ((getline t < f) <= 0) t = ""
  close(f)
  gsub(/[|	]/, " ", t)
  if (t == "" || t == "新しい会話") t = (sid in ai_title) ? ai_title[sid] : ""
  return (t == "新しい会話") ? "" : t
}

# pid から祖先をたどり、最初に見つかった pane_pid の pane 番号を返す
function pane_of(pid,   i) {
  for (i = 0; i < 64 && pid != "" && pid != 0 && pid != 1; i++) {
    if (pid in pane_by_pid) return pane_by_pid[pid]
    pid = ppid[pid]
  }
  return ""
}

function add(pi, type, project, status, detail, elapsed, title, cwd,   active) {
  active = (p_win_active[pi] == 1 && p_active[pi] == 1 && p_sess[pi] == cur_sess) ? 1 : 0
  n++
  rec[n] = "R|" p_sess[pi] "|" p_win[pi] "|" p_wname[pi] "|" p_pane[pi] "|" type "|" p_id[pi] "|" active "|" project "|" status "|" detail "|" elapsed "|" title "|" cwd
  skey[n] = p_sess[pi]
  nkey[n] = p_win[pi] * 100000 + p_pane[pi]
}

{
  tag = substr($0, 1, 1)
  rest = substr($0, 3)
}

# P|session|window_id|window_idx|pane_idx|pane_id|pane_pid|sidebar|win_active|pane_active|window_name|origin_widx|origin_wname|origin_pidx|path
# origin_* は、cockpit に入れられている Agent の「元の window 番号・名前・pane 番号」。あれば見出しの window と並び順をそちらにする
tag == "P" {
  split(rest, f, "|")
  np++
  p_sess[np] = f[1]; p_wid[np] = f[2]; p_win[np] = f[3]; p_pane[np] = f[4]
  p_id[np] = f[5]; p_sidebar[np] = f[7]; p_win_active[np] = f[8]; p_active[np] = f[9]; p_wname[np] = f[10]
  if (f[11] != "") { p_win[np] = f[11]; p_wname[np] = f[12]; p_pane[np] = f[13] }
  p_path[np] = rest
  sub(/^([^|]*\|){13}/, "", p_path[np])
  if (f[5] == self) { cur_sess = f[1]; self_wid = f[2]; self_focus = (f[8] == 1 && f[9] == 1) ? 1 : 0 }
  # sidebar pane 自身（と他の sidebar）は Agent 検出の対象から外す
  if (f[7] != 1) pane_by_pid[f[6]] = np
}

# S|pid ppid args...
tag == "S" {
  split(rest, g, " ")
  ppid[g[1]] = g[2]
  arg1[g[1]] = g[3]
  arg2[g[1]] = g[4]
}

# C|pid|status|waitingFor|cwd|name|sessionId  （claude agents --json のキャッシュ）
tag == "C" {
  nc++
  split(rest, f, "|")
  c_pid[nc] = f[1]; c_status[nc] = f[2]; c_wait[nc] = f[3]; c_cwd[nc] = f[4]; c_name[nc] = f[5]; c_sid[nc] = f[6]
}

# T|sessionId|title  （トランスクリプトの ai-title。refresh_title_cache が作る）
tag == "T" {
  k = index(rest, "|")
  if (k > 1) ai_title[substr(rest, 1, k - 1)] = substr(rest, k + 1)
}

# U|pid|statusUpdatedAt(ms)|nameSource
tag == "U" {
  split(rest, f, "|")
  updated_ms[f[1]] = f[2]
  name_src[f[1]] = f[3]
}

# A|ppid:status:alerting
tag == "A" {
  split(rest, f, ":")
  alerting[f[1]] = f[3]
}

END {
  # sidebar と同じ window に、sidebar 以外の pane が残っているか（0 なら呼び出し側が終了する）
  main_panes = -1
  if (self_wid != "") {
    main_panes = 0
    for (i = 1; i <= np; i++) if (p_wid[i] == self_wid && p_sidebar[i] != 1) main_panes++
  }
  # sidebar 自身が操作対象（active な window の active な pane）かどうかも渡す
  print "M|" main_panes "|" self_focus

  # --- Claude ---
  for (i = 1; i <= nc; i++) {
    pi = pane_of(c_pid[i])
    if (pi == "") continue
    st = c_status[i]
    if (st == "busy") status = "working"
    else if (st == "waiting") status = "waiting"
    else if (st == "idle") status = (alerting[ppid[c_pid[i]]] == 1) ? "done" : "idle"
    else status = "unknown"
    cwd = c_cwd[i]; if (cwd == "") cwd = p_path[pi]
    project = base(cwd)
    # 経過秒だけ渡し、表示用の整形は bash 側で行う
    elapsed = (c_pid[i] in updated_ms) ? now - int(updated_ms[c_pid[i]] / 1000) : ""
    if (elapsed != "" && elapsed < 0) elapsed = 0
    # 表示名: 会話タイトル → セッション名(derived 以外。nameSource が不明なら使わない) → 空(= project を使う)
    display = title_of(c_sid[i])
    if (display == "" && name_src[c_pid[i]] != "" && name_src[c_pid[i]] != "derived") display = c_name[i]
    add(pi, "Claude", project, status, c_wait[i], elapsed, display, cwd)
  }

  # --- Codex（status は判定手段が無いため unknown 固定） ---
  for (pid in ppid) {
    a1 = base(arg1[pid]); a2 = base(arg2[pid])
    if (!(a1 == "codex" || (a1 ~ /^node/ && a2 == "codex"))) continue
    pi = pane_of(pid)
    if (pi == "" || codex_seen[pi]) continue
    codex_seen[pi] = 1
    project = base(p_path[pi])
    add(pi, "Codex", project, "unknown", "", "", "", p_path[pi])
  }

  # session → window → pane の順に並べる（件数が少ないので単純な挿入ソート）
  for (i = 2; i <= n; i++) {
    r = rec[i]; s = skey[i]; k = nkey[i]
    for (j = i - 1; j >= 1 && (skey[j] > s || (skey[j] == s && nkey[j] > k)); j--) {
      rec[j + 1] = rec[j]; skey[j + 1] = skey[j]; nkey[j + 1] = nkey[j]
    }
    rec[j + 1] = r; skey[j + 1] = s; nkey[j + 1] = k
  }
  for (i = 1; i <= n; i++) print rec[i]
}
EOF

# 現在の session（または全 session）の Agent 一覧を共通レコードで標準出力へ出す
collect() {
  local list_args
  if [ "$SCOPE_ALL" = 1 ]; then
    list_args=(-a)
  else
    list_args=(-s -t "$SESSION_ID")
  fi

  refresh_claude_cache
  refresh_title_cache
  {
    tmux list-panes "${list_args[@]}" -F \
      '#{session_name}|#{window_id}|#{window_index}|#{pane_index}|#{pane_id}|#{pane_pid}|#{@agent_sidebar}|#{window_active}|#{pane_active}|#{window_name}|#{@agent_origin_widx}|#{@agent_origin_wname}|#{@agent_origin_pidx}|#{pane_current_path}' 2>/dev/null |
      awk '{ print "P|" $0 }'
    ps -axo pid=,ppid=,args= | awk '{ print "S|" $0 }'
    cat "$CLAUDE_CACHE_FILE" 2>/dev/null
    awk '{ print "T|" $0 }' "$TITLE_CACHE_FILE" 2>/dev/null
    awk '{ print "A|" $0 }' "$ALERT_STATE_FILE" 2>/dev/null
  } | awk -v self="$TMUX_PANE" -v now="$(date +%s)" "$AWK_COLLECT"
}

# --- 表示 ---------------------------------------------------------------

# PNG を base64 にして KITTY_B64_* に読み込む(起動時に 1 回)。無ければ空のまま
load_type_icons() {
  KITTY_B64_CLAUDE=""
  KITTY_B64_CODEX=""
  [ -r "$TYPE_ICON_DIR/claude.png" ] && KITTY_B64_CLAUDE=$(base64 < "$TYPE_ICON_DIR/claude.png" | tr -d '\n')
  [ -r "$TYPE_ICON_DIR/codex.png" ] && KITTY_B64_CODEX=$(base64 < "$TYPE_ICON_DIR/codex.png" | tr -d '\n')
}

# 画像を端末へ登録する。$1=画像 ID $2=base64。4096 バイトずつのチャンクに分け、tmux のパススルー
# (ESC P tmux ; … ESC \ で包み、中の ESC は二重にする)で送る。a=T,U=1 は「送信 + 仮想配置(placeholder 用)」、
# q=2 は端末からの応答を抑える(応答が pane の入力に混ざらないように)
kitty_send_image() {
  local id=$1 data=$2 pos=0 len=${#2} chunk more ctl out=""
  while ((pos < len)); do
    chunk=${data:pos:4096}
    pos=$((pos + 4096))
    ((pos < len)) && more=1 || more=0
    if ((pos <= 4096)); then
      ctl="a=T,f=100,i=${id},U=1,c=2,r=1,q=2,m=${more}"
    else
      ctl="m=${more}"
    fi
    out+="${ESC}Ptmux;${ESC}${ESC}_G${ctl};${chunk}${ESC}${ESC}\\${ESC}\\"
  done
  printf '%s' "$out"
}

# 種別 $1 の placeholder 文字列(2 桁)を REPLY に入れる。画像で示せない種別なら空
type_icon_cells() {
  local id
  REPLY=""
  [ "$TYPE_ICON_MODE" = image ] || return 0
  case $1 in
    Claude) [ -n "$KITTY_B64_CLAUDE" ] && id=$KITTY_ID_CLAUDE ;;
    Codex) [ -n "$KITTY_B64_CODEX" ] && id=$KITTY_ID_CODEX ;;
  esac
  [ -z "${id:-}" ] && return 0
  # 前景色(256 色の番号)が画像 ID。背景のカード色はそのまま残る
  REPLY="${ESC}[38;5;${id}m${KITTY_PH}${KITTY_D0}${KITTY_D0}${KITTY_PH}${KITTY_D0}${KITTY_D1}${FG_DEFAULT}"
}

# 1 文字の端末上の表示幅(0 / 1 / 2)を REPLY に入れる。ASCII 以外は UTF-8 のバイトからコードポイントを
# 復元して判定する。East Asian Ambiguous(’ “ — → ▶ 罫線 など)は tmux / Ghostty の既定どおり 1 桁。
# (以前は ASCII 以外を一律 2 桁と数えていたため、’ や — を含む行で右端の罫線が左へずれていた)
char_width() {
  local c=$1
  local LC_ALL=C
  local n=${#c} b1 b2 b3 b4 cp
  REPLY=1
  ((n == 1)) && return 0
  printf -v b1 '%d' "'${c:0:1}"; ((b1 < 0)) && b1=$((b1 + 256))
  printf -v b2 '%d' "'${c:1:1}"; ((b2 < 0)) && b2=$((b2 + 256))
  if ((n == 2)); then
    cp=$(((b1 & 31) << 6 | (b2 & 63)))
    ((cp >= 0x300 && cp <= 0x36F)) && REPLY=0  # 結合文字
    return 0
  elif ((n == 3)); then
    printf -v b3 '%d' "'${c:2:1}"; ((b3 < 0)) && b3=$((b3 + 256))
    cp=$(((b1 & 15) << 12 | (b2 & 63) << 6 | (b3 & 63)))
  elif ((n == 4)); then
    printf -v b3 '%d' "'${c:2:1}"; ((b3 < 0)) && b3=$((b3 + 256))
    printf -v b4 '%d' "'${c:3:1}"; ((b4 < 0)) && b4=$((b4 + 256))
    cp=$(((b1 & 7) << 18 | (b2 & 63) << 12 | (b3 & 63) << 6 | (b4 & 63)))
  else
    return 0
  fi

  if ((cp == 0x200D || (cp >= 0xFE00 && cp <= 0xFE0F))); then
    REPLY=0  # ZWJ・異体字セレクタ
  elif ((cp >= 0x1100 && cp <= 0x115F)) \
    || ((cp >= 0x2E80 && cp <= 0x303E)) \
    || ((cp >= 0x3041 && cp <= 0x33FF)) \
    || ((cp >= 0x3400 && cp <= 0x4DBF)) \
    || ((cp >= 0x4E00 && cp <= 0x9FFF)) \
    || ((cp >= 0xA000 && cp <= 0xA4CF)) \
    || ((cp >= 0xAC00 && cp <= 0xD7A3)) \
    || ((cp >= 0xF900 && cp <= 0xFAFF)) \
    || ((cp >= 0xFE30 && cp <= 0xFE6F)) \
    || ((cp >= 0xFF00 && cp <= 0xFF60)) \
    || ((cp >= 0xFFE0 && cp <= 0xFFE6)) \
    || ((cp >= 0x1F300 && cp <= 0x1F64F)) \
    || ((cp >= 0x1F680 && cp <= 0x1F6FF)) \
    || ((cp >= 0x1F900 && cp <= 0x1F9FF)) \
    || ((cp >= 0x20000 && cp <= 0x3FFFD)) \
    || ((cp == 0x2705 || cp == 0x274C || cp == 0x2728 || cp == 0x26A1 || cp == 0x2B50 || cp == 0x2B1B || cp == 0x2B1C)); then
    REPLY=2
  fi
}

# REPLY に、表示幅 $2 以内へ切り詰めた $1 を入れる。実際に使った表示幅は TRUNC_W に入る
trunc() {
  local s=$1 max=$2 out="" w=0 i c cw
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [\ -~]) cw=1 ;;
      *) char_width "$c"; cw=$REPLY ;;
    esac
    ((w + cw > max)) && break
    out+=$c
    w=$((w + cw))
  done
  REPLY=$out
  TRUNC_W=$w
}

frame=""
row=0
# いま描画中の Agent の添字（Agent 以外の行は空）と、画面の行 → Agent 添字の対応（クリック判定用）
CUR_IDX=""
ROW_AGENT=()
# 現在描画中のカードの背景色
CARD_BG_NOW=""

# put <色> <テキスト> : 1 行ぶんを画面バッファに積む（幅超過は切り詰め、画面高さ超過は捨てる）
put() {
  ((row >= height)) && return 0
  row=$((row + 1))
  ROW_AGENT[row]=$CUR_IDX
  trunc "$2" $((width - 1))
  frame+="${ESC}[${row};1H${1}${REPLY}${ESC}[K${C_RESET}"
}

# 経過秒 → "45s" / "3m" / "2h5m" / "1d3h"。REPLY に入れる（空なら空）
fmt_elapsed() {
  local sec=$1
  REPLY=""
  [ -z "$sec" ] && return 0
  if ((sec < 60)); then
    REPLY="${sec}s"
  elif ((sec < 3600)); then
    REPLY="$((sec / 60))m"
  elif ((sec < 86400)); then
    REPLY="$((sec / 3600))h$((sec % 3600 / 60))m"
  else
    REPLY="$((sec / 86400))d$((sec % 86400 / 3600))h"
  fi
}

# 親ディレクトリを ~ 短縮し、長ければ末尾側を残して "…" で省く。REPLY に入れる
fmt_parent_dir() {
  local dir=${1%/*}
  [ -z "$dir" ] && dir=/
  case $dir in
    "$HOME") dir="~" ;;
    "$HOME"/*) dir="~${dir#"$HOME"}" ;;
  esac
  ((${#dir} > PARENT_DIR_MAX)) && dir="…${dir: -$((PARENT_DIR_MAX - 1))}"
  REPLY=$dir
}

# cwd の git ブランチ（detached HEAD なら短縮 SHA）。GIT_TTL 秒キャッシュして REPLY に入れる
GIC_DIR=()
GIC_AT=()
GIC_REPO=()
GIC_RKEY=()
GIC_WT=()
GIC_BR=()
GI_REPO=""
GI_RKEY=""
GI_WT=""
GI_BRANCH=""
git_info_of() {
  local dir=$1 i n=${#GIC_DIR[@]} out top common repokey br
  GI_REPO=""; GI_RKEY=""; GI_WT=""; GI_BRANCH=""
  [ -z "$dir" ] && return 0
  for ((i = 0; i < n; i++)); do
    if [ "${GIC_DIR[i]}" = "$dir" ]; then
      if ((SECONDS - GIC_AT[i] < GIT_TTL)); then
        GI_REPO=${GIC_REPO[i]}; GI_RKEY=${GIC_RKEY[i]}; GI_WT=${GIC_WT[i]}; GI_BRANCH=${GIC_BR[i]}
        return 0
      fi
      break
    fi
  done

  # --git-common-dir は worktree でも本体の .git を指す(= 同じリポジトリにまとまる)。
  # 存在しない dir(削除済みリポジトリなど)や git 管理外では何も返らない
  out=$(git -C "$dir" rev-parse --path-format=absolute --show-toplevel --git-common-dir 2>/dev/null)
  if [ -n "$out" ]; then
    top=${out%%$'\n'*}
    common=${out#*$'\n'}
    case ${common##*/} in
      .git) repokey=${common%/.git} ;;
      *) repokey=$common ;;
    esac
    GI_REPO=${repokey##*/}
    GI_RKEY=$repokey
    GI_WT=$top
    br=$(git -C "$dir" branch --show-current 2>/dev/null)
    [ -z "$br" ] && br=$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)
    GI_BRANCH=$br
  else
    # git 管理外: ディレクトリ単位で 1 グループ
    GI_RKEY=$dir
    GI_WT=$dir
    GI_REPO=${dir##*/}
    [ "$dir" = "$HOME" ] && GI_REPO="~"
    [ -z "$GI_REPO" ] && GI_REPO="/"
  fi
  GIC_DIR[i]=$dir; GIC_AT[i]=$SECONDS
  GIC_REPO[i]=$GI_REPO; GIC_RKEY[i]=$GI_RKEY; GIC_WT[i]=$GI_WT; GIC_BR[i]=$GI_BRANCH
}

# window の見出し行（"── 6 dotfiles ────"）。scope=all のときは session 名も添える
put_group_header() {
  local i=$1 count right right_w room fill_n fill
  count=${AG_RCOUNT[i]}
  right=" ${count} "
  right_w=${#right}
  ((row >= height)) && return 0
  row=$((row + 1))
  ROW_AGENT[row]=""
  # 「── リポジトリ名 ──────── 件数」。ブランチは各カードに出す(同じリポジトリでも worktree ごとにブランチが違うため)
  room=$((width - 1 - 3 - right_w - 1))
  trunc "${AG_REPO[i]}" "$room"
  fill_n=$((width - 1 - 3 - TRUNC_W - 1 - right_w))
  # printf の幅が負だと絶対値ぶんの空白を出してしまうので、0 未満は 0 にする
  ((fill_n < 0)) && fill_n=0
  printf -v fill '%*s' "$fill_n" ''
  frame+="${ESC}[${row};1H${C_RULE}── ${C_GROUP}${BOLD_ON}${REPLY}${BOLD_OFF} ${C_RULE}${fill// /─}${FG_DEFAULT}${C_DIM}${right}${ESC}[K${C_RESET}"
}


# カードの 1 行を積む。$1=中身(ANSI 付き)。中身の右側の余りは背景で埋める。
# 左端は状態色のバー(選択中は罫線 │)、右端は選択中だけ罫線 │
card_row() {
  ((row >= height)) && return 0
  row=$((row + 1))
  ROW_AGENT[row]=$CUR_IDX
  # 右の縁は桁を指定して描く。中身の表示幅($2)の見積もりが実際とずれても、縁の位置は動かない。
  # 先に ESC[K で行末まで背景を敷き、そのあとで縁を置く(縁の右 1 桁は既定の背景に戻す)
  # ROW_TAIL があれば、最後の桁(縁の右隣)にそれを置く(cockpit のタブの矢印)。無ければその桁を既定の背景に戻す
  frame+="${ESC}[${row};1H${CARD_BG_NOW}${EDGE_L} $1${ESC}[K${ESC}[${row};$((width - 1))H${EDGE_R}${C_RESET}${ROW_TAIL:-${ESC}[K}"
}
# card_row が行末に置く文字列(通常は空)
ROW_TAIL=""

# 選択中のカードを橙の角丸罫線で囲むか。
# 通常の sidebar: sidebar にフォーカスがあるとき(カーソル)。
# cockpit: 右の枠にフォーカスがあるとき(sidebar にフォーカスがある間は、罫線ではなく橙の塗りつぶしのタブにする)
box_cursor() {
  if [ "$COCKPIT" = 1 ]; then
    [ "$FOCUSED" != 1 ]
  else
    [ "$FOCUSED" = 1 ]
  fi
}

# Agent 間・window 区切りの 1 行。直下のカードが選択中ならその上辺 ╭──╮、直上のカードが選択中なら下辺 ╰──╯、
# どちらでもなければ空行。空行を罫線に兼用するので、選択しても行数は増えない
put_sep() {
  local above=$1 below=$2
  ((row >= height)) && return 0
  row=$((row + 1))
  ROW_AGENT[row]=""
  local boxed=0
  box_cursor && boxed=1
  if ((boxed)) && [ -n "$below" ] && [ "$below" = "$SEL_IDX" ]; then
    frame+="${ESC}[${row};1H${C_SELECT}╭${BORDER_FILL}╮${C_RESET}${ESC}[K"
  elif ((boxed)) && [ -n "$above" ] && [ "$above" = "$SEL_IDX" ]; then
    frame+="${ESC}[${row};1H${C_SELECT}╰${BORDER_FILL}╯${C_RESET}${ESC}[K"
  else
    frame+="${ESC}[${row};1H${ESC}[K"
  fi
}

put_agent() {
  local i=$1
  local status=${AG_STATUS[i]} type=${AG_TYPE[i]} detail=${AG_DETAIL[i]} elapsed=${AG_ELAPSED[i]}
  local inner=$CARD_INNER color pill_bg pill_fg label name_on="" selected=0 bg_normal bg_sel
  local right right_w lw rest tw dw avail pad detail_part=""
  # cockpit の sidebar では、選択中のカードを右の枠と結ぶ。選択 = 右の枠に出ている Agent なので、
  # 罫線のカーソルと現在地の ▶ を一つにまとめ、右向きの矢印で右の枠を指す。
  # 形でフォーカス位置を示し、橙で「ここに注目」を示す:
  #   sidebar にフォーカス(選んでいる最中)  = 橙の塗りつぶしのタブ(状態色は隠れる)
  #   右の枠にフォーカス(操作している最中) = 状態色のカードを橙の角丸罫線で囲む
  local tabbed=0 tab_bg_n tab_acc_n arrow_n="" c_dim=$C_DIM c_proj=$C_PROJ c_rule=$C_RULE

  case $status in
    # 状態は左端のバーの色と状態ピルで示す。スピナーだけは working のピルの中で回す
    working) color=$C_WORKING; pill_bg=220; pill_fg=232; label="${SPINNER[SECONDS % ${#SPINNER[@]}]} WORKING"; bg_normal=$CARD_BG; bg_sel=$CARD_BG_SELECTED ;;
    waiting) color=$C_WAITING; pill_bg=196; pill_fg=255; label="WAITING"; bg_normal=$CARD_BG_WAITING; bg_sel=$CARD_BG_WAITING_SELECTED ;;
    done) color=$C_DONE; pill_bg=41; pill_fg=232; label="DONE"; bg_normal=$CARD_BG_DONE; bg_sel=$CARD_BG_DONE_SELECTED ;;
    idle) color=$C_IDLE; pill_bg=71; pill_fg=232; label="IDLE"; bg_normal=$CARD_BG_IDLE; bg_sel=$CARD_BG_IDLE_SELECTED ;;
    *) color=$C_UNKNOWN; pill_bg=240; pill_fg=252; label="UNKNOWN"; bg_normal=$CARD_BG; bg_sel=$CARD_BG_SELECTED ;;
  esac

  if [ "$i" = "$SEL_IDX" ]; then
    if box_cursor; then
      selected=1
    elif [ "$COCKPIT" = 1 ]; then
      tabbed=1
    fi
    [ "$COCKPIT" = 1 ] && arrow_n=208
  fi
  CUR_IDX=$i
  if ((tabbed)); then
    tab_bg_n=130; tab_acc_n=208; arrow_n=$tab_bg_n
    CARD_BG_NOW="${ESC}[48;5;${tab_bg_n}m"
    EDGE_L="${ESC}[38;5;${tab_acc_n}m█${C_RESET}${CARD_BG_NOW}"
    EDGE_R=" "
    # 塗りつぶしの上で読めるよう、補助の文字色を明るくする
    c_dim="${ESC}[38;5;254m"
    c_proj=$c_dim
    c_rule=$c_dim
    name_on="${BOLD_ON}${ESC}[38;5;255m"
  elif ((selected)); then
    CARD_BG_NOW=$bg_sel
    EDGE_L="${C_SELECT}│${C_RESET}${CARD_BG_NOW}"
    EDGE_R="${C_SELECT}│${C_RESET}"
  else
    CARD_BG_NOW=$bg_normal
    EDGE_L="${color}▎${FG_DEFAULT}"
    EDGE_R=" "
  fi
  # 1 行目: project ……… 種別。いま見ている pane の Agent は、左端を ▶ にして project 名をシアンの太字にする
  # (選択中は左端が罫線 │ なので ▶ にはしない)
  right="${c_dim}${type}${FG_DEFAULT}"
  right_w=${#type}
  # 種別を画像で示せるときは、左端に 2 桁の画像 + 空白を置き、右寄せの文字は出さない(project 名の幅が増える)
  local lead="" lead_w=0 gap=1
  type_icon_cells "$type"
  if [ -n "$REPLY" ]; then
    lead="$REPLY "
    lead_w=3
    right=""
    right_w=0
    gap=0
  fi
  local edge_l_saved=$EDGE_L
  # (cockpit ではタブで示すので、▶ とシアンの名前は使わない)
  if [ "${AG_ACT[i]}" = 1 ] && [ "$COCKPIT" != 1 ]; then
    name_on=$C_HERE
    ((selected)) || EDGE_L="${C_HERE}▶${C_RESET}${CARD_BG_NOW}"
  fi
  # 1 行目は名前(会話タイトル等)。無ければ project。リポジトリは見出しに出すのでカードには出さない
  trunc "${AG_TITLE[i]:-${AG_PROJ[i]}}" $((inner - lead_w - right_w - gap))
  printf -v pad '%*s' $((inner - lead_w - TRUNC_W - right_w)) ''
  card_row "${lead}${name_on}${REPLY}${BOLD_OFF}${FG_DEFAULT}${pad}${right}"
  EDGE_L=$edge_l_saved

  # 2 行目はブランチ(同じリポジトリでも worktree ごとに違う)。git 管理外は親ディレクトリ。
  # cockpit の選択中のカードは、この行(3 行の中段)の行末に、右の枠を指す矢印を置く(矢印の色 = タブの色。罫線のときは橙)
  local line=""
  if [ -n "${AG_BRANCH[i]}" ]; then
    trunc "${AG_BRANCH[i]}" $((inner - ICON_W))
    line="${c_dim}${ICON_BRANCH}${REPLY}${FG_DEFAULT}"
  else
    trunc "${AG_DIR[i]}" $((inner - ICON_W))
    line="${c_rule}${ICON_DIR}${REPLY}${FG_DEFAULT}"
  fi
  [ -n "$arrow_n" ] && ROW_TAIL="${ESC}[38;5;${arrow_n}m${TAB_ARROW}${C_RESET}"
  card_row "$line"
  ROW_TAIL=""

  # 状態ピル + 待機理由 ……… 継続時間(右寄せ)
  local pillw=$((${#label} + 2)) elw=${#elapsed}
  avail=$((inner - pillw - 1))
  ((elw > 0)) && avail=$((avail - elw - 1))
  dw=0
  if [ -n "$detail" ] && ((avail >= 4)); then
    trunc "$detail" "$avail"
    dw=$((TRUNC_W + 1))
    detail_part=" ${c_dim}${REPLY}${FG_DEFAULT}"
  fi
  printf -v pad '%*s' $((inner - pillw - dw - elw)) ''
  card_row "${ESC}[48;5;${pill_bg};38;5;${pill_fg};1m ${label} ${BOLD_OFF}${FG_DEFAULT}${CARD_BG_NOW}${detail_part}${pad}${c_dim}${elapsed}${FG_DEFAULT}"

  CUR_IDX=""
}

# --- レートリミット(下部の USAGE 欄) -------------------------------------

LIM_5H_PCT=""
LIM_5H_RESET=""
LIM_1W_PCT=""
LIM_1W_RESET=""
# 下部欄を出すのに必要な最小の端末高さ(これ未満では Agent 一覧を優先して出さない)
FOOTER_MIN_TERM_H=14

# json_field <json> <key> : 単純な "key": value を REPLY に入れる(null は空)。fork せず正規表現で読む
json_field() {
  local re="\"$2\"[[:space:]]*:[[:space:]]*\"?([^\",}[:space:]]+)"
  REPLY=""
  [[ $1 =~ $re ]] && REPLY=${BASH_REMATCH[1]}
  [ "$REPLY" = null ] && REPLY=""
  return 0
}

# リセット時刻(epoch 秒 または ISO 8601 UTC)を "2h30m" / "5d12h" / "now" 形式の残り時間にして REPLY に入れる
fmt_reset_in() {
  local at=$1 epoch="" clean diff
  REPLY=""
  [ -z "$at" ] && return 0
  if [[ $at =~ ^[0-9]+$ ]]; then
    epoch=$at
  else
    clean="${at%%.*}"
    clean="${clean%Z}"
    epoch=$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "$clean" "+%s" 2>/dev/null)
  fi
  [ -z "$epoch" ] && return 0
  diff=$((epoch - $(date +%s)))
  if ((diff <= 0)); then
    REPLY="now"
  elif ((diff >= 86400)); then
    REPLY="$((diff / 86400))d$((diff % 86400 / 3600))h"
  elif ((diff >= 3600)); then
    REPLY="$((diff / 3600))h$((diff % 3600 / 60))m"
  else
    REPLY="$((diff / 60))m"
  fi
}

read_limits() {
  local json
  LIM_5H_PCT=""; LIM_5H_RESET=""; LIM_1W_PCT=""; LIM_1W_RESET=""
  [ -r "$RATE_LIMIT_FILE" ] || return 0
  json=$(<"$RATE_LIMIT_FILE") || return 0

  json_field "$json" five_hour_pct
  [ -z "$REPLY" ] && return 0
  printf -v LIM_5H_PCT '%.0f' "$REPLY" 2>/dev/null || LIM_5H_PCT=0
  json_field "$json" five_hour_resets
  fmt_reset_in "$REPLY"
  LIM_5H_RESET=$REPLY

  json_field "$json" seven_day_pct
  if [ -n "$REPLY" ]; then
    printf -v LIM_1W_PCT '%.0f' "$REPLY" 2>/dev/null || LIM_1W_PCT=0
    json_field "$json" seven_day_resets
    fmt_reset_in "$REPLY"
    LIM_1W_RESET=$REPLY
  fi
}

# 使用率に応じた色(tmux-rate-limits と同じ段階: 低=橙系 → 80% 以上は赤)を REPLY に入れる
limit_color() {
  local pct=$1
  if ((pct < 30)); then REPLY="${ESC}[38;5;214m"
  elif ((pct < 60)); then REPLY="${ESC}[38;5;220m"
  elif ((pct < 80)); then REPLY="${ESC}[38;5;226m"
  else REPLY="${ESC}[38;5;196m"; fi
}

# limit_row <行番号> <ラベル> <使用率> <リセットまで>: "5h ████░░░░  23%  2h30m" を FOOTER_FRAME に積む
limit_row() {
  local at=$1 label=$2 pct=$3 reset=$4 bw filled filled_str empty_str rs="" color pct_str
  [ -n "$reset" ] && rs="  $reset"
  # 行の構成: 空白1 + ラベル2 + 空白1 + バー + 空白1 + 使用率4桁 + リセット + 右余白1。
  # バー幅は 5h / 1w で揃えるため、長い方のリセット表記(FOOTER_RLEN)に合わせる
  bw=$((width - 10 - FOOTER_RLEN))
  if ((bw < 4)); then
    rs=""
    bw=$((width - 10))
  fi
  ((bw > 14)) && bw=14
  ((bw < 3)) && bw=3
  ((pct > 100)) && pct=100
  filled=$((pct * bw / 100))
  ((pct > 0 && filled == 0)) && filled=1
  printf -v filled_str '%*s' "$filled" ''
  printf -v empty_str '%*s' $((bw - filled)) ''
  limit_color "$pct"
  color=$REPLY
  printf -v pct_str '%3d%%' "$pct"
  FOOTER_FRAME+="${ESC}[${at};1H ${C_DIM}${label}${FG_DEFAULT} ${color}${filled_str// /█}${C_RULE}${empty_str// /░}${FG_DEFAULT} ${color}${pct_str}${C_DIM}${rs}${FG_DEFAULT}${ESC}[K${C_RESET}"
}

# 下部欄を組み立てる。FOOTER_FRAME に描画文字列、footer_rows に使う行数を入れる
build_footer() {
  local top fill
  FOOTER_FRAME=""
  footer_rows=0
  [ -z "$LIM_5H_PCT" ] && return 0
  ((term_h < FOOTER_MIN_TERM_H)) && return 0

  footer_rows=2
  [ -n "$LIM_1W_PCT" ] && footer_rows=3
  FOOTER_RLEN=0
  [ -n "$LIM_5H_RESET" ] && FOOTER_RLEN=$((2 + ${#LIM_5H_RESET}))
  [ -n "$LIM_1W_PCT" ] && [ -n "$LIM_1W_RESET" ] && ((2 + ${#LIM_1W_RESET} > FOOTER_RLEN)) && FOOTER_RLEN=$((2 + ${#LIM_1W_RESET}))
  top=$((term_h - footer_rows + 1))

  printf -v fill '%*s' $((width - 1 - 2 - 7)) ''
  FOOTER_FRAME+="${ESC}[${top};1H${C_RULE}──${C_GROUP}${BOLD_ON} USAGE ${BOLD_OFF}${C_RULE}${fill// /─}${ESC}[K${C_RESET}"
  limit_row $((top + 1)) 5h "$LIM_5H_PCT" "$LIM_5H_RESET"
  [ -n "$LIM_1W_PCT" ] && limit_row $((top + 2)) 1w "$LIM_1W_PCT" "$LIM_1W_RESET"
}

# FIT に「top 番目から表示できる Agent 数」を入れる。
# 並び: 見出し → [区切り → カード]… → 閉じの区切り（リポジトリごと）。区切りは選択時に罫線になる。
#   各カード     : 区切り 1 + カードの行数
#   最初の Agent  : さらにリポジトリの見出し 1
#   別のリポジトリ: さらに「前のリポジトリの閉じの区切り 1 + 見出し 1」
#   最後に閉じの区切り 1 を必ず見込む
# 全件が収まらない（または先頭を省いている）ときは「+N more」の 1 行ぶんを空けて数え直す
compute_fit() {
  local top=$1 avail pass i used n need
  for pass in 1 2; do
    avail=$((height - HEADER_ROWS))
    ((pass == 2)) && avail=$((avail - 1))
    used=0
    n=0
    for ((i = top; i < AG_N; i++)); do
      need=$((${AG_ROWS[i]} + 1))
      if ((n == 0)); then
        # 先頭の Agent: リポジトリの見出し
        need=$((need + 1))
      elif [ "${AG_RKEY[i]}" != "${AG_RKEY[i - 1]}" ]; then
        # 別のリポジトリ: 前のリポジトリの閉じの区切り + 見出し
        need=$((need + 2))
      fi
      ((used + need + 1 > avail)) && break
      used=$((used + need))
      n=$((n + 1))
    done
    ((pass == 1 && top == 0 && n == AG_N)) && break
  done
  ((n < 1)) && n=1
  FIT=$n
}

# 先頭行: 「▎AGENTS ……… 状態別の件数」
put_title_row() {
  local summary="" sumw=0 pad
  ((N_WORK > 0)) && { summary+="${C_WORKING}▎${FG_DEFAULT}${N_WORK} "; sumw=$((sumw + 2 + ${#N_WORK})); }
  ((N_WAIT > 0)) && { summary+="${C_WAITING}▎${FG_DEFAULT}${N_WAIT} "; sumw=$((sumw + 2 + ${#N_WAIT})); }
  ((N_DONE > 0)) && { summary+="${C_DONE}▎${FG_DEFAULT}${N_DONE} "; sumw=$((sumw + 2 + ${#N_DONE})); }
  ((row >= height)) && return 0
  row=$((row + 1))
  ROW_AGENT[row]=""
  # 左側は「▎AGENTS 」の 8 桁 + 件数の桁数
  printf -v pad '%*s' $((width - 1 - 8 - ${#AG_N} - sumw)) ''
  frame+="${ESC}[${row};1H${C_ACTIVE}▎${C_TITLE}AGENTS ${C_DIM}${AG_N}${FG_DEFAULT}${pad}${summary}${ESC}[K${C_RESET}"
}

render() {
  local shown=0 i rule

  # term_h = 端末の全高。height = Agent 一覧に使える高さ(下部の USAGE 欄を除く)
  if ((size_dirty)); then
    read -r term_h width < <(stty size 2>/dev/null)
    term_h=${term_h:-24}
    width=${width:-32}
    size_dirty=0
  fi
  build_footer
  height=$((term_h - footer_rows))

  frame=""
  row=0
  ROW_AGENT=()
  # カード中身の桁数(左の縁 1 + 空白 1 + 中身 + 右の縁 1 + 右端の余白 1)と、選択罫線の横線の長さ
  CARD_INNER=$((width - 4))
  printf -v BORDER_FILL '%*s' $((width - 3)) ''
  BORDER_FILL=${BORDER_FILL// /─}

  put_title_row
  # 2 行目は罫線。sidebar にフォーカスがあるときは操作ヒントに切り替える(フォーカス状態の目印にもなる)
  if [ "$FOCUSED" = 1 ] && ((width >= (COCKPIT == 1 ? 31 : 30))); then
    # 色指定を含むため、表示幅で切り詰める put は通さず直接積む(ヒントの文字数 + 1 以上の幅があるときだけ出す)
    if ((row < height)); then
      row=$((row + 1))
      ROW_AGENT[row]=""
      if [ "$COCKPIT" = 1 ]; then
        frame+="${ESC}[${row};1H${C_DIM} ${C_ACTIVE}j/k${C_DIM} move  ${C_ACTIVE}⏎/l/h${C_DIM} focus  ${C_ACTIVE}q${C_DIM} quit${ESC}[K${C_RESET}"
      else
        frame+="${ESC}[${row};1H${C_DIM} ${C_ACTIVE}j/k${C_DIM} select  ${C_ACTIVE}⏎/l${C_DIM} jump  ${C_ACTIVE}p${C_DIM} peek${ESC}[K${C_RESET}"
      fi
    fi
  else
    # BSD tr はマルチバイトを扱えないため、罫線は bash の置換で作る
    printf -v rule '%*s' $((width - 2)) ''
    put "$C_RULE" " ${rule// /─}"
  fi
  put "" ""

  if ((AG_N == 0)); then
    put "$C_DIM" "  No agents running"
  else
    # 選択中の Agent が必ず見えるように、表示開始位置をずらす
    ((SEL_IDX < TOP_IDX)) && TOP_IDX=$SEL_IDX
    ((TOP_IDX >= AG_N)) && TOP_IDX=$((AG_N - 1))
    # 画面が広がって余裕ができたら、末尾まで見える範囲で表示開始位置を先頭側へ戻す
    while ((TOP_IDX > 0)); do
      compute_fit $((TOP_IDX - 1))
      ((TOP_IDX - 1 + FIT >= AG_N)) || break
      TOP_IDX=$((TOP_IDX - 1))
    done
    compute_fit "$TOP_IDX"
    while ((SEL_IDX >= TOP_IDX + FIT)); do
      TOP_IDX=$((TOP_IDX + 1))
      compute_fit "$TOP_IDX"
    done

    for ((i = TOP_IDX; i < AG_N && shown < FIT; i++)); do
      if ((shown == 0)); then
        put_group_header "$i"
        put_sep "" "$i"
      elif [ "${AG_RKEY[i]}" != "${AG_RKEY[i - 1]}" ]; then
        # 別のリポジトリ: 前のリポジトリの閉じの区切り → 見出し → 区切り
        put_sep "$((i - 1))" ""
        put_group_header "$i"
        put_sep "" "$i"
      else
        put_sep "$((i - 1))" "$i"
      fi
      put_agent "$i"
      shown=$((shown + 1))
    done
    # 最後の window の閉じの区切り(最後のカードが選択中なら下辺の罫線になる)
    put_sep "$((i - 1))" ""

    ((AG_N > shown)) && put "$C_DIM" " +$((AG_N - shown)) more"
  fi

  # 描画済み範囲より下を消してから 1 回の write で出す（ちらつき防止）
  # （最終行まで使い切った場合に打つと、カーソルが最終行に丸められてその行を消してしまう）
  ((row < height)) && frame+="${ESC}[$((row + 1));1H${ESC}[J"
  # 下部欄は消去の後に描く(消去が下部欄にかからないように)
  frame+=$FOOTER_FRAME
  printf '%s' "$frame"
}

# --- 入力・操作 ---------------------------------------------------------------

AG_N=0
MAIN_PANES=-1
FOCUSED=0
SEL_IDX=0
SEL_KEY=""
TOP_IDX=0
FIT=1
N_WORK=0
N_WAIT=0
N_DONE=0
size_dirty=1
term_h=24
footer_rows=0
FOOTER_FRAME=""

# collect の出力を AG_* 配列へ展開し、選択位置を（pane_id|type をキーに）引き継ぐ
# AG_* 配列の名前(並べ替えで一括して入れ替えるため、一覧にしておく)
AG_ARRAYS="AG_SESS AG_WIN AG_WNAME AG_PANE AG_TYPE AG_ID AG_ACT AG_PROJ AG_STATUS AG_DETAIL AG_ELAPSED AG_TITLE AG_DIR AG_BRANCH AG_ROWS AG_REPO AG_RKEY AG_WT"

# 並べ替え: リポジトリ名 → リポジトリのパス → worktree のパス → window 番号 → pane 番号 → session。
# window・pane 番号は元の位置(cockpit に入っている Agent は元の番号)を使うので、j/k で入れ替えても並びは動かない。
reorder_agents() {
  local i j v kv n=$AG_N sep=$'\001' w p name k
  local idx=() keys=() old=()
  ((n < 2)) && return 0
  for ((i = 0; i < n; i++)); do
    printf -v w '%05d' "${AG_WIN[i]:-0}" 2>/dev/null || w=00000
    printf -v p '%05d' "${AG_PANE[i]:-0}" 2>/dev/null || p=00000
    keys[i]="${AG_REPO[i]}${sep}${AG_RKEY[i]}${sep}${AG_WT[i]}${sep}${w}${sep}${p}${sep}${AG_SESS[i]}"
    idx[i]=$i
  done
  # 件数が少ないので、安定な挿入ソートで十分
  for ((i = 1; i < n; i++)); do
    v=${idx[i]}
    kv=${keys[v]}
    j=$((i - 1))
    while ((j >= 0)) && [[ ${keys[idx[j]]} > $kv ]]; do
      idx[j + 1]=${idx[j]}
      j=$((j - 1))
    done
    idx[j + 1]=$v
  done
  for name in $AG_ARRAYS; do
    eval "old=(\"\${$name[@]}\")"
    for ((k = 0; k < n; k++)); do
      eval "$name[k]=\"\${old[idx[k]]}\""
    done
  done
}

parse_records() {
  local tag sess win wname pane type id act proj st det elapsed title cwd i j s e
  AG_N=0
  AG_SESS=(); AG_WIN=(); AG_WNAME=(); AG_PANE=(); AG_TYPE=(); AG_ID=(); AG_ACT=(); AG_PROJ=(); AG_STATUS=(); AG_DETAIL=()
  AG_ELAPSED=(); AG_TITLE=(); AG_DIR=(); AG_BRANCH=(); AG_ROWS=(); AG_REPO=(); AG_RKEY=(); AG_WT=()
  AG_RCOUNT=()
  while IFS='|' read -r tag sess win wname pane type id act proj st det elapsed title cwd; do
    case $tag in
      M) MAIN_PANES=$sess; FOCUSED=${win:-0} ;;
      R)
        AG_SESS[AG_N]=$sess; AG_WIN[AG_N]=$win; AG_WNAME[AG_N]=$wname; AG_PANE[AG_N]=$pane; AG_TYPE[AG_N]=$type
        AG_ID[AG_N]=$id; AG_ACT[AG_N]=$act; AG_PROJ[AG_N]=$proj; AG_STATUS[AG_N]=$st; AG_DETAIL[AG_N]=$det
        AG_TITLE[AG_N]=$title
        fmt_elapsed "$elapsed"; AG_ELAPSED[AG_N]=$REPLY
        fmt_parent_dir "$cwd"; AG_DIR[AG_N]=$REPLY
        git_info_of "$cwd"
        AG_REPO[AG_N]=$GI_REPO; AG_RKEY[AG_N]=$GI_RKEY; AG_WT[AG_N]=$GI_WT; AG_BRANCH[AG_N]=$GI_BRANCH
        # 名前 / ブランチ / 状態 の 3 行
        AG_ROWS[AG_N]=3
        AG_N=$((AG_N + 1))
        ;;
    esac
  done <<< "$1"

  reorder_agents

  # リポジトリごとのまとまり(連続した範囲)の Agent の数を求める(見出しの右端に出す)
  i=0
  while ((i < AG_N)); do
    s=$i
    e=$i
    while ((e + 1 < AG_N)) && [ "${AG_RKEY[e + 1]}" = "${AG_RKEY[s]}" ]; do e=$((e + 1)); done
    for ((j = s; j <= e; j++)); do
      AG_RCOUNT[j]=$((e - s + 1))
    done
    i=$((e + 1))
  done

  N_WORK=0; N_WAIT=0; N_DONE=0
  for ((i = 0; i < AG_N; i++)); do
    case ${AG_STATUS[i]} in
      working) N_WORK=$((N_WORK + 1)) ;;
      waiting) N_WAIT=$((N_WAIT + 1)) ;;
      done) N_DONE=$((N_DONE + 1)) ;;
    esac
  done

  # 前回選んでいた Agent を探す。無ければ（初回など）いま見ている Agent、それも無ければ先頭
  local found=""
  for ((i = 0; i < AG_N; i++)); do
    [ "${AG_ID[i]}|${AG_TYPE[i]}" = "$SEL_KEY" ] && { found=$i; break; }
  done
  if [ -z "$found" ]; then
    found=0
    for ((i = 0; i < AG_N; i++)); do
      [ "${AG_ACT[i]}" = 1 ] && { found=$i; break; }
    done
  fi
  SEL_IDX=$found
  ((AG_N > 0)) && SEL_KEY="${AG_ID[SEL_IDX]}|${AG_TYPE[SEL_IDX]}"
}

# 選択を $1（+1 / -1）だけ動かす
move_selection() {
  ((AG_N == 0)) && return 0
  local n=$((SEL_IDX + $1))
  ((n < 0)) && n=0
  ((n >= AG_N)) && n=$((AG_N - 1))
  SEL_IDX=$n
  SEL_KEY="${AG_ID[SEL_IDX]}|${AG_TYPE[SEL_IDX]}"
}

# 指定した Agent の window・pane へ移動する（別 session の Agent なら session も切り替える）
jump_to() {
  local i=$1 id
  id=${AG_ID[i]:-}
  [ -z "$id" ] && return 0
  [ "${AG_SESS[i]}" != "$CUR_SESS" ] && tmux switch-client -t "${AG_SESS[i]}" 2>/dev/null
  tmux select-window -t "$id" \; select-pane -t "$id" 2>/dev/null
}

# 選択中の Agent の pane をポップアップでプレビューする。
# ポップアップの中で j/k により別の Agent へ切り替えられ、Enter で移動、q で閉じる。
# 終了時にポップアップ側が書く結果ファイルから、最後に見ていた Agent を選択位置として引き継ぐ
PREVIEW_BIN="$(cd "$(dirname "$0")" && pwd)/tmux-agent-sidebar-preview"
# cockpit window(prefix + B)の sidebar のとき 1。選択した Agent の pane を右の枠へ入れる
COCKPIT=0
COCKPIT_BIN="$(cd "$(dirname "$0")" && pwd)/tmux-agent-cockpit"
cockpit_shown=""

# 「いまアクティブな pane」の Agent(▶ とシアンの名前)は、通常 2 秒ごとの収集でしか更新されない。
# フォーカスが動いた直後は、動き先が分かっているので手元で先に反映し、そのあと収集をやり直して実データで確かめる
mark_active_agent() {  # $1 = アクティブになった Agent の pane_id(空なら、どの Agent もアクティブでない)
  local i
  for ((i = 0; i < AG_N; i++)); do
    if [ -n "$1" ] && [ "${AG_ID[i]}" = "$1" ]; then AG_ACT[i]=1; else AG_ACT[i]=0; fi
  done
}

# 選択中の Agent の pane を cockpit の右の枠へ入れる(今表示中のものは先に元へ戻る)
cockpit_show_selected() {
  ((AG_N > 0)) || return 0
  "$COCKPIT_BIN" show "${AG_ID[SEL_IDX]}" >/dev/null 2>&1
  cockpit_shown=${AG_ID[SEL_IDX]}
}

# ポップアップを sidebar の右隣に出すのに必要な最小幅(これ未満なら中央に大きく出す)
PREVIEW_MIN_WIDTH=40

# ポップアップが開いている間だけ有効。ポップアップが SIGUSR1 を送ってきたら、公開された添字へ選択を追従させる
PREVIEW_ACTIVE=0
PREVIEW_CUR_FILE=""
PREVIEW_LAST_CUR=-1

# SIGUSR1 のハンドラ。シグナルは取りこぼされず(ハンドラが走るまで保留される)、`wait` も即座に中断される
on_preview_poke() {
  local cur=""
  ((PREVIEW_ACTIVE)) || return 0
  [ -r "$PREVIEW_CUR_FILE" ] && read -r cur < "$PREVIEW_CUR_FILE"
  if [[ $cur =~ ^[0-9]+$ ]] && ((cur != PREVIEW_LAST_CUR && cur < AG_N)); then
    PREVIEW_LAST_CUR=$cur
    SEL_IDX=$cur
    SEL_KEY="${AG_ID[SEL_IDX]}|${AG_TYPE[SEL_IDX]}"
    render
  fi
}

open_preview() {
  local list_file="/tmp/tmux-agent-sidebar-preview-$$.tsv" result_file="/tmp/tmux-agent-sidebar-preview-$$.result"
  local cur_file="$result_file.cur"
  local i idx jumped popup_pid geo pane_right win_w pop_x pop_w
  local popup_geometry=(-w 90% -h 85%)

  ((AG_N == 0)) && return 0
  [ -x "$PREVIEW_BIN" ] || return 0

  : > "$list_file"
  for ((i = 0; i < AG_N; i++)); do
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${AG_ID[i]}" "${AG_TITLE[i]:-${AG_PROJ[i]}}" "${AG_TYPE[i]}" "${AG_STATUS[i]}" "" "${AG_REPO[i]}${AG_BRANCH[i]:+ · ${AG_BRANCH[i]}}" >> "$list_file"
  done
  rm -f "$result_file" "$cur_file"

  # sidebar の右隣に開いて、裏の sidebar の選択表示が見えるようにする(幅が足りなければ中央に大きく出す)
  geo=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_right}|#{window_width}' 2>/dev/null)
  pane_right=${geo%%|*}
  win_w=${geo#*|}
  if [[ $pane_right =~ ^[0-9]+$ && $win_w =~ ^[0-9]+$ ]]; then
    pop_x=$((pane_right + 1))
    pop_w=$((win_w - pop_x))
    ((pop_w >= PREVIEW_MIN_WIDTH)) && popup_geometry=(-x "$pop_x" -w "$pop_w" -h 95%)
  fi

  PREVIEW_CUR_FILE=$cur_file
  PREVIEW_LAST_CUR=$SEL_IDX
  PREVIEW_ACTIVE=1

  # display-popup はポップアップが閉じるまで戻ってこないので、バックグラウンドで起動する。
  # 生きている間、ポップアップ側が j/k のたびに送る SIGUSR1 で on_preview_poke が走り、裏の選択表示が追従する
  tmux display-popup -E "${popup_geometry[@]}" -b rounded -S 'fg=colour208' -t "$TMUX_PANE" \
    "'$PREVIEW_BIN' '$list_file' '$SEL_IDX' '$result_file' '$$'" &
  popup_pid=$!
  render
  # シグナルで `wait` が中断されても、ポップアップが生きている限り待ち直す
  while kill -0 "$popup_pid" 2>/dev/null; do
    wait "$popup_pid" 2>/dev/null
  done
  PREVIEW_ACTIVE=0

  if [ -r "$result_file" ]; then
    { read -r idx; read -r jumped; } < "$result_file"
    if [ -n "$idx" ] && ((idx >= 0 && idx < AG_N)); then
      SEL_IDX=$idx
      SEL_KEY="${AG_ID[SEL_IDX]}|${AG_TYPE[SEL_IDX]}"
    fi
    [ "$jumped" = jumped ] && FOCUSED=0
  fi
  rm -f "$list_file" "$result_file" "$cur_file"
  PREVIEW_END=$SECONDS
  last_collect=-999
  size_dirty=1
}

# 入力を 1 件読み、KEY に up / down / enter / refresh / click / other を、
# クリックなら CLICK_ROW に行番号を入れる。タイムアウト時は KEY が空になる
read_key() {
  local c seq="" params b y final
  KEY=""
  IFS= read -rsn1 -t "$TICK" c || return 0

  case $c in
    j) KEY=down ;;
    k) KEY=up ;;
    r) KEY=refresh ;;
    q) KEY=quit ;;
    p | " ") KEY=preview ;;
    # l / h も Enter と同じ(cockpit では右の枠へフォーカス、通常は Agent へ移動)
    "" | l | h) KEY=enter ;;
    $'\033')
      # ESC 単体は other。CSI / SS3（矢印キー・マウス報告）は終端バイト（@-~）まで読む
      IFS= read -rsn1 -t 1 c || { KEY=other; return 0; }
      [ "$c" = "[" ] || [ "$c" = "O" ] || { KEY=other; return 0; }
      while IFS= read -rsn1 -t 1 c; do
        seq+=$c
        case $c in [@-~]) break ;; esac
      done
      final=${seq: -1}
      case $seq in
        A) KEY=up ;;
        B) KEY=down ;;
        I) KEY=focus_in ;;
        O) KEY=focus_out ;;
        "<"*[Mm])
          # SGR マウス報告: <ボタン;列;行 + M(押下) / m(解放)
          params=${seq#<}
          params=${params%[Mm]}
          b=${params%%;*}
          y=${params##*;}
          if [ "$final" = "M" ]; then
            case $b in
              0) KEY=click; CLICK_ROW=$y ;;
              64) KEY=wheel_up ;;
              65) KEY=wheel_down ;;
            esac
          fi
          ;;
        *) KEY=other ;;
      esac
      ;;
    *) KEY=other ;;
  esac
}

# --- メイン ---------------------------------------------------------------

SESSION_ID=$(tmux display-message -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null) || exit 1
CUR_SESS=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null)

# 自分自身を sidebar として識別させる（起動経路に依らず Agent 検出対象から外れる）
tmux set-option -p -t "$TMUX_PANE" @agent_sidebar 1
# 下端のボーダーには git 情報等の pane 用表示が出るため、sidebar では固定文字にする
tmux set-option -p -t "$TMUX_PANE" pane-border-format ' agent sidebar ' 2>/dev/null

# TUI では stderr が画面を壊すだけなので捨てる（調査時は環境変数で戻せる）
[ -z "${AGENT_SIDEBAR_DEBUG:-}" ] && exec 2>/dev/null

trap 'exit 0' INT TERM HUP
trap cleanup EXIT
resized=0
trap 'resized=1' WINCH
trap on_preview_poke USR1

stty -echo 2>/dev/null
# 代替画面 + カーソル非表示 + マウス報告（押下/ホイールを SGR 形式で受け取る）
# + フォーカスイベント(この pane がアクティブになった/外れたときに ESC[I / ESC[O が届く)
printf '%s' "${ESC}[?1049h${ESC}[?25l${ESC}[?1000h${ESC}[?1006h${ESC}[?1004h"

# 入力待ちの 1 回あたりの最大待ち時間。データ更新は INTERVAL 秒ごと、キー入力・リサイズはこの間隔内に反応する
TICK=1
load_type_icons
# cockpit の sidebar なら、前回の戻し忘れ(Agent が枠に入ったまま、等)を直してから始める
[ "$(tmux display-message -p -t "$TMUX_PANE" '#{@agent_cockpit}' 2>/dev/null)" = 1 ] && "$COCKPIT_BIN" heal >/dev/null 2>&1
SCOPE_ALL=0
opts=""
opt_scope=""
opt_type_icon=""
opt_passthrough=""
opt_cockpit=""
AUTO_PREVIEW=key
# ポップアップを閉じた時刻(SECONDS)。閉じた直後に届きうるフォーカスイベントで再び開かないための目安
PREVIEW_END=-999
last_collect=-999
need_render=1
KEY=""
CLICK_ROW=0

while :; do
  if ((SECONDS - last_collect >= INTERVAL)); then
    # option は 1 回の tmux 呼び出しでまとめて読む（scope | icons | auto_preview）
    opts=$(tmux display-message -p -t "$TMUX_PANE" '#{@agent_sidebar_scope}|#{@agent_sidebar_icons}|#{@agent_sidebar_auto_preview}|#{@agent_sidebar_type_icon}|#{allow-passthrough}|#{@agent_cockpit}|#{@agent_cockpit_shown}' 2>/dev/null)
    IFS='|' read -r opt_scope ICON_STYLE AUTO_PREVIEW opt_type_icon opt_passthrough opt_cockpit cockpit_shown <<< "$opts"
    [ "$opt_cockpit" = 1 ] && COCKPIT=1 || COCKPIT=0
    [ "$opt_scope" = "all" ] && SCOPE_ALL=1 || SCOPE_ALL=0
    [ -z "$AUTO_PREVIEW" ] && AUTO_PREVIEW=key
    apply_icon_style
    # 画像表示は、設定が image で、パススルーが有効で、アイコンが読めたときだけ
    if [ "$opt_type_icon" = image ] && [ -n "$opt_passthrough" ] && [ "$opt_passthrough" != off ] \
      && { [ -n "$KITTY_B64_CLAUDE" ] || [ -n "$KITTY_B64_CODEX" ]; }; then
      TYPE_ICON_MODE=image
    else
      TYPE_ICON_MODE=text
    fi

    records=$(collect)
    # tmux が応答しない（server 終了）場合は終了する
    [ -z "$records" ] && exit 0
    parse_records "$records"
    read_limits
    # main pane が全て閉じて sidebar だけが残った window は、window ごと閉じる。
    # cockpit では、枠に入っていた Agent が終了しただけのことがあるので、交換用の枠を戻してから判断する
    if [ "$MAIN_PANES" = "0" ]; then
      if [ "$COCKPIT" = 1 ]; then
        "$COCKPIT_BIN" heal >/dev/null 2>&1
        [ "$(tmux list-panes -t "$TMUX_PANE" -F '#{@agent_sidebar}' 2>/dev/null | grep -vc 1)" -gt 0 ] || exit 0
        last_collect=-999
      else
        exit 0
      fi
    fi

    # cockpit で、まだ何も枠に入っていなければ、選択中の Agent を入れる(開いた直後)
    if [ "$COCKPIT" = 1 ] && [ -z "$cockpit_shown" ]; then
      cockpit_show_selected
    fi

    last_collect=$SECONDS
    need_render=1

    # 画像モードなら、アイコンを端末へ登録する(初回と、KITTY_RESEND_SEC 秒ごと)
    if [ "$TYPE_ICON_MODE" = image ] && ((SECONDS - KITTY_SENT_AT >= KITTY_RESEND_SEC)); then
      [ -n "$KITTY_B64_CLAUDE" ] && kitty_send_image "$KITTY_ID_CLAUDE" "$KITTY_B64_CLAUDE"
      [ -n "$KITTY_B64_CODEX" ] && kitty_send_image "$KITTY_ID_CODEX" "$KITTY_B64_CODEX"
      KITTY_SENT_AT=$SECONDS
    fi
  fi

  if ((resized)); then
    resized=0
    size_dirty=1
    need_render=1
  fi

  if ((need_render)); then
    render
    need_render=0
  fi

  read_key
  # 入力が無かった tick でも、working の Agent がいればスピナーを進めるために再描画する
  [ -z "$KEY" ] && ((N_WORK > 0)) && need_render=1
  case $KEY in
    down | up | wheel_down | wheel_up)
      # 入力が届いた時点でこの pane にフォーカスがあるので、選択のハイライトを出す
      FOCUSED=1
      case $KEY in
        down | wheel_down) move_selection 1 ;;
        *) move_selection -1 ;;
      esac
      need_render=1
      if [ "$COCKPIT" = 1 ]; then
        # cockpit では、選択した Agent の本物の pane を右の枠へ入れる(ポップアップは使わない)。
        # 入れ替え(tmux の呼び出し)を待たず、先に選択の罫線を動かしてから入れ替える
        render
        need_render=0
        cockpit_show_selected
      # j/k(矢印)ではそのままプレビューを開く。ホイールは誤操作しやすいので選択を動かすだけ
      elif [ "$AUTO_PREVIEW" != off ] && [[ $KEY == down || $KEY == up ]]; then
        render
        open_preview
        need_render=1
      fi
      ;;
    focus_in)
      # sidebar がアクティブになったら(focus モードなら)プレビューを開く。
      # 閉じた直後に届くイベントで開き直さないよう、直後は無視する
      FOCUSED=1
      need_render=1
      # cockpit では、sidebar がアクティブ = どの Agent もアクティブではない
      [ "$COCKPIT" = 1 ] && mark_active_agent ""
      last_collect=-999
      if [ "$AUTO_PREVIEW" = focus ] && [ "$COCKPIT" != 1 ] && ((SECONDS - PREVIEW_END >= 2)); then
        render
        open_preview
      fi
      ;;
    focus_out)
      FOCUSED=0
      need_render=1
      # cockpit では、sidebar から外れた先は右の枠(表示中の Agent)
      [ "$COCKPIT" = 1 ] && mark_active_agent "${cockpit_shown:-${AG_ID[SEL_IDX]:-}}"
      last_collect=-999
      ;;
    enter)
      if [ "$COCKPIT" = 1 ]; then
        # cockpit: 右の枠(Agent の pane)へフォーカスを移す。戻るのは prefix + h
        tmux select-pane -R -t "$TMUX_PANE" 2>/dev/null
        FOCUSED=0
        # 右の枠(表示中の Agent)がアクティブになった。収集を待たずにすぐ反映する
        mark_active_agent "${cockpit_shown:-${AG_ID[SEL_IDX]:-}}"
        render
        need_render=0
        last_collect=-999
      else
        jump_to "$SEL_IDX"
        FOCUSED=0
        last_collect=-999
      fi
      ;;
    click)
      idx=${ROW_AGENT[CLICK_ROW]:-}
      if [ -n "$idx" ]; then
        SEL_IDX=$idx
        SEL_KEY="${AG_ID[idx]}|${AG_TYPE[idx]}"
        if [ "$COCKPIT" = 1 ]; then
          # 先に罫線を動かしてから入れ替える
          render
          need_render=0
          cockpit_show_selected
        else
          jump_to "$idx"
          FOCUSED=0
          last_collect=-999
        fi
      fi
      ;;
    refresh)
      last_collect=-999
      ;;
    quit)
      # cockpit の sidebar では、q で cockpit を閉じる(Ctrl-C と同じ終了処理: Agent を元へ戻し、交換用の枠も消して window ごと閉じる)。
      # 通常の sidebar では何もしない(閉じるのは Ctrl-C)
      [ "$COCKPIT" = 1 ] && exit 0
      ;;
    preview)
      # cockpit では右の枠で本物の pane が見えるので、ポップアップは使わない
      if [ "$COCKPIT" != 1 ]; then
        FOCUSED=1
        open_preview
        need_render=1
      fi
      ;;
  esac
done
