#   @agent_sidebar_last_sel  = 選んでいた Agent("pane_id|種別")  / @agent_sidebar_last_view = ダッシュボードを出していたなら daily
# 通常の sidebar は右の枠が無く、選択の意味が薄いので、cockpit だけが保存・復元する
RESTORE_DONE=0
