# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms
theme = Dracula

# Hack + 源柔ゴシックの合成等幅フォント。
# 全角は半角の正確に 2 倍幅で tmux の罫線がズレない。
# Console 版は全角記号（■ ● → ─ 等）を半角幅で扱う。
# 英数は下部の font-codepoint-map で別フォントに差し替えている。
font-family = HackGen Console NF
# フォントを読みやすくする
font-thicken

# 背景はちょっと透過している黒
background = 000
background-opacity = 0.70

# カーソルはblockで点滅させない
cursor-style = block
cursor-style-blink = false

# タイピング中はマウスカーソルを非表示にする
mouse-hide-while-typing

# はじめにtmuxを起動する（既存セッションがあれば再開）
command = /bin/zsh -i -l -c "/opt/homebrew/bin/tmux attach-session -t default || /opt/homebrew/bin/tmux new-session -s default"

# コマンドが終了したら表示内容を確認しておきたい
wait-after-command = true

# メニューバーのタイトルを非表示にする
title = " "

window-padding-x = 5
window-padding-y = 5
window-padding-balance = true

# 全画面表示させる
fullscreen = true
# ネイティブの全画面は使いたくない
macos-non-native-fullscreen = visible-menu
# メニューバーをできれば透過しておきたいな
macos-titlebar-style = transparent

# なんとなく色を変えてみる
macos-icon = custom-style
macos-icon-ghost-color = fa5
macos-icon-screen-color = 000

# 環境によって変えるかも
quick-terminal-screen = mouse

# Claude Code 用：改行入力（複数の代替キーバインド）
keybind = shift+enter=text:\n
keybind = alt+enter=text:\n
keybind = ctrl+enter=text:\n

# 英数のみ別フォントに差し替える（日本語は HackGen のまま）
font-codepoint-map = U+0000-U+00FF=JetBrains Mono

# ⬤ (U+2B24) を STIX Two Math で描画する。
# tmux ステータスバーの Claude Code 状態表示（tmux-claude-agents-status）用。
#
# 元は ● (U+25CF) だったが HackGen Console NF は全角記号を半角幅で扱うため
# 小さく潰れていた（グリフ幅 em 比 52.4%）。
# 大きい順: STIX の ⬤ 109.3% > Osaka の ● 89.8% > Iosevka の ⬤ 75.6%
# ⬤ は既定だと Iosevka にフォールバックして逆に小さくなるため、明示的に指定する。
font-codepoint-map = U+2B24=STIX Two Math